// Balanced binary tree: depth D=10 → 1024 leaves, 2047 components.
//
// Harness measurements:
//   __updateRoot()    — mutates the root context; ALL 1024 leaves re-read.
//   __updatePartial() — mutates state on a single mid-node at depth M=5; only
//                       leaves in that subtree (2^(D-M) = 32) re-read.
//   __partialUnmount/__partialRemount — toggle a `visible` flag on the Mid.

const D = 10;
const M = 5;
const MID_PATH = "L".repeat(M);

const ROOT_CTX = "RootCtx";
const LOCAL_CTX = "LocalCtx";

// Module-level setters wired up on mount.
let _setRoot = null;
let _setLocal = null;
let _setVisible = null;
export function bumpRoot() {
	if (_setRoot) _setRoot((v) => v + 1);
}
export function bumpPartial() {
	if (_setLocal) _setLocal((v) => v + 1);
}
export function hideMid() {
	if (_setVisible) _setVisible(false);
}
export function showMid() {
	if (_setVisible) _setVisible(true);
}

export default function App($props) {
	let $state = $watch({ root: 0 });
	_setRoot = (fn) => ($state.root = typeof fn === "function" ? fn($state.root) : fn);

	$context[ROOT_CTX] = $state;

	@render {
		<Node depth={$props.depth} path="" />
	}
}

function Mid($props) {
	let $state = $watch({
		local: 0,
		visible: true,
	});
	_setLocal = (fn) => ($state.local = typeof fn === "function" ? fn($state.local) : fn);
	_setVisible = (fn) => ($state.visible = typeof fn === "function" ? fn($state.visible) : fn);

	$context[LOCAL_CTX] = $state;

	@render {
		@if ($state.visible) {
			<div class="mid">
				<Node depth={$props.depth - 1} path={$props.path + "L"} />
				<Node depth={$props.depth - 1} path={$props.path + "R"} />
			</div>
		}
	}
}

function Node($props) {
	@render {
		@if ($props.depth > 0) {
			@if ($props.path === MID_PATH) {
				<Mid depth={$props.depth} path={$props.path} />
			} else {
				<div class="n">
					<Node depth={$props.depth - 1} path={$props.path + "L"} />
					<Node depth={$props.depth - 1} path={$props.path + "R"} />
				</div>
			}
		} else {
			<Leaf path={$props.path} />
		}
	}
}

function Leaf($props) {
	@render {
		<span class="leaf">{$props.path + "|" + $context[ROOT_CTX].root + ":" + ($context[LOCAL_CTX]?.local ?? 0)}</span>
	}
}
