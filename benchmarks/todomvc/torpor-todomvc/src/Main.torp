export default function TodoApp() {
	let $state = $watch({
		todos: [],
		filter: "all",
		editing: null,
		get visible() {
			return this.filter === "active"
				? this.todos.filter((t) => !t.completed)
				: this.filter === "completed"
					? this.todos.filter((t) => t.completed)
					: this.todos;
		},
	});

	let nextId = 1;

	function addTodo(e) {
		if (e.key !== "Enter") return;
		const input = e.target;
		const title = input.value.trim();
		if (title === "") return;
		$state.todos = [
			...$state.todos,
			{ id: nextId++, title, completed: false },
		];
		input.value = "";
	}
	function toggle(id) {
		$state.todos = $state.todos.map((x) =>
			x.id === id ? { ...x, completed: !x.completed } : x,
		);
	}
	function destroy(id) {
		$state.todos = $state.todos.filter((x) => x.id !== id);
	}
	function toggleAll(e) {
		const on = e.target.checked;
		$state.todos = $state.todos.map((x) =>
			x.completed === on ? x : { ...x, completed: on },
		);
	}
	function clearCompleted() {
		$state.todos = $state.todos.filter((x) => !x.completed);
	}
	function startEdit(id) {
		$state.editing = id;
	}
	function commitEdit(id, e) {
		const title = e.target.value.trim();
		if (title === "") {
			$state.todos = $state.todos.filter((x) => x.id !== id);
		} else {
			$state.todos = $state.todos.map((x) =>
				x.id === id ? { ...x, title } : x,
			);
		}
		$state.editing = null;
	}
	function editKeyDown(id, e) {
		if (e.key === "Enter") commitEdit(id, e);
		else if (e.key === "Escape") $state.editing = null;
	}

	@render {
		<section class="todoapp">
			<header class="header">
				<h1>todos</h1>
				<input
					class="new-todo"
					placeholder="What needs to be done?"
					onkeydown={addTodo}
				/>
			</header>
			@if ($state.todos.length > 0) {
				<section class="main">
					<input
						id="toggle-all"
						class="toggle-all"
						type="checkbox"
						checked={$state.todos.every((x) => x.completed)}
						onclick={toggleAll}
					/>
					<ul class="todo-list">
						@for (let t of $state.visible) {
							@key = t.id
							<TodoRow
								t={t}
								editing={$state.editing}
								onToggle={toggle}
								onDestroy={destroy}
								onStartEdit={startEdit}
								onCommitEdit={commitEdit}
								onEditKeyDown={editKeyDown}
							/>
						}
					</ul>
				</section>
				<footer class="footer">
					<span class="todo-count">
						<strong>{$state.todos.filter((x) => !x.completed).length}</strong>
						{$state.todos.filter((x) => !x.completed).length === 1 ? " item left" : " items left"}
					</span>
					<ul class="filters">
						<li>
							<a
								class={{ selected: $state.filter === "all" }}
								data-filter="all"
								onclick={() => ($state.filter = "all")}
							>
								All
							</a>
						</li>
						<li>
							<a
								class={{ selected: $state.filter === "active" }}
								data-filter="active"
								onclick={() => ($state.filter = "active")}
							>
								Active
							</a>
						</li>
						<li>
							<a
								class={{ selected: $state.filter === "completed" }}
								data-filter="completed"
								onclick={() => ($state.filter = "completed")}
							>
								Completed
							</a>
						</li>
					</ul>
					@if ($state.todos.some((x) => x.completed)) {
						<button class="clear-completed" onclick={clearCompleted}>Clear completed</button>
					}
				</footer>
			}
		</section>
	}
}

function TodoRow($props) {
	@render {
		<li class={{ completed: $props.t.completed, editing: $props.editing === $props.t.id }}>
			<div class="view">
				<input
					class="toggle"
					type="checkbox"
					checked={$props.t.completed}
					onclick={() => $props.onToggle($props.t.id)}
				/>
				<label ondblclick={() => $props.onStartEdit($props.t.id)}>{$props.t.title}</label>
				<button class="destroy" onclick={() => $props.onDestroy($props.t.id)}></button>
			</div>
			@if ($props.editing === $props.t.id) {
				<input
					class="edit"
					value={$props.t.title}
					onkeydown={(e) => $props.onEditKeyDown($props.t.id, e)}
					onblur={(e) => $props.onCommitEdit($props.t.id, e)}
				/>
			}
		</li>
	}
}
