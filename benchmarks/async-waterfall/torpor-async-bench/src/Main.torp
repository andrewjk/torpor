import { fetchData, LEVELS } from "./data.js";

// One async component per nesting level using `$async` getters + `@await`
// boundaries. The boundary renders its content speculatively on first mount —
// which mounts the nested child and starts its fetch — so every level's
// fetch starts in the first wave. There is no structural waterfall in this
// model: the `with` branch is shown until a level's own promise resolves, and
// the child cascade follows.

function Level($props) {
	let $state = $watch({
		get data() {
			return $async(() => fetchData($props.level, $props.version));
		},
	});

	@render {
		@await {
			<div class="level" data-level={$props.level}>
				<span class="val">{$state.data}</span>
				@if ($props.level < LEVELS - 1) {
					<Level level={$props.level + 1} version={$props.version} />
				}
			</div>
		} with {
			<div class="level" data-level={$props.level}>
				<span class="val">loading…</span>
			</div>
		}
	}
}

export default function Main() {
	let $state = $watch({ version: 0 });

	window.__bump = () => {
		$state.version = $state.version + 1;
	};

	@render {
		<Level level={0} version={$state.version} />
	}
}
