import { loadResource } from "./data.js";

// Dashboard with 8 versioned resources using torpor's `$await` model. Each
// resource is a component with an `$await` getter keyed on `$props.version`;
// reading the getter suspends while the promise is pending and returns the
// retained `staleValue` during a re-fetch, so on a version bump the DOM keeps
// showing the previous values until the new promises resolve — the keep-old-UI
// transition the harness gate requires (`retainedOldResourceValues`).
//
// The seven independent resources start at mount (wave 0). `owner` is the one
// true dependency: it may only start once `project` resolved to the current
// version's ownerId. Between the version bump and that resolution it must keep
// showing the previous owner value without re-fetching (or suspending), so the
// getter returns the last resolved value in that window.

function ProjectHeader($props) {
	let $state = $watch({
		get data() {
			return $await(() => loadResource("project", $props.version));
		},
	});

	@render {
		<header data-panel="project">
			<h1 data-resource="project">{$state.data?.label}</h1>
			<Viewer version={$props.version} />
			<div class="project-meta">
				<Badge version={$props.version} />
				<Owner version={$props.version} ownerId={$state.data?.ownerId} />
			</div>
		</header>
	}
}

function Viewer($props) {
	let $state = $watch({
		get data() {
			return $await(() => loadResource("viewer", $props.version));
		},
	});

	@render {
		<p data-resource="viewer">{$state.data?.label}</p>
	}
}

function Badge($props) {
	let $state = $watch({
		get data() {
			return $await(() => loadResource("badge", $props.version));
		},
	});

	@render {
		<strong data-resource="badge">{$state.data?.label}</strong>
	}
}

function Owner($props) {
	let lastOwner = null;
	let $state = $watch({
		get data() {
			return $await(() => {
				const ready = $props.ownerId === "owner-" + $props.version;
				if (!ready) return lastOwner;
				const promise = loadResource("owner", $props.version, $props.ownerId);
				promise.then((value) => {
					lastOwner = value;
				});
				return promise;
			});
		},
	});

	@render {
		<span data-resource="owner">{$state.data?.label}</span>
	}
}

function ResourceCell($props) {
	let $state = $watch({
		get data() {
			return $await(() => loadResource($props.name, $props.version));
		},
	});

	@render {
		<span data-resource={$props.name}>{$state.data?.label}</span>
	}
}

function ActivityPanel($props) {
	@render {
		<section data-panel="activity">
			<ResourceCell name="activity" version={$props.version} />
			<div>
				<ResourceCell name="activity-summary" version={$props.version} />
			</div>
		</section>
	}
}

function InsightsPanel($props) {
	@render {
		<section data-panel="insights">
			<ResourceCell name="insights" version={$props.version} />
			<div>
				<ResourceCell name="insights-chart" version={$props.version} />
			</div>
		</section>
	}
}

function Dashboard($props) {
	@render {
		<main data-dashboard-version={$props.version}>
			<ProjectHeader version={$props.version} />
			<ActivityPanel version={$props.version} />
			<InsightsPanel version={$props.version} />
		</main>
	}
}

export default function App() {
	let $state = $watch({ version: 0 });

	window.__bump = () => {
		$state.version = $state.version + 1;
	};

	@render {
		<Dashboard version={$state.version} />
	}
}
