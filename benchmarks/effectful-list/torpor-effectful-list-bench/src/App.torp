import { bindHandlers, initialItems } from "./ops.js";
import Row from "./Row.torp";

// effectful-list parent: a keyed 1k-row table of cross-module <Row/>
// components plus an UNRELATED `tick` state. Bumping tick re-renders the
// parent and (in VDOM targets) every Row body — with every effect deps-array
// unchanged — which is exactly the update_nodeps measurement. Torpor is
// fine-grained, so rows don't re-render on a tick bump; the gate accepts that
// as long as no effect fires.

export default function App() {
	let $state = $watch({
		items: initialItems(),
		tick: 0,
	});

	bindHandlers({
		setItems: (next) => ($state.items = next),
		setTick: (fn) => ($state.tick = typeof fn === "function" ? fn($state.tick) : fn),
	});

	@render {
		<div>
			<div class="tick">{$state.tick}</div>
			<table class="test-data">
				<tbody>
					@for (let item of $state.items) {
						@key = item.id
						<Row item={item} />
					}
				</tbody>
			</table>
		</div>
	}
}
