export default function Counter($props: any) {
	let $state = $watch({
		count: 0,
	});

	@render {
		<p>
			The count is {$state.count}.
		</p>
		<button onclick={() => $state.count++}>
			Increment
		</button>
		<button onclick={() => $state.count = 0}>
			Reset
		</button>

		<form method="POST" action="?set">
			<input type="number" name="count" />
			<button type="submit">
				Set via server
			</button>
		</form>

		@if ($props?.form?.message) {
			<p style="color: green">
				{$props.form.message}
			</p>
		}
	}
}
