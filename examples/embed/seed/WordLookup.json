{
	"id": "word-lookup",
	"props": { "word": "serendipity" },
	"api": { "lookup": { "payload": { "word": "string" } } },
	"data": {
		"entry": {
			"kind": "http",
			"url": "https://api.datamuse.com/words",
			"params": {
				"sp": "$props.word",
				"md": "d",
				"max": 1
			},
			"pick": "0",
			"limit": 1
		}
	}
}
