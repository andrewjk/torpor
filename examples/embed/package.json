{
	"name": "@torpor/examples-embed",
	"version": "0.0.1",
	"description": "An embed host built with @torpor/build: deploy restricted torpor apps at runtime",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "tb --dev",
		"build": "tsgo --noEmit && tb --build",
		"check": "tsgo --noEmit && pnpm dlx oxlint --type-aware"
	},
	"dependencies": {
		"@torpor/adapter-node": "workspace:^",
		"@torpor/build": "workspace:^",
		"@torpor/embed": "workspace:^",
		"@torpor/view": "workspace:^"
	},
	"devDependencies": {
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
