{
	"$schema": "../node_modules/@varlock/bumpy/config-schema.json",
	"baseBranch": "main",
	"changelog": "default",
	"access": "public",
	"updateInternalDependencies": "patch",
	// The VS Code extension is a private package, published to the marketplace
	// via `vsce` instead of npm. `include` opts it into versioning; the custom
	// publish command (trusted here in the root config) handles releasing it.
	"include": ["torpor"],
	"packages": {
		"torpor": {
			// Run the extension's own devDependency (vsce 4.x) rather than
			// whatever `vsce` is on PATH: older global installs (3.x) scan
			// secrets through @secretlint/secretlint-formatter-sarif, which
			// pnpm's isolated node_modules can't resolve.
			"publishCommand": "pnpm --filter torpor exec vsce publish --no-dependencies",
			"skipNpmPublish": true,
			// the TextMate grammar is copied from @torpor/textmate into the
			// extension at build time, so its releases must republish the ext
			"releaseTriggeringDevDeps": ["@torpor/textmate"]
		}
	},
	// You'll need to manually release these in the NPM web interface
	"publish": {
		"npmStaged": true
	}
}
