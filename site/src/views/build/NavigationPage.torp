import CodePreview from "../CodePreview.torp";

export default function NavigationPage() {
	@head {
		<title>Navigation | Build | Torpor</title>
	}

	@render {
		<h1>Navigation</h1>
		<p>
			Plain <code>&lt;a href&gt;</code> links just work: the framework intercepts
			clicks, fetches the page, and re-renders in the browser. Pages are
			prefetched on hover and touch, and back/forward buttons are handled.
			Everything still works without JavaScript.
		</p>

		<h2>Programmatic navigation</h2>
		<p>
			Use <code>load</code> to render a page from code, and <code>reload</code>
			to re-run the loads for the current page:
		</p>
		<CodePreview
			code={`
import { load, reload } from "@torpor/build/nav";

await load("/posts");
await reload();
`.trim()}
		/>
		<p>
			<code>load</code> and <code>reload</code> return whether the page was
			rendered in place. They return <code>false</code> when the document has
			to take over: a <code>+server</code> route, a redirect, or a failed
			navigation.
		</p>

		<h2>Offline and failed navigations</h2>
		<p>
			A page whose data can't be loaded shows its nearest error page inside the
			shell, so an offline navigation keeps the layout (and any unsaved form
			state) instead of blanking the screen. If the page itself can't render
			&mdash; typically because its JavaScript chunk was never fetched while
			offline &mdash; the current page is kept and a
			<code>torpor:navigation-failed</code> event is fired on
			<code>window</code>:
		</p>
		<CodePreview
			code={`
import type { NavigationFailureDetail } from "@torpor/build/nav";

window.addEventListener("torpor:navigation-failed", (event) => {
	const { href } = (event as CustomEvent<NavigationFailureDetail>).detail;
	showNotice("Still offline - couldn't open " + href);
});
`}
		/>
		<p>
			The event is cancelable: call <code>preventDefault()</code> to ask for a
			full document navigation anyway, e.g. when a service worker caches the
			target page. While online, failed navigations fall back to a full page
			load, which also recovers from a stale chunk after a deploy. Links to
			<code>+server</code> routes and redirects always use the document.
		</p>
		<p>
			Error pages should not assume their layouts' data is available: when
			the error page's own server data can't load either, layouts that
			weren't already on screen render with empty data.
		</p>

		<h2>Building URLs</h2>
		<p>
			Use <code>route</code> to build URLs from route paths. Params are checked
			at compile time and URI-encoded:
		</p>
		<CodePreview
			code={`
import { route } from "@torpor/build/nav";

route("/posts/[id]", { id: 5 }); // "/posts/5"
`}
		/>

		<h2>The $page state object</h2>
		<p>
			<code>$page</code> is a reactive object describing the current page. The
			framework puts it into the context of every page, layout and component as
			<code>$context.$page</code>, so that each request rendered on the server
			gets its own:
		</p>
		<CodePreview
			code={`
export default function Breadcrumb() {
	let { $page } = $context;

	@render {
		<p>You are at {$page.url.pathname}</p>
	}
}
`}
		/>
		<ul>
			<li><code>$page.url</code> &mdash; the current URL</li>
			<li><code>$page.status</code> &mdash; the response status code</li>
			<li><code>$page.form</code> &mdash; the result of the last form action</li>
			<li>
				<code>$page.flash</code> &mdash; one-item values set by the last
				action, e.g. <code>&#123; message: "Post created" &#125;</code>.
				See <a href="/build/actions">Actions</a>
			</li>
			<li><code>$page.error?.message</code> &mdash; the current error, if any</li>
		</ul>
		<p>
			It is used by the sidebar of this very site to highlight the active link,
			and by error pages to show the status.
		</p>

		<h2>View transitions and scrolling</h2>
		<p>
			Scroll position is reset when moving to another page, kept for
			same-page navigations like query changes and form actions, and
			restored when going back and forward.
		</p>
		<p>
			Navigations can run inside the view transitions API &mdash; so pages
			cross-fade and can be animated with CSS &mdash; by opting in:
		</p>
		<CodePreview
			code={`
// site.config.ts
site.viewTransitions = true;
`}
		/>
		<CodePreview
			code={`
/* in a stylesheet, to slow the page transition down */
::view-transition-old(root),
::view-transition-new(root) {
	animation-duration: 0.3s;
}
`}
		/>
		<p>
			Pages that scroll inside their own container (like this site's sidebar
			section) can reset that container themselves, e.g. with a
			<code>$run</code> on <code>$page.url</code>.
		</p>
	}
}
