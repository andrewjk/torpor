import CodePreview from "../CodePreview.torp";

export default function HooksPage() {
	@head {
		<title>Hooks | Build | Torpor</title>
	}

	@render {
		<h1>Hooks</h1>
		<p>
			A <code>_hook.server.ts</code> file defines functions that run around every
			request in its folder and the folders below it. A hook at the root of
			<code>src/routes</code> runs for the whole site:
		</p>
		<CodePreview
			code={`
// routes/_hook.server.ts
import { type ServerHook } from "@torpor/build";
import { getUser } from "@/lib/auth";

export default {
	enter: async (event) => {
		event.appData.user = await getUser(event.cookies);
	},
} satisfies ServerHook;
`}
		/>

		<h2>The enter hook</h2>
		<p>
			<code>enter</code> runs before each request is handled, including page
			loads, actions and API endpoints. Return a <code>Response</code> to
			short-circuit the request. For example, to redirect users who are
			not logged in:
		</p>
		<CodePreview
			code={`
enter: async (event) => {
	if (!event.appData.user) {
		return seeOther("/login");
	}
},
`}
		/>

		<h2>The exit hook</h2>
		<p>
			<code>exit</code> runs after the request has been handled, even if the
			handler threw an error or <code>enter</code> short-circuited it. Use it for
			logging and cleanup.
		</p>

		<h2>Shared data</h2>
		<p>
			Anything set on <code>event.appData</code> flows down to layouts, pages and
			endpoints in the same request, so a user loaded in a hook is available
			everywhere else without fetching it again.
		</p>

		<h2>Hooks and middleware</h2>
		<p>
			A request runs the global middleware (<code>site.middleware</code>) first,
			then the folder hooks from the root down, then the route's own
			<code>middleware</code>, then the load, action or endpoint. Route
			middleware can read what the hooks loaded from <code>ev.appData</code>,
			so a route can add its own guard on top of a folder's auth hook:
		</p>
		<CodePreview
			code={`
// routes/admin/reports/+page.server.ts
export default {
	middleware: [
		{
			enter: (ev) => {
				if (!ev.appData.user?.isAdmin) return forbidden();
			},
		},
	],
	load: async () => ok(await getReports()),
} satisfies PageServerEndPoint;
`}
		/>
		<p>
			To guard a whole folder, use a <code>_hook.server.ts</code> in it rather
			than middleware: hooks run for every page and endpoint below them.
		</p>
	}
}
