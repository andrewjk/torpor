import CodePreview from "../CodePreview.torp";

export default function LoadingDataPage() {
	@head {
		<title>Loading Data | Build | Torpor</title>
	}

	@render {
		<h1>Loading Data</h1>
		<p>
			A <code>load</code> function fetches data for a page before it is rendered.
			Return data with a response helper like <code>ok</code>, and it becomes
			<code>$props.data</code> in the page component.
		</p>

		<h2>Server loads</h2>
		<p>
			Put <code>load</code> in <code>+page.server.ts</code> to run it on the
			server, on every request. This is where you talk to your database:
		</p>
		<CodePreview
			code={`
// routes/posts/+page.server.ts
import { ok } from "@torpor/build";
import { type PageServerEndPoint } from "@torpor/build";
import { getPosts } from "@/lib/db";

export default {
	load: async () => {
		const posts = await getPosts();
		return ok({ posts });
	},
} satisfies PageServerEndPoint;
`}
		/>
		<CodePreview
			code={`
// views/Posts.torp
export default function Posts($props: { data: { posts: Post[] } }) {
	@render {
		@for (let post of $props.data.posts) {
			<article>{post.title}</article>
		}
	}
}
`}
		/>

		<p>
			A server load runs during the first render, and its data is embedded in
			the HTML, so the browser doesn't fetch it again when it hydrates. A
			<a href="/build/prerendering">prerendered</a> page with a server load
			can therefore hydrate with its data on a static host, with no server at
			all.
		</p>

		<h2>Client loads</h2>
		<p>
			Put <code>load</code> in <code>+page.ts</code> to run it in the browser
			during client-side navigation, for example fetching from an external API:
		</p>
		<CodePreview
			code={`
// routes/weather/+page.ts
import { ok } from "@torpor/build";
import component from "@/views/Weather.torp";
import { type PageEndPoint } from "@torpor/build";

export default {
	component,
	load: async () => {
		const response = await fetch("https://api.example.com/weather");
		return ok({ forecast: await response.json() });
	},
} satisfies PageEndPoint;
`}
		/>

		<h2>Layouts load too</h2>
		<p>
			A <code>_layout.server.ts</code> load runs before the page's load, and its
			data accumulates top down: each load receives the data loaded by the layouts
			above it, may add to it, and the merged result is passed into the page as
			<code>$props.data</code>.
		</p>

		<h2>Deferred data</h2>
		<p>
			A load can return a promise-valued property. The page renders as soon as
			the awaited (critical) values are ready; promise values keep resolving in
			the background, so slow sections don't block the whole navigation or the
			first paint:
		</p>
		<CodePreview
			code={`
// routes/posts/[slug]/+page.server.ts
import { ok, type PageServerEndPoint } from "@torpor/build";
import { getComments, getPost } from "@/lib/db";

export default {
	load: async ({ params }) => {
		const post = await getPost(params.slug);
		// Not awaited: this becomes a promise in $props.data and streams in
		return ok({ post, comments: getComments(params.slug) });
	},
} satisfies PageServerEndPoint<
	"/posts/[slug]",
	{ post: Post; comments: Promise<Comment[]> }
>;
`}
		/>
		<p>
			Read the deferred value through <code>$async</code> inside an
			<code>&#64;await</code> boundary. The boundary shows its <code>with</code>
			branch until the promise resolves (and keeps stale content on later
			refreshes). A first-load <code>$async</code> read is <code>undefined</code>,
			so guard a loop over it with <code>?? []</code> (or wrap the
			<code>&#64;for</code> in an <code>&#64;if</code>):
		</p>
		<CodePreview
			code={`
// views/Post.torp
export default function Post($props: {
	data: { post: Post; comments: Promise<Comment[]> };
}) {
	let $state = $watch({
		get comments() {
			return $async(() => $props.data.comments);
		},
	});

	@render {
		<h1>{$props.data.post.title}</h1>
		@await {
			@for (let comment of $state.comments ?? []) {
				<p>{comment.text}</p>
			}
		} with {
			<p>Loading comments…</p>
		}
	}
}
`}
		/>
		<p>
			On a client-side navigation the route mounts with the promise already in
			<code>$props.data</code>. On a first page load the server sends the HTML
			immediately and settles the promise with a small inline script, so
			hydration doesn't wait for it. A deferred promise that rejects follows the
			normal async error path (<code>&#64;try</code>/<code>&#64;catch</code>). Redirects
			and error responses still belong to the critical part of the load — once
			the response has started streaming, its status can't change.
		</p>
		<p>
			Client loads can defer values the same way. Client loads aren't streamed
			from the server, so their promises simply resolve in the browser after the
			component mounts.
		</p>

		<h2>Skipping the data request</h2>
		<p>
			A client navigation normally asks the server for data even when every
			layout is already on screen, because folder hooks may need to run. A page
			with no server load of its own can opt out with
			<code>serverData: false</code> when its hooks don't gate access:
		</p>
		<CodePreview
			code={`
// routes/settings/+page.ts
export default {
	component: Settings,
	serverData: false,
} satisfies PageEndPoint;
`}
		/>
		<p>
			The flag only skips the request when all layouts are reused and the page
			has no <code>+page.server.ts</code> load; client loads still run.
		</p>

		<h2>The load event</h2>
		<p>
			Server loads receive an event with <code>url</code>, <code>params</code>,
			<code>data</code> (from the layouts above), <code>appData</code> (set by
			<a href="/build/hooks">hooks</a>), <code>request</code>, <code>cookies</code>
			and <code>headers</code>. Client loads receive <code>url</code>,
			<code>params</code> and <code>data</code>.
		</p>

		<h2>Query strings</h2>
		<p>
			Declare a <code>load</code> schema to validate the URL's query string. The
			values are validated and typed before <code>load</code> is called, and an
			invalid query string gets a 422 response without running your code:
		</p>
		<CodePreview
			code={`
const schema = {
	load: z.object({ page: z.coerce.number() }),
};

export default {
	schema,
	load: async ({ query }) => {
		const { page } = await query();
		return ok({ page });
	},
} satisfies PageServerEndPoint<"/posts", Record<string, any>, typeof schema>;
`}
		/>

		<h2>Caching</h2>
		<p>
			Server load data is embedded in the rendered HTML so the browser can
			hydrate without a second request. If that data is specific to the
			signed-in user, a shared cache (a CDN, or a proxy) must not store the
			page — otherwise it can serve one user's data to the next. Set
			<code>Cache-Control</code> on the response from a load or hook:
		</p>
		<CodePreview
			code={`
// routes/account/+page.server.ts
import { ok } from "@torpor/build";
import { type PageServerEndPoint } from "@torpor/build";

export default {
	load: async ({ headers }) => {
		headers.set("Cache-Control", "private, no-cache");
		return ok(await getAccount());
	},
} satisfies PageServerEndPoint;
`}
		/>
		<p>
			Use <code>private</code> (or <code>no-store</code> for anything more
			sensitive) on user-specific pages, and <code>public</code> with a
			<code>max-age</code> on pages that are the same for everyone. In dev,
			a page that embeds data without setting <code>Cache-Control</code>
			logs a one-time reminder, and setting it — any value, including
			<code>public</code> — silences it.
		</p>

		<h2>Redirects and errors</h2>
		<p>
			Loads may return any response instead of data: use
			<code>seeOther("/login")</code> to redirect, or <code>notFound()</code> to
			show the <a href="/build/routing">error page</a>.
		</p>
	}
}
