import type { ReplResult } from "./compileRepl";

export default function Repl($props: { input?: string } | undefined) {
	let input = $props?.input ?? "";

	let $state = $watch({
		input,
		output: "",
		errors: [] as { message: string; startIndex: number }[],
		// Whether the compiler has loaded (see `loadCompiler`)
		loaded: false,
	});

	let timer: ReturnType<typeof setTimeout> | undefined;
	function debounce(fn: () => void, timeout = 600) {
		if (timer) {
			clearTimeout(timer);
			timer = setTimeout(fn, timeout);
		} else {
			timer = setTimeout(fn, 1);
		}
	}

	// The compiler (with sucrase and the view runtime) is most of the REPL's
	// weight, and most readers of a docs page never scroll down to its
	// playground. So it's loaded with a dynamic import -- once the REPL comes
	// within a screen or so of the viewport, or when the input is focused --
	// rather than with the page. Kept outside $state, so the module isn't
	// wrapped in a proxy
	let compile: ((input: string) => ReplResult) | undefined;
	let loading: Promise<void> | undefined;
	function loadCompiler() {
		loading ??= import("./compileRepl").then((module) => {
			compile = module.default;
			$state.loaded = true;
		});
	}

	let repl: HTMLElement;
	$onmount(() => {
		if (typeof IntersectionObserver === "undefined") {
			loadCompiler();
			return;
		}
		const observer = new IntersectionObserver(
			(entries) => {
				if (entries.some((entry) => entry.isIntersecting)) {
					observer.disconnect();
					loadCompiler();
				}
			},
			// The margin only reaches beyond the observer's root, so the root is
			// the element that scrolls the REPL into view (the docs layout
			// scrolls its content area, not the window)
			{ root: scrollParent(repl), rootMargin: "100% 0px" },
		);
		observer.observe(repl);
		return () => observer.disconnect();
	});

	$run(() => {
		let input = $state.input;
		if (!$state.loaded) {
			return;
		}
		debounce(() => {
			if (!input || !compile) {
				return;
			}

			let result = compile(input);
			if (result.ok) {
				$state.errors = [];
				$state.output = result.output;
			} else {
				$state.errors = result.errors;
			}
		});
	});

	@render {
		<div id="repl" class="hstack spaced full-width collapse" &ref={repl}>
			<div id="input-container" class="grow">
				<h3>Input</h3>
				<textarea
					id="input"
					class="code"
					&value={$state.input}
					onmount={textAreaMount}
					onfocus={loadCompiler}
					oninput={textAreaInput}
					onkeydown={textAreaKeyDown}
				/>
			</div>

			<div id="output-container">
				<h3>Output</h3>
				<div class="vstack spaced">
					<div>
						@if ($state.output) {
							<iframe srcdoc={$state.output} onload={resizeIframe} />
						} else if ($state.errors.length === 0) {
							<p class="pending" aria-live="polite">Loading the playground…</p>
						}
					</div>
					@if ($state.errors.length) {
						<div id="errors">
							<p>Template errors:</p>
							<ul>
								@for (let error of $state.errors) {
									<li>{error.message}, position: {error.startIndex}</li>
								}
							</ul>
						</div>
					}
				</div>
			</div>
		</div>
	}

	@style {
		textarea {
			appearance: none;
			border: 1px dashed lightgray;
			border-radius: var(--brad);
			margin: 0;
			padding: 1rem;
		}

		textarea, iframe {
			width: 100%;
		}

		iframe {
			border: 1px dashed lightgray;
			border-radius: var(--brad);
		}

		#errors {
			color: red;
		}

		/* The same box as the iframe, so it doesn't jump when the output arrives */
		.pending {
			box-sizing: border-box;
			display: flex;
			align-items: center;
			justify-content: center;
			height: 150px;
			margin: 0;
			border: 1px dashed lightgray;
			border-radius: var(--brad);
			color: gray;
		}
	}

	function textAreaMount(e: HTMLTextAreaElement) {
		const resize = () => {
			e.style.height = "auto";
			e.style.height = e.scrollHeight + "px";
		};
		resize();
		e.style.overflowY = "hidden";
		// The value is applied around mount time, and web fonts can change the
		// metrics after the first layout -- resize again once both have settled
		requestAnimationFrame(resize);
		if (document.fonts) {
			void document.fonts.ready.then(resize);
		}
	}

	// Events are delegated, so the handlers get the textarea from the event
	// rather than `this`
	function textAreaInput(e: Event) {
		const area = e.target as HTMLTextAreaElement;
		let x = window.scrollX,
			y = window.scrollY;
		area.style.height = "";
		area.style.height = area.scrollHeight + "px";
		window.scrollTo(x, y);
	}

	// From https://stackoverflow.com/a/45396754
	let tabEnabled = true;
	function textAreaKeyDown(e: KeyboardEvent) {
		const area = e.target as HTMLTextAreaElement;
		// Escape key toggles tab on/off
		if (e.keyCode === 27) {
			tabEnabled = !tabEnabled;
			return false;
		}

		// Enter xey?
		if (e.keyCode === 13 && tabEnabled) {
			// selection?
			if (area.selectionStart === area.selectionEnd) {
				// Find start of the current line
				var sel = area.selectionStart;
				var text = area.value;
				while (sel > 0 && text[sel - 1] !== "\n") {
					sel--;
				}
				var lineStart = sel;
				while (text[sel] === " " || text[sel] === "\t") {
					sel++;
				}

				if (sel > lineStart) {
					// Insert carriage return and indented text
					document.execCommand("insertText", false, "\n" + text.substr(lineStart, sel - lineStart));

					// Scroll caret visible
					//this.blur()
					//this.focus()

					e.preventDefault();
					return false;
				}
			}
		}

		// Tab key?
		if (e.keyCode === 9 && tabEnabled) {
			// selection?
			if (area.selectionStart === area.selectionEnd) {
				// These single character operations are undoable
				if (!e.shiftKey) {
					document.execCommand("insertText", false, "\t");
				} else {
					var text = area.value;
					if (area.selectionStart > 0 && text[area.selectionStart - 1] === "\t") {
						document.execCommand("delete");
					}
				}
			} else {
				// Block indent/unindent trashes undo stack
				// Select whole lines
				var selStart = area.selectionStart;
				var selEnd = area.selectionEnd;
				var text = area.value;
				while (selStart > 0 && text[selStart - 1] !== "\n") {
					selStart--;
				}
				while (selEnd > 0 && text[selEnd - 1] !== "\n" && selEnd < text.length) {
					selEnd++;
				}

				// Get selected text
				var lines = text.substr(selStart, selEnd - selStart).split("\n");

				// Insert tabs
				for (var i = 0; i < lines.length; i++) {
					// Don't indent last line if cursor at start of line
					if (i === lines.length - 1 && lines[i].length === 0) {
						continue;
					}

					// Tab or Shift+Tab?
					if (e.shiftKey) {
						if (lines[i].startsWith("\t")) {
							lines[i] = lines[i].substr(1);
						} else if (lines[i].startsWith("	")) {
							lines[i] = lines[i].substr(4);
						}
					} else {
						lines[i] = "\t" + lines[i];
					}
				}
				const newText = lines.join("\n");

				// Update the text area
				area.value = text.substr(0, selStart) + newText + text.substr(selEnd);
				area.selectionStart = selStart;
				area.selectionEnd = selStart + newText.length;
			}

			e.preventDefault();
			return false;
		}

		tabEnabled = true;
		return true;
	}

	/** The nearest ancestor that scrolls, or null for the viewport. */
	function scrollParent(el: HTMLElement): HTMLElement | null {
		for (let parent = el.parentElement; parent; parent = parent.parentElement) {
			if (/(auto|scroll)/.test(getComputedStyle(parent).overflowY)) {
				return parent;
			}
		}
		return null;
	}

	function resizeIframe(e: Event) {
		const target = e.target as HTMLIFrameElement;
		target.style.height =
			target.contentWindow?.document.documentElement.scrollHeight + "px";
	}
}
