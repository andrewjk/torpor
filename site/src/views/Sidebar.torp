				<li><a href="/ui/tab-group" onclick={$props?.onnavigate}>TabGroup</a></li>
				<li><a href="/ui/tag-input" onclick={$props?.onnavigate}>TagInput</a></li>
				<li><a href="/ui/tool-bar" onclick={$props?.onnavigate}>ToolBar</a></li>
				<li><a href="/ui/tree" onclick={$props?.onnavigate}>Tree</a></li>
			</ul>
			<h4>Build</h4>
			<ul class="plain">
				<li><a href="/build/overview" onclick={$props?.onnavigate}>Overview</a></li>
			</ul>
			<h4>Playground</h4>
			<ul class="plain">
				<li><a href="/playground/play" onclick={$props?.onnavigate}>Playground</a></li>
				<li><a href="/playground/demo" onclick={$props?.onnavigate}>Demo</a></li>
				<li><a href="/playground/party" onclick={$props?.onnavigate}>Component Party</a></li>
			</ul>
			<ul class="plain">
				<li>
					<a
						href="https://github.com/andrewjk/torpor"
						target="_blank"
						rel="external"
						class="github-link"
					>
						<GithubLogo /> GitHub
					</a>
				</li>
			</ul>
		</nav>
	}

	@style {
		.github-link {
			align-items: center;
			display: inline-flex;
			gap: 0.4rem;
		}
	}
}
