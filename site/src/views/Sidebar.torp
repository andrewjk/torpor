import GithubLogo from "phosphor-torpor/lib/GithubLogo";

interface SidebarProps {
	/** Called when a link in the sidebar is clicked, e.g. to close a nav drawer */
	onnavigate?: () => void;
}

export default function Sidebar($props?: SidebarProps) {
	@render {
		<nav>
			<ul class="plain">
				<li><a href="/" onclick={$props?.onnavigate}>Home</a></li>
			</ul>
			<h4>Docs</h4>
			<ul class="plain">
				<li><a href="/docs/overview" onclick={$props?.onnavigate}>Overview</a></li>
				<li><a href="/docs/getting-started" onclick={$props?.onnavigate}>Getting Started</a></li>
				<li><a href="/docs/components" onclick={$props?.onnavigate}>Components</a></li>
				<li><a href="/docs/markup" onclick={$props?.onnavigate}>Markup</a></li>
				<li><a href="/docs/state" onclick={$props?.onnavigate}>State</a></li>
				<li><a href="/docs/reactivity" onclick={$props?.onnavigate}>Reactivity</a></li>
				<li><a href="/docs/binding" onclick={$props?.onnavigate}>Binding</a></li>
				<li><a href="/docs/events" onclick={$props?.onnavigate}>Events</a></li>
				<li><a href="/docs/slots" onclick={$props?.onnavigate}>Slots</a></li>
				<li><a href="/docs/context" onclick={$props?.onnavigate}>Context</a></li>
				<li><a href="/docs/async" onclick={$props?.onnavigate}>Async</a></li>
				<li><a href="/docs/streams" onclick={$props?.onnavigate}>Streams</a></li>
				<li><a href="/docs/transitions" onclick={$props?.onnavigate}>Transitions</a></li>
				<li><a href="/docs/errors" onclick={$props?.onnavigate}>Errors</a></li>
				<li><a href="/docs/styles" onclick={$props?.onnavigate}>Styles</a></li>
				<li><a href="/docs/special-tags" onclick={$props?.onnavigate}>Special Tags</a></li>
				<li><a href="/docs/comparisons" onclick={$props?.onnavigate}>Comparisons</a></li>
			</ul>
			<h4>UI</h4>
			<ul class="plain">
				<li><a href="/ui/overview" onclick={$props?.onnavigate}>Overview</a></li>
				<li><a href="/ui/accordion" onclick={$props?.onnavigate}>Accordion</a></li>
				<li><a href="/ui/breadcrumb" onclick={$props?.onnavigate}>Breadcrumb</a></li>
				<li><a href="/ui/calendar" onclick={$props?.onnavigate}>Calendar</a></li>
				<li><a href="/ui/carousel" onclick={$props?.onnavigate}>Carousel</a></li>
				<li><a href="/ui/charts" onclick={$props?.onnavigate}>Charts</a></li>
				<li><a href="/ui/command-palette" onclick={$props?.onnavigate}>CommandPalette</a></li>
				<li><a href="/ui/combo-box" onclick={$props?.onnavigate}>ComboBox</a></li>
				<li><a href="/ui/contextual" onclick={$props?.onnavigate}>Contextual</a></li>
				<li><a href="/ui/date-picker" onclick={$props?.onnavigate}>DatePicker</a></li>
				<li><a href="/ui/date-range-picker" onclick={$props?.onnavigate}>DateRangePicker</a></li>
				<li><a href="/ui/dialog" onclick={$props?.onnavigate}>Dialog</a></li>
				<li><a href="/ui/disclosure" onclick={$props?.onnavigate}>Disclosure</a></li>
				<li><a href="/ui/drawer" onclick={$props?.onnavigate}>Drawer</a></li>
				<li><a href="/ui/form" onclick={$props?.onnavigate}>Form</a></li>
				<li><a href="/ui/list-box" onclick={$props?.onnavigate}>ListBox</a></li>
				<li><a href="/ui/menu" onclick={$props?.onnavigate}>Menu</a></li>
				<li><a href="/ui/menu-bar" onclick={$props?.onnavigate}>MenuBar</a></li>
				<li><a href="/ui/modal" onclick={$props?.onnavigate}>Modal</a></li>
				<li><a href="/ui/nav-menu" onclick={$props?.onnavigate}>NavMenu</a></li>
				<li><a href="/ui/number-input" onclick={$props?.onnavigate}>NumberInput</a></li>
				<li><a href="/ui/notification" onclick={$props?.onnavigate}>Notification</a></li>
				<li><a href="/ui/pagination" onclick={$props?.onnavigate}>Pagination</a></li>
				<li><a href="/ui/popover" onclick={$props?.onnavigate}>Popover</a></li>
				<li><a href="/ui/progress" onclick={$props?.onnavigate}>Progress</a></li>
				<li><a href="/ui/rating" onclick={$props?.onnavigate}>Rating</a></li>
				<li><a href="/ui/select-box" onclick={$props?.onnavigate}>SelectBox</a></li>
				<li>
					<a href="/ui/segmented-control" onclick={$props?.onnavigate}>SegmentedControl</a>
				</li>
				<li><a href="/ui/slider" onclick={$props?.onnavigate}>Slider</a></li>
