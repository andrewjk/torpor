import { $page } from "@torpor/build/state";

interface SidebarLink {
	label: string;
	href: string;
}

interface SidebarProps {
	/** The links to show in the sidebar */
	links?: ReadonlyArray<SidebarLink>;
	/** Called when a link in the sidebar is clicked, e.g. to close a nav drawer */
	onnavigate?: () => void;
}

export default function Sidebar($props?: SidebarProps) {
	@render {
		<nav>
			<ul class="plain">
				@for (let link of $props?.links ?? []) {
					@key = link.href
					<li>
						<a
							href={link.href}
							onclick={$props?.onnavigate}
							class={{ active: $page.url.pathname === link.href }}
						>
							{link.label}
						</a>
					</li>
				}
			</ul>
		</nav>
	}

	@style {
		nav {
			font-size: 1.4rem;
		}

		ul {
			display: flex;
			flex-direction: column;
			gap: 0.2rem;
		}

		a {
			border-radius: var(--brad);
			display: block;
			padding: 0.3rem 0.5rem;
			text-decoration: none;
		}

		a:hover {
			background: var(--panel-back);
			text-decoration: none;
		}

		a.active {
			background: var(--panel-back);
			color: var(--header);
			font-weight: 600;
		}
	}
}
