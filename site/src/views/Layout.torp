import { Drawer, DrawerContent, DrawerOverlay } from "@torpor/ui/Drawer";
import { slide } from "@torpor/ui/motion";
import List from "phosphor-torpor/lib/List";
import X from "phosphor-torpor/lib/X";
import Sidebar from "./Sidebar.torp";

export default function Layout() {
	let $state = $watch({
		navVisible: false,
	});

	@render {
		<div id="layout">
			<header class="mobile-header">
				<button
					class="nav-button"
					onclick={() => ($state.navVisible = true)}
					aria-label="Open navigation"
				>
					<List />
				</button>
				<a href="/" class="site-name">Torpor</a>
			</header>
			<div id="sidebar">
				<Sidebar />
			</div>
			<div id="content">
				<slot />
			</div>
		</div>

		<Drawer &visible={$state.navVisible}>
			<DrawerOverlay class="nav-overlay" />
			<DrawerContent ariaLabel="Site navigation">
				<div class="nav-drawer" transition={(e) => slide(e, { side: "left" })}>
					<header class="mobile-header">
						<button
							class="nav-button"
							onclick={() => ($state.navVisible = false)}
							aria-label="Close navigation"
						>
							<X />
						</button>
						<a href="/" class="site-name" onclick={() => ($state.navVisible = false)}>
							Torpor
						</a>
					</header>
					<Sidebar onnavigate={() => ($state.navVisible = false)} />
				</div>
			</DrawerContent>
		</Drawer>
	}

	@style {
		#layout {
			display: grid;
			grid-template-columns: auto 1fr;
			gap: 0.5rem;
			height: 100vh;
		}

		#sidebar {
			padding: 0.5rem;
		}

		#content {
			overflow: auto;
			padding: 0.5rem;
		}

		.mobile-header {
			display: none;
			align-items: center;
			gap: 0.75rem;
		}

		.nav-button {
			background: none;
			border: none;
			color: var(--text);
			cursor: pointer;
			display: inline-flex;
			font-size: 1.6rem;
			padding: 0.25rem;
		}

		.site-name {
			font-family: ui-serif, serif;
			font-size: 1.6rem;
			text-decoration: none;
		}

		.nav-overlay {
			background-color: rgba(0, 0, 0, 0.6);
			position: fixed;
			top: 0;
			left: 0;
			height: 100vh;
			width: 100vw;
			z-index: 100;
		}

		.nav-drawer {
			background: var(--bg);
			height: 100vh;
			max-width: 85vw;
			overflow: auto;
			padding: 0.5rem;
			width: 18rem;
			z-index: 200;
		}

		@media screen and (max-width: 767px) {
			#layout {
				grid-template-columns: 1fr;
				grid-template-rows: auto 1fr;
			}

			#sidebar {
				display: none;
			}

			#content {
				overflow: visible;
			}

			.mobile-header {
				display: flex;
			}
		}
	}
}
