import Header from "./Header.torp";

export default function Layout() {
	@render {
		<div id="layout">
			<Header />
			<div id="page">
				<slot />
			</div>
		</div>
	}

	@style {
		#layout {
			display: flex;
			flex-direction: column;
			height: 100vh;
		}

		#page {
			flex: 1;
			min-height: 0;
			overflow: auto;
			padding: 0.5rem;
		}

		@media screen and (max-width: 767px) {
			#layout {
				height: auto;
				min-height: 100vh;
			}

			#page {
				overflow: visible;
			}
		}
	}
}
