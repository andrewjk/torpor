import CodePreview from "../CodePreview.torp";
import Repl from "../repl/Repl.torp";

export default function StylesPage() {
	@head {
		<title>Styles | Torpor</title>
	}

	@render {
		<h1>Styles</h1>
		<p>
			The CSS for styling a component's elements is declared with a <code>&commat;style</code>
			block. There can only be one @style block per component:
		</p>
		<CodePreview
			code={`
export default function Component() {
	@render {
		<p class="extravagant">Hello!</p>
	}

	@style {
		.extravagant {
			font-size: x-large;
			color: magenta;
		}
	}
}
`}
		/>
		<p>
			The styles in the style block are scoped to the elements in the component so that
			they don't affect elements in other components. Behind the scenes, each rule is
			compiled to a hashed class (e.g. <code>torp-a1b2c3</code>) which is added to the
			component's elements.
		</p>

		<h2>Playground</h2>
		<Repl
			input={`
export default function Component() {
	@render {
		<p class="extravagant">Hello!</p>
	}

	@style {
		.extravagant {
			font-size: x-large;
			color: magenta;
		}
	}
}
`.trimStart()}
		/>
	}
}
