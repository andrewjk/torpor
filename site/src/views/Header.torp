import { $page } from "@torpor/build/state";
import { Disclosure, DisclosureContent, DisclosureHeader, DisclosureTrigger } from "@torpor/ui/Disclosure";
import { Drawer, DrawerContent, DrawerOverlay, DrawerTrigger } from "@torpor/ui/Drawer";
import { slide } from "@torpor/ui/motion";
import { NavMenu, NavMenuLink } from "@torpor/ui/NavMenu";
import { SegmentedControl, SegmentedItem } from "@torpor/ui/SegmentedControl";
import GithubLogo from "phosphor-torpor/lib/GithubLogo";
import List from "phosphor-torpor/lib/List";
import MoonStars from "phosphor-torpor/lib/MoonStars";
import Play from "phosphor-torpor/lib/Play";
import Sun from "phosphor-torpor/lib/Sun";
import torporLogo from "@/assets/torpor.svg";
import { NAV_SECTIONS } from "../utils/nav.ts";
import { navStore } from "../utils/navStore.ts";

export default function Header() {
	let $state = $watch({
		theme: "light",
	});

	$onmount(() => {
		// The documentElement class is the source of truth for the theme, as it
		// is set before first paint by the inline script in site.html
		$state.theme = document.documentElement.classList.contains("dark") ? "dark" : "light";

		$run(() => {
			const theme = $state.theme;
			document.documentElement.classList.toggle("dark", theme === "dark");
			try {
				localStorage.setItem("torpor-theme", theme);
			} catch {
				// Private browsing mode etc, theme just won't be persisted
			}
		});
	});

	function isActive(prefix: string): boolean {
		const path = $page.url.pathname;
		return path === prefix || path.startsWith(`${prefix}/`);
	}

	function closeDrawer() {
		navStore.visible = false;
	}

	@render {
		<header class="site-header">
			<Drawer &visible={navStore.visible}>
				<DrawerTrigger class="hamburger">
					<span class="visually-hidden">Open navigation menu</span>
					<List />
				</DrawerTrigger>
				<DrawerOverlay class="nav-drawer-overlay" />
				<DrawerContent ariaLabel="Site navigation">
					<div class="nav-drawer" transition={(e) => slide(e, { side: "left" })}>
						<a href="/" class="drawer-home" onclick={closeDrawer}>
							Torpor
						</a>
						@for (let section of NAV_SECTIONS) {
							@key = section.href
							<Disclosure expanded={isActive(section.href)} class="drawer-section">
								<DisclosureHeader>
									<DisclosureTrigger class="drawer-section-trigger">
										{section.label}
									</DisclosureTrigger>
								</DisclosureHeader>
								<DisclosureContent>
									<div class="drawer-sublinks">
										@for (let link of section.links) {
											@key = link.href
											<a
												href={link.href}
												class={{ "drawer-sublink": true, active: $page.url.pathname === link.href }}
												onclick={closeDrawer}
											>
												{link.label}
											</a>
										}
									</div>
								</DisclosureContent>
							</Disclosure>
						}
						<a href="/blog" class="drawer-link" onclick={closeDrawer}>
							Blog
						</a>
						<a href="/playground" class="drawer-link" onclick={closeDrawer}>
							Playground
						</a>
					</div>
				</DrawerContent>
			</Drawer>
			<a href="/" class="nav-link">
			<span class="hstack spaced">
				<img src={torporLogo} class="logo" alt="Torpor logo" style="height: 2.4rem; width: 2.4rem" />
				Torpor
			</span>
			</a>
			<NavMenu class="site-nav" ariaLabel="Site sections">
				<NavMenuLink href="/docs" class={["nav-link", { active: isActive("/docs") }]}>
					Docs
				</NavMenuLink>
				<NavMenuLink href="/ui" class={["nav-link", { active: isActive("/ui") }]}>
					Components
				</NavMenuLink>
				<NavMenuLink href="/build" class={["nav-link", { active: isActive("/build") }]}>
					Build
				</NavMenuLink>
				<NavMenuLink href="/blog" class={["nav-link", { active: isActive("/blog") }]}>
					Blog
				</NavMenuLink>
				<NavMenuLink href="/playground" class={["nav-link", { active: isActive("/playground") }]}>
					Playground
				</NavMenuLink>
			</NavMenu>
			<div class="actions">
				<SegmentedControl class="theme-control" ariaLabel="Color theme" &value={$state.theme}>
					<SegmentedItem value="light" class="theme-item">
						<Sun />
					</SegmentedItem>
					<SegmentedItem value="dark" class="theme-item">
						<MoonStars />
					</SegmentedItem>
				</SegmentedControl>
				<a
					href="https://github.com/andrewjk/torpor"
					target="_blank"
					rel="external"
					class="github-button"
					aria-label="GitHub repository"
				>
					<GithubLogo />
				</a>
			</div>
		</header>
	}

	@style {
		.site-header {
			align-items: center;
			background: var(--bg);
			border-bottom: 1px solid var(--panel-back);
			display: flex;
			gap: 1rem;
			padding: 0.6rem 1rem;
		}

		.site-name {
			color: var(--header);
			font-family: ui-serif, serif;
			font-size: 1.6rem;
			text-decoration: none;
		}

		.site-name:hover {
			text-decoration: none;
		}

		.site-nav {
			display: flex;
			gap: 0.25rem;
			overflow-x: auto;
		}

		.nav-link {
			border-radius: var(--brad);
			color: var(--text);
			display: inline-block;
			padding: 0.2rem 0.6rem;
			text-decoration: none;
			white-space: nowrap;
		}

		.nav-link:hover {
			background: var(--panel-back);
			text-decoration: none;
		}

		.nav-link.active {
			background: var(--panel-back);
			color: var(--header);
			font-weight: 600;
		}

		.actions {
			align-items: center;
			display: flex;
			gap: 0.6rem;
			margin-left: auto;
		}

		.playground-button {
			align-items: center;
			background: var(--panel-back);
			border: 1px solid var(--code-back);
			border-radius: var(--brad);
			color: var(--header);
			cursor: pointer;
			display: inline-flex;
			font-size: 1.3rem;
			gap: 0.4rem;
			padding: 0.3rem 0.7rem;
			text-decoration: none;
		}

		.playground-button:hover {
			text-decoration: none;
		}

		.theme-control {
			border: 1px solid var(--code-back);
			border-radius: var(--brad);
			padding: 0.15rem;
		}

		.theme-item {
			background: none;
			border: none;
			border-radius: calc(var(--brad) - 0.15rem);
			color: var(--text);
			cursor: pointer;
			display: inline-flex;
			padding: 0.25rem 0.4rem;
		}

		.theme-item[data-state="active"] {
			background: var(--code-back);
			color: var(--header);
		}

		.github-button {
			color: var(--text);
			display: inline-flex;
			font-size: 1.6rem;
			padding: 0.25rem;
			text-decoration: none;
		}

		.github-button:hover {
			text-decoration: none;
		}

		.hamburger {
			align-items: center;
			background: none;
			border: none;
			color: var(--text);
			cursor: pointer;
			display: none;
			font-size: 1.6rem;
			padding: 0.25rem;
		}

		.hamburger:hover {
			background: var(--panel-back);
		}

		.visually-hidden {
			clip: rect(0 0 0 0);
			clip-path: inset(50%);
			height: 1px;
			overflow: hidden;
			position: absolute;
			white-space: nowrap;
			width: 1px;
		}

		.nav-drawer-overlay {
			background-color: rgba(0, 0, 0, 0.6);
			height: 100vh;
			left: 0;
			position: fixed;
			top: 0;
			width: 100vw;
			z-index: 100;
		}

		.nav-drawer {
			background: var(--bg);
			display: flex;
			flex-direction: column;
			gap: 0.25rem;
			height: 100vh;
			left: 0;
			overflow: auto;
			padding: 1rem;
			position: fixed;
			top: 0;
			width: min(16rem, 80vw);
			z-index: 200;
		}

		.drawer-link {
			border-radius: var(--brad);
			color: var(--text);
			display: block;
			padding: 0.6rem 0.75rem;
			text-decoration: none;
		}

		.drawer-link:hover {
			background: var(--panel-back);
			text-decoration: none;
		}

		.drawer-link.active {
			background: var(--panel-back);
			color: var(--header);
			font-weight: 600;
		}

		.drawer-section-trigger {
			all: unset;
			cursor: pointer;
		}

		.drawer-home,
		.drawer-link,
		.drawer-section-trigger {
			color: var(--text);
			display: block;
			font-size: 1.4rem;
			padding: 0.6rem 0.75rem;
			text-decoration: none;
			width: 100%;
		}

		.drawer-home:hover,
		.drawer-link:hover,
		.drawer-section-trigger:hover {
			background: var(--panel-back);
			text-decoration: none;
		}

		.drawer-section-trigger[data-state="open"] {
			color: var(--header);
			font-weight: 600;
		}

		.drawer-sublinks {
			display: flex;
			flex-direction: column;
			padding-bottom: 0.5rem;
		}

		.drawer-sublink {
			border-radius: var(--brad);
			color: var(--text);
			display: block;
			font-size: 1.4rem;
			padding: 0.35rem 0.75rem 0.35rem 1.5rem;
			text-decoration: none;
		}

		.drawer-sublink:hover {
			background: var(--panel-back);
			text-decoration: none;
		}

		.drawer-sublink.active {
			background: var(--panel-back);
			color: var(--header);
			font-weight: 600;
		}

		/* Site nav links, nested in the drawer on small screens only (medium
		 * screens still show them in the header). Shown at every size when
		 * there are no sidebar links, so the drawer is never empty */
		.drawer-nav {
			display: none;
			flex-direction: column;
			gap: 0.25rem;
			margin-bottom: 0.5rem;
		}

		@media screen and (max-width: 767px) {
			.hamburger {
				display: flex;
			}
		}

		@media screen and (max-width: 575px) {
			.site-nav {
				display: none;
			}

			.playground-label {
				display: none;
			}
		}
	}
}
