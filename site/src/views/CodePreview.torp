import { codeToHtml } from "@torpor/shiki";

/**
 * Displays a colorized code preview.
 */
export default function CodePreview($props: { code: string }) {
	@head {
		<title>Torpor</title>
	}

	let $state = $watch({
		get code() {
			return $props!.code;
		},
		// Format the code asynchronously; re-formats when the code changes.
		get formatted() {
			return $async(async () => {
				const code = this.code;
				return (await codeToHtml(code, {
					lang: "torpor",
					theme: "light-plus",
				})).replace(/background-color:\s*#[a-f\d]{6};\s*/i, "");
			});
		},
	});

	@render {
		@await {
			@html($state.formatted)
		} with {
			<pre><code>{$state.code}</code></pre>
		}
	}
}
