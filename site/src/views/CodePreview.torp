/**
 * Displays a colorized code preview.
 */
export default function CodePreview($props: { code: string }) {
	@head {
		<title>Torpor</title>
	}

	let $state = $watch({
		get code() {
			return $props!.code;
		},
		// Format the code asynchronously; re-formats when the code changes.
		// Both light and dark theme colors are emitted, and switched between
		// by CSS (see the html.dark .shiki rules in style.css), so that
		// toggling the theme doesn't require a re-render.
		get formatted() {
			// `source: "server"`: the server highlights and ships the HTML, and
			// hands it to the thunk on the client's hydration run. Return it
			// unchanged so the highlighter (shiki) is loaded lazily — only a
			// real client render (navigation, or a code change) pulls it in.
			return $async(async (server): Promise<string> => {
				const code = this.code.trim();
				if (server !== undefined) {
					return server;
				}
				const { codeToHtml } = await import("@torpor/shiki");
				return (
					await codeToHtml(code, {
						lang: "torpor",
						themes: { light: "light-plus", dark: "dark-plus" },
					})
				)
					.replace(/background-color:\s*#[a-f\d]{6};\s*/gi, "")
					.replace(/--shiki-dark-bg:\s*#[a-f\d]{6};\s*/gi, "");
			}, { source: "server" });
		},
	});

	@render {
		@await {
			@html($state.formatted)
		} with {
			<pre><code>{$state.code}</code></pre>
		}
	}
}
