import { Popover, PopoverContent, PopoverHover } from "@torpor/ui/Popover";

export default function ExampleHover() {
	@render {
		<p>Hover over the panel below to trigger a tooltip.</p>

		<Popover>
			<PopoverHover hoverDelay={0} class="example-popover-target">Hover me</PopoverHover>
			<PopoverContent class="example-popover-content">
				I'm a tooltip...
			</PopoverContent>
		</Popover>
	}

	@style {
		.example-popover-target {
			border: 1px dashed var(--text);
			border-radius: 4px;
			cursor: default;
			padding: 20px;
		}

		.example-popover-content {
			background: var(--inverse-back);
			border: 1px solid var(--border);
			border-radius: 4px;
			color: var(--inverse-text);
			padding: 10px;
			z-index: 200;
		}
	}
}
