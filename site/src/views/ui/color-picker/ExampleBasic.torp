import { ColorPicker } from "@torpor/ui/ColorPicker";

export default function ExampleBasic() {
	let $state = $watch({ value: "#ff8800" });

	@render {
		<p>Value: {$state.value}</p>

		<ColorPicker
			class="example-color-picker"
			ariaLabel="Accent color"
			&value={$state.value}
		/>
	}

	@style {
		:global(.example-color-picker .torp-color-palette-swatch) {
			border: 1px solid var(--border);
			border-radius: 4px;
			height: 32px;
			width: 32px;
		}

		:global(.example-color-picker .torp-color-palette-swatch[data-selected="selected"]) {
			outline: 2px solid var(--header);
			outline-offset: 2px;
		}
	}
}
