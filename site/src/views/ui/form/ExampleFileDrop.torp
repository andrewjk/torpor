import { FileDrop } from "@torpor/ui/Form";

export default function ExampleFileDrop() {
	let $state = $watch({ files: [] as any[] });

	function onfiles(files: File[]) {
		$state.files = [...files];
	}

	@render {
		<div>
			<FileDrop
				class="example-file-drop"
				accept="image/*"
				multiple={true}
				ariaLabel="Upload images"
				onfiles={onfiles}
			/>
			@if ($state.files.length > 0) {
				<ul>
					@for (let file of $state.files) {
						@key = file.name
						<li>{file.name}</li>
					}
				</ul>
			}
		</div>
	}

	@style {
		.example-file-drop {
			border: 2px dashed var(--border);
			border-radius: 8px;
			box-sizing: border-box;
			cursor: pointer;
			font-size: 14px;
			padding: 32px;
			text-align: center;
			width: 360px;
		}

		.example-file-drop:focus-visible {
			outline: 2px solid var(--header);
			outline-offset: 2px;
		}
	}
}
