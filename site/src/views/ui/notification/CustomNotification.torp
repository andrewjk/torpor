import { Notification, NotificationClose, NotificationContent } from "@torpor/ui/Notification";

export default function CustomNotification() {
	@render {
		<Notification class="custom-notification-function" visible={true}>
			<NotificationContent>{$props.text}</NotificationContent>
			<NotificationClose>X</NotificationClose>
		</Notification>
	}

	@style {
		.custom-notification-function {
			pointer-events: all;

			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: 4px;

			display: grid;
			grid-template-columns: auto min-content;
			gap: 15px;

			width: 340px;
			padding: 10px;
		}
	}
}
