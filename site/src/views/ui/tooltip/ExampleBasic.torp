import { Tooltip, TooltipContent, TooltipTrigger } from "@torpor/ui/Tooltip";

export default function ExampleBasic() {
	@render {
		<p>Hover or focus the button:</p>
		<Tooltip openDelay={200} closeDelay={100}>
			<TooltipTrigger class="example-tooltip-trigger">Copy</TooltipTrigger>
			<TooltipContent class="example-tooltip-content">Copy to the clipboard</TooltipContent>
		</Tooltip>
	}

	@style {
		.example-tooltip-trigger {
			background: var(--surface);
			border: 1px solid var(--border);
			border-radius: 4px;
			color: inherit;
			font-size: 14px;
			padding: 8px 12px;
		}

		.example-tooltip-trigger:focus-visible {
			outline: 2px solid var(--header);
			outline-offset: 2px;
		}

		:global(.example-tooltip-content) {
			background: var(--text);
			border-radius: 4px;
			color: var(--surface);
			font-size: 13px;
			padding: 4px 8px;
			white-space: nowrap;
			z-index: 20;
		}
	}
}
