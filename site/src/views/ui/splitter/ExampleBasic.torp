import { Splitter, SplitterHandle, SplitterPane } from "@torpor/ui/Splitter";

export default function ExampleBasic() {
	let $state = $watch({ value: 40 });

	@render {
		<div>
			<Splitter class="example-splitter" min={20} &value={$state.value}>
				<SplitterPane class="example-splitter-pane">One</SplitterPane>
				<SplitterHandle class="example-splitter-handle" ariaLabel="Resize panes" />
				<SplitterPane class="example-splitter-pane">Two</SplitterPane>
			</Splitter>
			<p>Primary pane: {$state.value}%</p>
		</div>
	}

	@style {
		.example-splitter {
			height: 120px;
		}

		.example-splitter-pane {
			background-color: var(--accent-soft);
			border: 1px solid var(--accent);
			border-radius: 8px;
			box-sizing: border-box;
			padding: 12px;
		}

		.example-splitter-handle {
			background-color: var(--accent);
			cursor: col-resize;
			flex: 0 0 8px;
			margin: 0 4px;
		}

		.example-splitter-handle:focus-visible {
			outline: 2px solid var(--header);
			outline-offset: 2px;
		}
	}
}
