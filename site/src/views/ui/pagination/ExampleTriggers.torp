import { Pagination, PaginationItem } from "@torpor/ui/Pagination";

export default function ExampleTriggers() {
	let $state = $watch({
		count: 15,
		page: 1,
	});

	@render {
		<Pagination class="example-pagination" {$state.count} &page={$state.page}>
			<PaginationItem class="example-pagination-trigger" page="start" disabled={$state.page < 2} />
			<PaginationItem
				class="example-pagination-trigger"
				page="previous"
				disabled={$state.page < 2}
			/>
			@for (let page of $slot.pages) {
				<PaginationItem class="example-pagination-item" {page} active={String(page) === String($state.page)} />
			}
			<PaginationItem
				class="example-pagination-trigger"
				page="next"
				disabled={$state.page > $state.count - 1}
			/>
			<PaginationItem
				class="example-pagination-trigger"
				page="end"
				disabled={$state.page > $state.count - 1}
			/>
		</Pagination>
	}

	@style {
		.example-pagination {
			display: flex;
			gap: 10px;
			align-items: center;
		}

		.example-pagination-trigger {
			display: flex;
			align-items: center;
			height: 100%;
		}

		.example-pagination-item[data-state='active'] {
			font-weight: bold;
		}
	}
}
