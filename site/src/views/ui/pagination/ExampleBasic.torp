import { Pagination, PaginationItem } from "@torpor/ui/Pagination";

export default function ExampleBasic() {
	let $state = $watch({
		count: 15,
		page: 1,
	});

	@render {
		<Pagination class="example-pagination" {$state.count} &page={$state.page}>
			@for (let page of $slot.pages) {
				<PaginationItem class="example-pagination-item" {page} active={page == $state.page} />
			}
		</Pagination>
	}

	@style {
		.example-pagination {
			display: flex;
			gap: 10px;
			align-items: center;
		}

		.example-pagination-item[data-state='active'] {
			font-weight: bold;
		}
	}
}
