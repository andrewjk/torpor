import { ScatterChart } from "@torpor/ui/Charts";

export default function ExampleScatterChart() {
	@render {
		<ScatterChart
			height={200}
			width={400}
			ariaLabel="Height versus weight"
			xLabel={"Height"}
			yLabel={"Weight"}
			series={[
				{ name: "A", data: [ { x: 15, y: 40 }, { x: 23, y: 18 } ] },
				{ name: "B", data: [ { x: 25, y: 45 } ] },
				{ name: "C", data: [ { x: 45, y: 30 } ] },
			]}
		/>
	}

	@style {
		svg line {
			stroke: var(--text);
		}
	}
}
