import { BarChart } from "@torpor/ui/Charts";

export default function ExampleBarChart() {
	@render {
		<BarChart
			height={200}
			width={400}
			ariaLabel="Votes per candidate"
			xLabel={"Votes"}
			maxValue={100}
			stepCount={2}
			series={[
				{ name: "Ada", data: [83] },
				{ name: "Grace", data: [67] },
				{ name: "Linus", data: [42] },
			]}
		/>
	}

	@style {
		svg line {
			stroke: var(--text);
		}
	}
}
