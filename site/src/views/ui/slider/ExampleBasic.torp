import { Slider } from "@torpor/ui/Slider";

export default function ExampleBasic() {
	let $state = $watch({
		value: 30,
	});

	@render {
		<p>Value: {$state.value}</p>

		<Slider class="example-slider" ariaLabel="Volume" &value={$state.value} />
	}

	@style {
		.example-slider {
			border-radius: 4px;
			height: 6px;
			margin: 10px 0;
			width: 240px;
		}

		:global(.example-slider) {
			background-color: var(--code-back);
		}

		:global(.torp-slider-fill) {
			background-color: var(--accent);
			border-radius: 4px;
			height: 100%;
		}

		:global(.torp-slider-thumb) {
			all: unset;
			background-color: var(--accent);
			border-radius: 50%;
			box-sizing: border-box;
			cursor: default;
			height: 16px;
			width: 16px;
		}

		:global(.torp-slider-thumb:focus-visible) {
			box-shadow: black 0px 0px 0px 2px;
		}
	}
}
