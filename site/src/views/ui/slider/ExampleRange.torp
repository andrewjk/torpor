import { Slider } from "@torpor/ui/Slider";

export default function ExampleRange() {
	let $state = $watch({
		value: 400,
	});

	@render {
		<p>Value: {$state.value}</p>

		<Slider
			class="example-slider"
			ariaLabel="Price limit"
			min={100}
			max={900}
			step={50}
			&value={$state.value}
		/>
	}

	@style {
		.example-slider {
			border-radius: 4px;
			height: 6px;
			margin: 10px 0;
			width: 240px;
		}

		:global(.example-slider) {
			background-color: gainsboro;
		}

		:global(.torp-slider-fill) {
			background-color: dodgerblue;
			border-radius: 4px;
			height: 100%;
		}

		:global(.torp-slider-thumb) {
			all: unset;
			background-color: dodgerblue;
			border-radius: 50%;
			box-sizing: border-box;
			cursor: default;
			height: 16px;
			top: 50%;
			transform: translate(-50%, -50%);
			width: 16px;
		}

		:global(.torp-slider-thumb:focus-visible) {
			box-shadow: black 0px 0px 0px 2px;
		}
	}
}
