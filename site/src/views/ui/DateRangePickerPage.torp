import { TabContent, TabGroup, TabList } from "@torpor/ui/TabGroup";
import CodePreview from "../CodePreview.torp";
import ExampleTabGroup from "./ExampleTabGroup.torp";
import ExampleTabHeader from "./ExampleTabHeader.torp";
import ExampleBasic from "./date-range-picker/ExampleBasic.torp";
import ExampleBasicCode from "./date-range-picker/ExampleBasic.torp?raw";

export default function DateRangePickerPage() {
	@head {
		<title>DateRangePicker | Torpor</title>
	}

	@render {
		<h1>DateRangePicker</h1>
		<p>
			An input for selecting a range of dates from a calendar popout. The first click sets the
			start of the range and the second sets its end; clicking a date before the start begins a
			new range there.
		</p>
		<h2>Structure</h2>
		<pre><code>{`
<DateRangePicker ariaLabel="Stay dates" />
`.trim()}</code></pre>
		<h2>Demo</h2>
		<TabGroup>
			<TabList ariaLabel="Example tabs">
				<ExampleTabHeader>
					Basic
				</ExampleTabHeader>
			</TabList>
			<TabContent>
				<ExampleTabGroup>
					<ExampleBasic />
					<fill name="code">
						<CodePreview code={ExampleBasicCode} />
					</fill>
				</ExampleTabGroup>
			</TabContent>
		</TabGroup>
	}
}
