import { $page } from "@torpor/build/state";
import Sidebar from "./Sidebar.torp";

interface SidebarLink {
	label: string;
	href: string;
}

interface SectionLayoutProps {
	/** The links to show in this section's sidebar */
	links?: ReadonlyArray<SidebarLink>;
}

/**
 * The shared layout for site sections (docs, ui, build) that have a sidebar.
 * The sidebar is visible on large screens; below the responsive breakpoint
 * it slides in via the navigation drawer in the site header.
 */
export default function SectionLayout($props?: SectionLayoutProps) {
	let content: HTMLElement;

	$run(() => {
		// Scroll back to the top when the page changes
		$page.url;
		content?.scrollTo(0, 0);
		window.scrollTo(0, 0);
	});

	@render {
		<div id="section">
			<div id="sidebar">
				<Sidebar links={$props?.links} />
			</div>
			<div id="content" &ref={content}>
				<slot />
			</div>
		</div>
	}

	@style {
		#section {
			display: grid;
			grid-template-columns: minmax(0, 15rem) 1fr;
			height: 100%;
		}

		#sidebar {
			border-right: 1px solid var(--panel-back);
			overflow: auto;
			padding: 1rem;
		}

		#content {
			overflow: auto;
			padding: 1rem;
		}

		@media screen and (max-width: 767px) {
			#section {
				grid-template-columns: 1fr;
				height: auto;
				min-height: 100%;
			}

			#sidebar {
				display: none;
			}

			#content {
				overflow: visible;
			}
		}
	}
}
