{
	"name": "@torpor/embed",
	"version": "0.1.0",
	"description": "Load and render torpor components authored at runtime: REPLs, feed embeds, custom sections",
	"type": "module",
	"exports": {
		".": {
			"torpor:source": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./compile": {
			"torpor:source": "./src/compile.ts",
			"types": "./dist/compile.d.mts",
			"import": "./dist/compile.mjs",
			"require": "./dist/compile.cjs"
		},
		"./server": {
			"torpor:source": "./src/server.ts",
			"types": "./dist/server.d.mts",
			"import": "./dist/server.mjs",
			"require": "./dist/server.cjs"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "tsgo --noEmit && pnpm dlx oxlint --type-aware",
		"build": "node scripts/generateVersion.mjs && tsgo --noEmit && vp pack",
		"build:watch": "vp pack --watch",
		"test": "vp test",
		"format": "vp fmt ."
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"sucrase": "^3.35.1"
	},
	"peerDependencies": {
		"@torpor/view": ">=1.2.6"
	},
	"devDependencies": {
		"@torpor/view": "workspace:^",
		"@types/node": "^26.6.5",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"esbuild": "^0.28.2",
		"jsdom": "^30.1.2",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
