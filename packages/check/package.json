{
	"name": "@torpor/check",
	"version": "0.0.1",
	"description": "Checks Torpor files for errors",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"torp-check": "./dist/bin/index.js"
	},
	"scripts": {
		"check": "tsgo --noEmit && pnpm dlx oxlint --type-aware",
		"build": "tsgo --noEmit && vp pack",
		"build:fix": "tsx scripts/postbuild.ts",
		"build:watch": "vp pack --watch",
		"test": "vp test"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@torpor/view": "workspace:^",
		"@typescript/vfs": "^1.6.4",
		"chalk": "^6.0.0",
		"fast-glob": "^3.3.3"
	},
	"devDependencies": {
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"tsx": "^4.23.5",
		"typescript": "6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
