{
	"name": "torpor",
	"displayName": "Torpor",
	"description": "Torpor language support for VS Code: syntax highlighting, diagnostics, completions, hover, go to definition and more for .torp files",
	"version": "1.0.3",
	"private": true,
	"publisher": "torpor",
	"author": "",
	"license": "ISC",
	"icon": "logo.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/andrewjk/torpor",
		"directory": "packages/vscode"
	},
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"torpor",
		"torp"
	],
	"engines": {
		"vscode": "^1.105.0"
	},
	"activationEvents": [
		"onLanguage:torpor"
	],
	"main": "./dist/client.js",
	"contributes": {
		"languages": [
			{
				"id": "torpor",
				"extensions": [
					".torp"
				]
			}
		],
		"grammars": [
			{
				"language": "torpor",
				"scopeName": "source.torp",
				"path": "./syntaxes/torpor.tmLanguage.json",
				"embeddedLanguages": {
					"meta.embedded.block.typescript": "script",
					"meta.embedded.block.html": "html",
					"meta.embedded.block.css": "css"
				}
			}
		]
	},
	"scripts": {
		"build": "tsx scripts/build.mts",
		"watch": "tsx scripts/build.mts --watch",
		"vscode:prepublish": "pnpm build --pack",
		"check": "tsgo --noEmit && pnpm dlx oxlint --type-aware",
		"package": "vsce package --no-dependencies",
		"publish": "vsce publish --no-dependencies",
		"publish:patch": "vsce publish patch --no-dependencies",
		"publish:minor": "vsce publish minor --no-dependencies",
		"publish:major": "vsce publish major --no-dependencies"
	},
	"dependencies": {
		"@torpor/language-server": "workspace:^",
		"typescript": "6.0.3",
		"vscode-languageclient": "^9.0.1"
	},
	"devDependencies": {
		"@torpor/textmate": "workspace:^",
		"@types/node": "^26.1.2",
		"@types/vscode": "^1.105.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"@vscode/vsce": "^3.9.2",
		"esbuild": "^0.28.1",
		"tsx": "^4.23.5",
		"vite-plus": "catalog:"
	}
}
