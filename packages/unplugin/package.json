{
	"name": "@torpor/unplugin",
	"version": "1.0.1",
	"description": "Unplugin package to compile Torpor components for Vite, Rollup, and other bundlers",
	"keywords": [
		"torpor",
		"unplugin"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./astro": {
			"types": "./dist/astro.d.mts",
			"import": "./dist/astro.mjs"
		},
		"./rspack": {
			"types": "./dist/rspack.d.mts",
			"import": "./dist/rspack.mjs"
		},
		"./vite": {
			"types": "./dist/vite.d.mts",
			"import": "./dist/vite.mjs"
		},
		"./webpack": {
			"types": "./dist/webpack.d.mts",
			"import": "./dist/webpack.mjs"
		},
		"./rollup": {
			"types": "./dist/rollup.d.mts",
			"import": "./dist/rollup.mjs"
		},
		"./esbuild": {
			"types": "./dist/esbuild.d.mts",
			"import": "./dist/esbuild.mjs"
		},
		"./nuxt": {
			"types": "./dist/nuxt.d.mts",
			"import": "./dist/nuxt.mjs"
		},
		"./types": {
			"types": "./dist/types.d.mts",
			"import": "./dist/types.mjs"
		},
		"./*": "./*"
	},
	"typesVersions": {
		"*": {
			"*": [
				"./dist/*",
				"./*"
			]
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "tsgo --noEmit && pnpm dlx oxlint --type-aware",
		"build": "tsgo --noEmit && vp pack",
		"build:watch": "vp pack --watch src",
		"lint": "eslint .",
		"play": "npm -C playground run dev",
		"prepublishOnly": "npm run build",
		"release": "bumpp && npm publish",
		"start": "esno src/index.ts"
	},
	"peerDependencies": {
		"@nuxt/kit": "^3",
		"@nuxt/schema": "^3",
		"esbuild": "*",
		"rollup": "^3 || ^4",
		"vite": ">=3",
		"webpack": "^4 || ^5"
	},
	"peerDependenciesMeta": {
		"webpack": {
			"optional": true
		},
		"rollup": {
			"optional": true
		},
		"vite": {
			"optional": true
		},
		"esbuild": {
			"optional": true
		},
		"@nuxt/kit": {
			"optional": true
		},
		"@nuxt/schema": {
			"optional": true
		}
	},
	"dependencies": {
		"@torpor/view": "workspace:^",
		"unplugin": "^3.3.0"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^9.2.0",
		"@nuxt/kit": "^4.5.1",
		"@nuxt/schema": "^4.5.1",
		"@types/node": "^26.1.2",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"bumpp": "^12.1.1",
		"chalk": "^6.0.0",
		"eslint": "^10.8.0",
		"esno": "^4.8.0",
		"fast-glob": "^3.3.3",
		"nodemon": "^3.1.14",
		"rimraf": "^6.1.3",
		"rollup": "^4.62.4",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"webpack": "^5.109.2"
	}
}
