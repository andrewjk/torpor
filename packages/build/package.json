{
	"name": "@torpor/build",
	"version": "1.0.0",
	"description": "A framework for building sites and apps with Torpor",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./dev": {
			"types": "./dist/dev.d.mts",
			"development": "./src/dev.ts",
			"import": "./dist/dev.mjs"
		},
		"./form": {
			"types": "./dist/form.d.mts",
			"import": "./dist/form.mjs"
		},
		"./nav": {
			"types": "./dist/nav.d.mts",
			"import": "./dist/nav.mjs"
		},
		"./openapi": {
			"types": "./dist/openapi.d.mts",
			"import": "./dist/openapi.mjs"
		},
		"./response": {
			"types": "./dist/response.d.mts",
			"import": "./dist/response.mjs"
		},
		"./schema": {
			"types": "./dist/schema.d.mts",
			"import": "./dist/schema.mjs"
		},
		"./run": {
			"types": "./dist/run.d.mts",
			"import": "./dist/run.mjs"
		},
		"./server": {
			"types": "./dist/server.d.mts",
			"import": "./dist/server.mjs"
		},
		"./state": {
			"types": "./dist/state.d.mts",
			"import": "./dist/state.mjs"
		},
		"./test": {
			"types": "./dist/test.d.mts",
			"import": "./dist/test.mjs"
		},
		"./manifest": {
			"types": "./src/types/manifest.d.ts"
		}
	},
	"files": [
		"dist",
		"src/types/manifest.d.ts"
	],
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"tb": "./dist/bin/index.js"
	},
	"scripts": {
		"check": "tsgo --noEmit && pnpm dlx oxlint --type-aware",
		"build": "tsgo --noEmit && vp pack",
		"build:watch": "vp pack --watch",
		"test": "vp test"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@torpor/unplugin": "workspace:^",
		"@torpor/view": "workspace:^",
		"cookie": "^2.0.1",
		"dotenv": "^17.4.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"devDependencies": {
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"esno": "^4.8.0",
		"typescript": "^7.0.2"
	}
}
