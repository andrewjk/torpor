{
	"name": "@torpor/adapter-node",
	"version": "1.0.2",
	"description": "A @torpor/build adapter for running on Node",
	"type": "module",
	"exports": {
		"types": "./dist/index.d.mts",
		"import": "./dist/index.mjs"
	},
	"files": [
		"dist"
	],
