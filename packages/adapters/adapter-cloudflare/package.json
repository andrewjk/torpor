{
	"name": "@torpor/adapter-cloudflare",
	"version": "1.0.3",
	"description": "A @torpor/build adapter for deploying to Cloudflare Pages",
	"type": "module",
	"exports": {
		"types": "./dist/index.d.mts",
		"import": "./dist/index.mjs"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "tsgo --noEmit && pnpm dlx oxlint --type-aware",
		"build": "tsgo --noEmit && vp pack",
		"build:watch": "vp pack --watch"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@torpor/build": "workspace:^",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"@cloudflare/vite-plugin": "^1.0.0",
		"wrangler": "^4.118.0"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.50.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"typescript": "^7.0.2",
		"vite-plus": "catalog:",
		"wrangler": "^4.118.0"
	}
}
