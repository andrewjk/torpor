{
	"name": "@torpor/adapter-electron",
	"version": "1.0.0",
	"description": "A @torpor/build adapter for building desktop apps with Electron",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./runtime": {
			"types": "./dist/runtime.d.mts",
			"import": "./dist/runtime.mjs"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "tsgo --noEmit && pnpm dlx oxlint --type-aware",
		"build": "tsgo --noEmit && vp pack",
		"build:watch": "vp pack --watch"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@torpor/adapter-node": "workspace:^",
		"@torpor/build": "workspace:^",
		"vite": "catalog:"
	},
	"devDependencies": {
		"@types/node": "^26.1.2",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"typescript": "^7.0.2",
		"vite-plus": "catalog:"
	}
}
