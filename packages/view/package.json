{
	"name": "@torpor/view",
	"version": "0.4.18",
	"description": "Torpor's view library, for writing and mounting components",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./compile": {
			"types": "./dist/compile.d.mts",
			"import": "./dist/compile.mjs",
			"require": "./dist/compile.cjs"
		},
		"./ssr": {
			"types": "./dist/ssr.d.mts",
			"import": "./dist/ssr.mjs",
			"require": "./dist/ssr.cjs"
		},
		"./dev": {
			"types": "./dist/dev.d.mts",
			"import": "./dist/dev.mjs",
			"require": "./dist/dev.cjs"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "tsgo --noEmit && pnpm dlx oxlint --type-aware",
		"build": "tsgo --noEmit && tsdown && tsx ./scripts/copyToRepl.ts",
		"build:watch": "tsdown --watch",
		"test": "vitest",
		"test:build": "tsx ./scripts/buildTestOutput.ts",
		"bench": "tsx ./bench/bench.ts",
		"format": "prettier --write ."
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@testing-library/dom": "catalog:",
		"@testing-library/jest-dom": "catalog:",
		"@testing-library/user-event": "^14.6.3",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/jsdom": "^28.0.3",
		"@types/node": "^26.1.2",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"fast-glob": "^3.3.3",
		"jsdom": "^30.0.1",
		"oxlint-tsgolint": "^7.0.2001",
		"sucrase": "catalog:",
		"tinybench": "^6.1.2",
		"tsdown": "0.22.14",
		"tsx": "^4.23.5",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
