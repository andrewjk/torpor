{
	"name": "@torpor/view",
	"version": "1.2.1",
	"description": "Torpor's view library, for writing and mounting components",
	"type": "module",
	"exports": {
		".": {
			"torpor:source": "./src/index.ts",
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.cjs"
		},
		"./compile": {
			"torpor:source": "./src/compile.ts",
			"types": "./dist/compile.d.mts",
			"import": "./dist/compile.mjs",
			"require": "./dist/compile.cjs"
		},
		"./ssr": {
			"torpor:source": "./src/ssr.ts",
			"types": "./dist/ssr.d.mts",
			"import": "./dist/ssr.mjs",
			"require": "./dist/ssr.cjs"
		},
		"./dev": {
			"torpor:source": "./src/dev.ts",
			"types": "./dist/dev.d.mts",
			"import": "./dist/dev.mjs",
			"require": "./dist/dev.cjs"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "tsgo --noEmit && pnpm dlx oxlint --type-aware",
		"build": "tsgo --noEmit && vp pack && tsx ./scripts/copyToRepl.ts",
		"build:watch": "vp pack --watch",
		"test": "vp test",
		"test:build": "tsx ./scripts/buildTestOutput.ts",
		"bench": "tsx ./bench/bench.ts",
		"format": "vp fmt ."
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devDependencies": {
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/user-event": "^14.6.8",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.6.5",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"fast-glob": "^3.3.3",
		"jsdom": "^30.1.2",
		"sucrase": "^3.35.1",
		"tinybench": "^6.2.2",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
