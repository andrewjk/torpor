{
	"name": "@torpor/prettier",
	"version": "0.0.1",
	"description": "A Prettier plugin for Torpor files",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "tsgo --noEmit && pnpm dlx oxlint --type-aware",
		"build": "tsgo --noEmit && tsdown",
		"build:watch": "tsdown --watch",
		"test": "vitest"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@torpor/view": "workspace:^",
		"prettier": "^3.9.6"
	},
	"devDependencies": {
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"oxlint-tsgolint": "^7.0.2001",
		"tsdown": "0.22.14",
		"tsx": "^4.23.5",
		"vitest": "^4.1.10"
	}
}
