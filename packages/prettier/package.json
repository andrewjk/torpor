{
	"name": "@torpor/prettier",
	"version": "1.0.1",
	"description": "A Prettier plugin for Torpor files",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs",
			"default": "./dist/index.mjs"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"check": "tsgo --noEmit && pnpm dlx oxlint --type-aware",
		"build": "tsgo --noEmit && vp pack",
		"build:watch": "vp pack --watch",
		"test": "vp test"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"dependencies": {
		"@torpor/view": "workspace:^",
		"prettier": "^3.9.6"
	},
	"devDependencies": {
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"tsx": "^4.23.5",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	}
}
