import { Field, Form } from "../../../src/Form/index";
import { DateTimePicker } from "../../../src/DateTimePicker/index";

export default function DateTimePickerTest($props: any) {
	let $state = $watch({
		value: undefined as Date | undefined,
	});

	@render {
		<Form onsubmit={() => false}>
			<Field name="starts_at" &value={$state.value}>
				<DateTimePicker
					&value={$state.value}
					ariaLabel="Start date and time"
					onchange={$props?.onchange}
				/>
			</Field>
		</Form>
	}
}
