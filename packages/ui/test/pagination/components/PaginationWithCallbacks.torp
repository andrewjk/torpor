import {
	Pagination,
	PaginationItem,
} from "../../../src/Pagination/index";

export default function PaginationWithCallbacks() {
	let $state = $watch({ page: 5, lastClicked: "" });

	function handleChange(active: boolean) {
		if (active) {
			$state.lastClicked = `Page ${$state.page}`;
		}
	}

	@render {
		<div>
			<Pagination count={10} &page={$state.page}>
				@for (let page of $slot.pages) {
					<PaginationItem page={page} active={$state.page === page} onchange={handleChange}>
						{page}
					</PaginationItem>
				}
			</Pagination>
			<div id="last-clicked">{$state.lastClicked}</div>
		</div>
	}
}
