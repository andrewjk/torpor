import {
	Pagination,
	PaginationItem,
} from "../../../src/Pagination/index";

export default function PaginationWithCallbacks() {
	let $state = $watch({ number: 5, lastClicked: "" });

	function handleToggle(active: boolean) {
		if (active) {
			$state.lastClicked = `Page ${$state.number}`;
		}
	}

	@render {
		<div>
			<Pagination count={10} &number={$state.number}>
				@for (let page of $slot.pages) {
					<PaginationItem page={page} active={$state.number === page} ontoggle={handleToggle}>
						{page}
					</PaginationItem>
				}
			</Pagination>
			<div id="last-clicked">{$state.lastClicked}</div>
		</div>
	}
}
