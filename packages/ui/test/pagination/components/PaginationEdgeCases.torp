import {
	Pagination,
	PaginationItem,
} from "../../../src/Pagination/index";

export default function PaginationEdgeCases() {
	let $state = $watch({ number: 1 });

	@render {
		<Pagination {$props.count} number={$state.number}>
			<PaginationItem page="start" active={$state.number === 1}>«</PaginationItem>
			<PaginationItem page="previous" active={$state.number === 1}>‹</PaginationItem>
			@for (let page of $slot.pages) {
				<PaginationItem page={page} active={$state.number === page}>
					{page}
				</PaginationItem>
			}
			<PaginationItem page="next" active={$state.number === $props.count}>›</PaginationItem>
			<PaginationItem page="end" active={$state.number === $props.count}>»</PaginationItem>
		</Pagination>
	}
}
