import {
	Pagination,
	PaginationItem,
} from "../../../src/Pagination/index";

export default function PaginationWithEllipsis() {
	let $state = $watch({ number: 15 });

	@render {
		<Pagination count={50} number={$state.number} maxPages={7}>
			<PaginationItem page="start" active={$state.number === 1}>«</PaginationItem>
			<PaginationItem page="previous" active={$state.number === 1}>‹</PaginationItem>
			@for (let page of $slot.pages) {
				<PaginationItem page={page} active={$state.number === page} />
			}
			<PaginationItem page="next" active={$state.number === 50}>›</PaginationItem>
			<PaginationItem page="end" active={$state.number === 50}>»</PaginationItem>
		</Pagination>
	}
}
