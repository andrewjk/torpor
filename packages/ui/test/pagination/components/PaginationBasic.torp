import {
	Pagination,
	PaginationItem,
} from "../../../src/Pagination/index";

export default function PaginationBasic() {
	let $state = $watch({ page: 1 });

	@render {
		<Pagination count={10} page={$state.page} maxPages={10}>
			@for (let page of $slot.pages) {
				<PaginationItem page={page} active={$state.page === page}>
					{page}
				</PaginationItem>
			}
		</Pagination>
	}
}
