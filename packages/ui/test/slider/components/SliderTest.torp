import { Slider } from "../../../src/Slider/index";

export default function SliderTest($props: any) {
	@render {
		<Slider
			{$props?.value}
			{$props?.min}
			{$props?.max}
			{$props?.step}
			{$props?.orientation}
			{$props?.disabled}
			ariaLabel={$props?.ariaLabel ?? "Volume"}
			onchange={$props?.onchange}
		/>
	}
}
