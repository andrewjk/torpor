import { ComboBox, ComboBoxContent, ComboBoxInput } from "../../../src/ComboBox/index";

/** A ComboBox that loads its options from the `load` prop as the user types */
export default function LoaderComboBox($props: any) {
	@render {
		<ComboBox
			&value={$props.value}
			load={$props.load}
			onload={$props.onload}
			onchange={$props.onchange}
			getItemLabel={$props.getItemLabel}
			getItemValue={$props.getItemValue}
			multiple={$props.multiple}
		>
			<ComboBoxInput />
			<ComboBoxContent />
		</ComboBox>
	}
}
