import {
	ComboBox,
	ComboBoxContent,
	ComboBoxInput,
	ComboBoxTrigger,
} from "../../../src/ComboBox/index";
import { ListBox, ListBoxItem } from "../../../src/ListBox/index";

export default function ListBoxList($props: any) {
	@render {
		<ComboBox &value={$props.value} name="hi">
			<ComboBoxInput />
			<ComboBoxTrigger />
			<ComboBoxContent>
				<ListBox {$props.value}>
					@for (let item of $props.items) {
						@key = item.id
						<ListBoxItem value={item.id}>
							{item.text}
						</ListBoxItem>
					}
				</ListBox>
			</ComboBoxContent>
		</ComboBox>
	}
}
