import {
	ComboBox,
	ComboBoxContent,
	ComboBoxInput,
	ComboBoxTrigger,
} from "../../../src/ComboBox/index";
import { ListBox, ListBoxItem } from "../../../src/ListBox/index";

export default function ComboBoxMultiple($props: any) {
	@render {
		<ComboBox
			id={$props.id}
			class={$props.class}
			style={$props.style}
			name={$props.name}
			&value={$props.value}
			placeholder={$props.placeholder}
			required={$props.required}
			ariaLabel={$props.ariaLabel}
			visible={$props.visible}
			onchange={$props.onchange}
			onopen={$props.onopen}
			onclose={$props.onclose}
		>
			<ComboBoxInput>
				{$props.value.join(", ")}
			</ComboBoxInput>
			<ComboBoxTrigger />
			<ComboBoxContent>
				<ListBox type="multiple" {$props.value}>
					<ListBoxItem>
						Item 1
					</ListBoxItem>
					<ListBoxItem>
						Item 2
					</ListBoxItem>
					<ListBoxItem>
						Item 3
					</ListBoxItem>
				</ListBox>
			</ComboBoxContent>
		</ComboBox>
	}
}
