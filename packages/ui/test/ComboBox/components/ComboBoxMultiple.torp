import {
	ComboBox,
	ComboBoxContent,
	ComboBoxInput,
	ComboBoxTrigger,
} from "../../../src/ComboBox/index";
import { ListBox, ListBoxItem } from "../../../src/ListBox/index";

export default function ComboBoxMultiple($props: any) {
	@render {
		<ComboBox &value={$props.value} {...$props}>
			<ComboBoxInput>
				{$props.value.join(", ")}
			</ComboBoxInput>
			<ComboBoxTrigger />
			<ComboBoxContent>
				<ListBox type="multiple" {$props.value}>
					<ListBoxItem>
						Item 1
					</ListBoxItem>
					<ListBoxItem>
						Item 2
					</ListBoxItem>
					<ListBoxItem>
						Item 3
					</ListBoxItem>
				</ListBox>
			</ComboBoxContent>
		</ComboBox>
	}
}
