import {
	Pagination,
	PaginationItem,
} from "../../../src/Pagination/index";

export default function PaginationEmpty() {
	let $state = $watch({ page: 1 });

	@render {
		<Pagination count={0} page={$state.page}>
			@for (let page of $slot.pages) {
				<PaginationItem page={page} active={$state.page === page}>
					{page}
				</PaginationItem>
			}
		</Pagination>
	}
}
