import {
	Pagination,
	PaginationItem,
} from "../../../src/Pagination/index";

export default function PaginationWithTriggers() {
	let $state = $watch({ page: 5 });

	@render {
		<Pagination count={20} &page={$state.page}>
			<PaginationItem page="start">«</PaginationItem>
			<PaginationItem page="previous">‹</PaginationItem>
			@for (let page of $slot.pages) {
				<PaginationItem page={page} active={$state.page === page}>
					{page}
				</PaginationItem>
			}
			<PaginationItem page="next">›</PaginationItem>
			<PaginationItem page="end">»</PaginationItem>
		</Pagination>
	}
}
