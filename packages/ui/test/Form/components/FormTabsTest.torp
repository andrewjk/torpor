export default function FormTabsTest() {
	@render {
		<form id="tabs-form">
			<TabGroup name="section" value="b">
				<TabList ariaLabel="Sections">
					<TabHeader>
						<TabTrigger>Section 1</TabTrigger>
					</TabHeader>
					<TabHeader>
						<TabTrigger>Section 2</TabTrigger>
					</TabHeader>
