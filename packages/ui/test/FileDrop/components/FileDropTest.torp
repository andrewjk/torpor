import { FileDrop } from "../../../src/Form/index";

export default function FileDropTest($props: any) {
	@render {
		<FileDrop
			{$props?.multiple}
			{$props?.accept}
			{$props?.disabled}
			{$props?.name}
			ariaLabel={$props?.ariaLabel ?? "Upload files"}
			onfiles={$props?.onfiles}
		/>
	}
}
