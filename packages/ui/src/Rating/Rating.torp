import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import $handle from "../utils/$handle";
import {
	type FieldContext,
	FieldContextName,
	type FormContext,
	FormContextName,
} from "../Form/FormTypes";
import FormValues from "../Form/FormValues.torp";
import createFormField from "../utils/formField";
import RatingStar from "./RatingStar.torp";
import { type RatingContext, RatingContextName } from "./RatingTypes";

interface RatingProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The maximum rating, i.e. the number of stars (default 5) */
	max?: number;
	/** The current rating */
	value?: Bindable<number>;
	/** If set to true, the user cannot interact with this rating */
	disabled?: boolean;
	/** If set to false, clicking or re-selecting the current rating does not clear it (default true) */
	allowClear?: boolean;
	/** An accessible name for the rating */
	ariaLabel?: string;
	/** The name of the component's form data field */
	name?: string;
	/** Raised when the rating has changed */
	onchange?: (value: number) => void;
}

/**
 * A star rating input, where the user selects a value from 1 to a maximum
 * number of stars by clicking or by using the keyboard.
 *
 * Implements the radio group pattern: each star is a radio button, the star
 * matching the current rating is checked, and arrow keys move the rating.
 *
 * See [the WAI ARIA guidelines for Rating](https://www.w3.org/WAI/ARIA/apg/patterns/rating/).
 *
 * The structure of a Rating is:
 *
 * ```
 * <Rating>
 * 	<RatingStar />
 * </Rating>
 * ```
 *
 * With no children, the stars are rendered automatically.
 */
export default function Rating($props: RatingProps | undefined) {
	let stars: (HTMLButtonElement | undefined)[] = [];
	let root: HTMLElement;

	// Wire up the enclosing Form and Field, if any
	const form = createFormField(
		$props?.name,
		$context[FormContextName] as FormContext | undefined,
		$context[FieldContextName] as FieldContext | undefined,
	);

	function getMax(): number {
		const max = $props?.max ?? 5;
		return max > 0 ? Math.floor(max) : 5;
	}
	function getDisabled(): boolean {
		return $props?.disabled === true;
	}

	let $state = $watch({
		value: 0,
		hover: 0,
		get stars(): number[] {
			return Array.from({ length: getMax() }, (_, i) => i + 1);
		},
	});

	$bind($state, $props, "value");

	// Keep the stored value clamped, so that out-of-range initial values
	// don't later surface as user changes
	$run(() => {
		const clamped = clamp($state.value);
		if (clamped !== $state.value) {
			$state.value = clamped;
		}
	});

	// Dispatch the change event when the value changes
	$handle((first) => {
		const value = $state.value;
		if (!first) $props?.onchange?.(value);
	});

	function clamp(value: number): number {
		return Math.min(getMax(), Math.max(0, value));
	}

	function getValue(): number {
		return clamp($state.value);
	}

	function setValue(value: number, focus = false) {
		const next = clamp(value);
		if (next !== $state.value) {
			$state.value = next;
		}
		if (focus) {
			stars[next - 1]?.focus();
		}
	}

	// The number of filled stars to display, taking the hovered star into
	// account for the mouse preview
	function getDisplayValue(): number {
		return getDisabled() ? getValue() : Math.max(getValue(), $state.hover);
	}

	// Set the context to pass down to the stars
	let context: RatingContext = {
		getDisplayValue,
		getDisabled,
		isTabStop: (value) => value === ($state.value > 0 ? $state.value : 1),
		isChecked: (value) => value === getValue(),
		selectValue,
		handleKey,
		setHover: (value) => {
			$state.hover = value;
		},
		registerStar: (value, el) => {
			stars[value - 1] = el;
		},
		unregisterStar: (value, el) => {
			if (stars[value - 1] === el) {
				stars[value - 1] = undefined;
			}
		},
	};
	$context[RatingContextName] = context;

	function selectValue(value: number) {
		if (getDisabled()) return;
		if (value === $state.value && ($props?.allowClear ?? true)) {
			setValue(0);
		} else {
			setValue(value);
		}
		form.handleInput();
	}

	function handleKey(e: KeyboardEvent) {
		if (getDisabled()) return;

		switch (e.key) {
			case "ArrowRight":
			case "ArrowUp": {
				e.preventDefault();
				setValue(Math.max(1, $state.value + 1), true);
				form.handleInput();
				break;
			}
			case "ArrowLeft":
			case "ArrowDown": {
				e.preventDefault();
				setValue($state.value <= 1 ? 1 : $state.value - 1, true);
				form.handleInput();
				break;
			}
			case "Home": {
				e.preventDefault();
				setValue(1, true);
				form.handleInput();
				break;
			}
			case "End": {
				e.preventDefault();
				setValue(getMax(), true);
				form.handleInput();
				break;
			}
		}
	}

	// Only blur when focus leaves the whole rating
	function handleFocusOut(e: FocusEvent) {
		if (!root.contains(e.relatedTarget as Node | null)) {
			form.handleBlur();
		}
	}

	@render {
		<div
			{$props?.id}
			class={["torp-rating", getDisabled() ? "torp-rating-disabled" : undefined, $props?.class]}
			{$props?.style}
			role="radiogroup"
			aria-label={$props?.ariaLabel}
			aria-disabled={getDisabled() ? "true" : undefined}
			data-valid={form.valid ? "valid" : "invalid"}
			aria-describedby={form.messageId}
			aria-invalid={form.inField && !form.valid ? "true" : undefined}
			onmouseleave={() => ($state.hover = 0)}
			onfocusout={handleFocusOut}
			&ref={root}
		>
			<slot>
				@for (let value of $state.stars) {
					@key = value
					<RatingStar {value} />
				}
			</slot>
		</div>

		<FormValues name={form.name} value={getValue() > 0 ? getValue() : undefined} />
	}

	@style {
		/* Headless: layout only, so the stars sit in a row. All appearance is
		   up to the consuming theme */
		.torp-rating {
			display: inline-flex;
		}
	}
}
