import type { ClassValue, StyleValue } from "@torpor/view";
import { type RatingContext, RatingContextName } from "./RatingTypes";

interface RatingStarProps {
	/** An ID for the star element */
	id?: string;
	/** Classes for the star element */
	class?: ClassValue;
	/** Styles for the star element */
	style?: StyleValue;
	/** The star's value (1-based position in the rating) */
	value: number;
}

/**
 * One star of a Rating, acting as a radio button. The star matching the
 * current rating is checked, and the stars up to the rating (or the hovered
 * star) are marked as filled.
 *
 * See [the WAI ARIA guidelines for Rating](https://www.w3.org/WAI/ARIA/apg/patterns/rating/).
 */
export default function RatingStar($props: RatingStarProps | undefined) {
	// Get stuff out of the Rating context
	const context = $context[RatingContextName] as RatingContext;
	if (!context) {
		throw new Error("RatingStar must be contained within a Rating");
	}

	function getValue(): number {
		return $props?.value ?? 0;
	}

	function getDisabled(): boolean {
		return context.getDisabled();
	}

	function label(): string {
		const value = getValue();
		return `${value} ${value === 1 ? "star" : "stars"}`;
	}

	@render {
		<button
			type="button"
			{$props?.id}
			class={["torp-rating-star", $props?.class]}
			{$props?.style}
			role="radio"
			tabindex={context.isTabStop(getValue()) ? 0 : -1}
			aria-checked={context.isChecked(getValue()) ? "true" : "false"}
			aria-label={label()}
			aria-disabled={getDisabled() ? "true" : undefined}
			data-state={getValue() <= context.getDisplayValue() ? "filled" : "empty"}
			onmount={(el) => {
				context.registerStar(getValue(), el);
				return () => {
					context.unregisterStar(getValue(), el);
				};
			}}
			onclick={() => context.selectValue(getValue())}
			onkeydown={context.handleKey}
			onmouseenter={() => {
				if (!getDisabled()) context.setHover(getValue());
			}}
		>
			<slot item={{ value: getValue(), filled: getValue() <= context.getDisplayValue() }}>
				<span aria-hidden="true">★</span>
			</slot>
		</button>
	}
}
