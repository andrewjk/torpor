import type { ClassValue, StyleValue } from "@torpor/view";

interface AlertProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The kind of message, for theming (default "info") */
	variant?: "info" | "success" | "warning" | "error";
	/** An accessible name for the alert */
	ariaLabel?: string;
}

/**
 * An inline message that is announced by assistive tech as soon as it is
 * shown, for errors, warnings and other important status updates.
 *
 * See [the WAI ARIA alert pattern](https://www.w3.org/WAI/ARIA/apg/patterns/alert/).
 *
 * Unlike Notification (a toast), an Alert sits in the flow of the page:
 *
 * ```
 * <Alert variant="error">Your changes could not be saved.</Alert>
 * ```
 */
export default function Alert($props: AlertProps | undefined) {
	@render {
		<div
			{$props?.id}
			class={["torp-alert", $props?.class]}
			{$props?.style}
			role="alert"
			aria-label={$props?.ariaLabel}
			data-variant={$props?.variant ?? "info"}
		>
			<slot />
		</div>
	}
}
