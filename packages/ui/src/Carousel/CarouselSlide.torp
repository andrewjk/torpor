import type { ClassValue, StyleValue } from "@torpor/view";
import { type CarouselContext, CarouselContextName } from "./CarouselTypes";

interface CarouselSlideProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An accessible label for the slide; defaults to "n of m" */
	ariaLabel?: string;
}

/**
 * A slide in a Carousel, only one of which is visible at a time.
 */
export default function CarouselSlide($props: CarouselSlideProps | undefined) {
	// Get stuff out of the Carousel context
	const context = $context[CarouselContextName] as CarouselContext;
	if (!context) {
		throw new Error("CarouselSlide must be contained within a Carousel");
	}

	// Register this slide with the parent Carousel
	let $state = context.registerSlide();

	$run(() => {
		return () => {
			context.removeSlide($state.index);
		};
	});

	@render {
		<div
			{$props?.id}
			class={["torp-carousel-slide", $props?.class]}
			{$props?.style}
			role="group"
			aria-roledescription="slide"
			aria-label={$props?.ariaLabel ?? `${$state.index + 1} of ${context.count()}`}
			data-state={context.isActive($state.index) ? "active" : "inactive"}
		>
			@if (context.isActive($state.index)) {
				<slot />
			}
		</div>
	}

	@style {
		/* Headless: inactive slides are hidden from display and the accessibility
		   tree. All other appearance is up to the consuming theme */
		.torp-carousel-slide[data-state="inactive"] {
			display: none;
		}
	}
}
