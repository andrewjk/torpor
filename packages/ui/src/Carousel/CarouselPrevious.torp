import type { ClassValue, StyleValue } from "@torpor/view";
import ChevronLeft from "../icons/ChevronLeft.torp";
import { type CarouselContext, CarouselContextName } from "./CarouselTypes";

interface CarouselPreviousProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label for the button, for screen readers when the button contains no text */
	ariaLabel?: string;
	/** If set to true, the user cannot interact with this button */
	disabled?: boolean;
}

/**
 * The button in a Carousel that a user can press to move to the previous
 * slide.
 */
export default function CarouselPrevious($props: CarouselPreviousProps | undefined) {
	// Get stuff out of the Carousel context
	const context = $context[CarouselContextName] as CarouselContext;
	if (!context) {
		throw new Error("CarouselPrevious must be contained within a Carousel");
	}

	@render {
		<button
			{$props?.id}
			class={["torp-carousel-previous", $props?.class]}
			{$props?.style}
			type="button"
			aria-label={$props?.ariaLabel ?? "Previous slide"}
			disabled={$props?.disabled || !context.canPrevious()}
			onclick={() => context.previousSlide()}
		>
			<slot>
				<ChevronLeft />
			</slot>
		</button>
	}
}
