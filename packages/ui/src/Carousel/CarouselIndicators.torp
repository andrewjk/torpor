import type { ClassValue, StyleValue } from "@torpor/view";
import { type CarouselContext, CarouselContextName } from "./CarouselTypes";

interface CarouselIndicatorsProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
}

/**
 * A series of buttons in a Carousel, one per slide, that a user can press to
 * move directly to that slide.
 */
export default function CarouselIndicators($props: CarouselIndicatorsProps | undefined) {
	// Get stuff out of the Carousel context
	const context = $context[CarouselContextName] as CarouselContext;
	if (!context) {
		throw new Error("CarouselIndicators must be contained within a Carousel");
	}

	let $state = $watch({
		get slides() {
			return context.slides();
		},
	});

	function indicatorLabel(index: number): string {
		return `Go to slide ${index + 1}`;
	}

	@render {
		<div
			{$props?.id}
			class={["torp-carousel-indicators", $props?.class]}
			{$props?.style}
		>
			@for (let slide of $state.slides) {
				@key = slide.index
				<button
					type="button"
					class="torp-carousel-indicator"
					aria-label={indicatorLabel(slide.index)}
					aria-current={context.isActive(slide.index) ? "true" : undefined}
					data-state={context.isActive(slide.index) ? "active" : "inactive"}
					onclick={() => context.goToSlide(slide.index)}
				>
					<slot item={{ index: slide.index, active: context.isActive(slide.index) }}>
						<span aria-hidden="true" />
					</slot>
				</button>
			}
		</div>
	}

	@style {
		/* Headless: layout only, so the indicators sit in a row. All appearance
		   is up to the consuming theme */
		.torp-carousel-indicators {
			display: flex;
		}
	}
}
