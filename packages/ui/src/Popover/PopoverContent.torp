import type { ClassValue, StyleValue } from "@torpor/view";
import getId from "../utils/getId";
import { createPopoutContent } from "../utils/popoutContent";
import { type PopoverContext, PopoverContextName } from "./PopoverTypes";

interface PopoverContentProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** Where the popover will be shown, relative to the popover trigger */
	side?: "top" | "right" | "bottom" | "left";
	/** How the popover will be aligned, relative to the popover trigger */
	alignment?: "start" | "center" | "end";
}

/**
 * The content that is displayed for a Popover when it is open, displayed
 * alongside an element.
 */
export default function PopoverContent($props?: PopoverContentProps | undefined) {
	let defaultId = getId();

	// Get stuff out of the PopoverContext
	const context = $context[PopoverContextName] as PopoverContext;
	if (!context) {
		throw new Error("PopoverContent must be contained within a Popover");
	}
	let $state = context.state;

	// Set the content ID so that the trigger can use it with aria-controls
	$state.contentId = $props?.id ?? defaultId;

	const popout = createPopoutContent({
		getAnchor: () => context.anchorElement,
		getContent: () => div,
		close: (e) => context.handleClickOutside?.(e),
		side: $props?.side ?? "bottom",
		alignment: $props?.alignment ?? "center",
		ignoreAnchorClicks: true,
		focusFirstElement: () => context.focusFirstElement?.(),
		refocusAnchorOnHide: true,
	});

	let div: HTMLDivElement;

	$run(() => {
		if (!$state.visible) {
			popout.hide();
		}
	});

	@render {
		@if ($state.visible) {
			<div
				id={$props?.id ?? defaultId}
				class={["torp-popover-content", $props?.class]}
				{$props?.style}
				&ref={div}
				onmount={() => popout.show()}
			>
				<slot />
			</div>
		}
	}
}
