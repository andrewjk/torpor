import type { ClassValue, StyleValue } from "@torpor/view";
import PopoutClickTrigger from "../utils/PopoutClickTrigger.torp";
import { type PopoverContext, PopoverContextName } from "./PopoverTypes";

interface PopoverTriggerProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
}

/**
 * The button that causes a Popover to appear or disappear when pressed.
 *
 * For hover activation, use PopoverHover instead -- hover surfaces need an
 * intent delay and an exit grace period that a press button doesn't.
 */
export default function PopoverTrigger($props?: PopoverTriggerProps) {
	// Get stuff out of the PopoverContext
	const context = $context[PopoverContextName] as PopoverContext;
	if (!context) {
		throw new Error("PopoverTrigger must be contained within a Popover");
	}

	@render {
		<PopoutClickTrigger
			id={$props?.id}
			class={$props?.class ?? "torp-popover-trigger"}
			style={$props?.style}
			context={context}
			tag="button"
			event="click"
		>
			<slot />
		</PopoutClickTrigger>
	}
}
