import type { ClassValue, StyleValue } from "@torpor/view";
import { type DataColumn, type DataGridContext, DataGridContextName } from "./DataGridTypes";

interface DataGridColumnHeaderProps {
	/** An ID for the header element */
	id?: string;
	/** Classes for the header element */
	class?: ClassValue;
	/** Styles for the header element */
	style?: StyleValue;
	/** The column this header is for */
	column: DataColumn;
}

/**
 * One column header of a DataGrid, showing the column's label -- in a
 * button that sorts by the column when it is sortable.
 */
export default function DataGridColumnHeader($props: DataGridColumnHeaderProps | undefined) {
	// Get stuff out of the DataGrid context
	const context = $context[DataGridContextName] as DataGridContext;
	if (!context) {
		throw new Error("DataGridColumnHeader must be contained within a DataGrid");
	}

	function getColumn(): DataColumn {
		return $props?.column ?? { key: "" };
	}

	@render {
		<th
			{$props?.id}
			scope="col"
			role="columnheader"
			class={[
				context.getAlignClass(getColumn().align),
				getColumn().sortable ? "torp-data-grid-sortable" : undefined,
				$props?.class,
			]}
			{$props?.style}
			aria-sort={context.getAriaSort(getColumn().key)}
		>
			<slot>
				@if (getColumn().sortable) {
					<button type="button" onclick={() => context.toggleSort(getColumn())}>
						{getColumn().label ?? getColumn().key}
					</button>
				} else {
					<span>{getColumn().label ?? getColumn().key}</span>
				}
			</slot>
		</th>
	}
}
