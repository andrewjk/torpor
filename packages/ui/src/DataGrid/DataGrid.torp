import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import { type DataColumn, type DataGridContext, DataGridContextName } from "./DataGridTypes";
import DataGridCell from "./DataGridCell.torp";
import DataGridColumnHeader from "./DataGridColumnHeader.torp";
import type {
	LoadRequest,
	LoadResult,
	Loader,
} from "../utils/loader";
import { normalizeLoadResult } from "../utils/loader";
import sortRows from "./sortRows";
import getId from "../utils/getId";

interface DataGridProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** A caption for the table, rendered in a `<caption>` element */
	caption?: string;
	/** The columns to display */
	columns: DataColumn[];
	/** The rows to display. Pass either `data` (static rows) or `load`. */
	data?: any[];
	/**
	 * Reads rows from the network (or anywhere async). Receives a request with
	 * `page`/`pageSize`, `searchText` and `sortBy`/`sortDirection`, plus an
	 * AbortSignal. Pass either `load` or `data`, not both.
	 */
	load?: Loader;
	/** The active page (1-based). Two-way bindable. */
	page?: Bindable<number>;
	/** The number of rows per page. Static data is sliced locally; loaders receive it in the request. */
	pageSize?: number;
	/**
	 * Renders only the rows visible in the viewport, for large datasets.
	 * Requires `rowHeight`; supersedes local page slicing while enabled
	 */
	virtual?: boolean;
	/** The fixed pixel height of a row, required by virtualization */
	rowHeight?: number;
	/** The scroll viewport height in pixels when virtual (default 400) */
	height?: number;
	/** Extra rows rendered above and below the visible window (default 5) */
	overscan?: number;
	/** The field the data is sorted by. Two-way bindable. */
	sortBy?: Bindable<string | undefined>;
	/** The direction the data is sorted in. Two-way bindable. */
	sortDirection?: Bindable<"asc" | "desc">;
	/** An ARIA label describing the grid to screen readers */
	ariaLabel?: string;
	/** An ID of an element that labels the grid */
	ariaLabelledBy?: string;
	/** Called after each successful load with the normalized result (including `total`) */
	onload?: (result: LoadResult) => void;
	/** Called when a load starts, including reloads triggered by sorting or paging */
	onloadstart?: () => void;
	/** Called when the user sorts by a column */
	onchange?: (sortBy: string | undefined, sortDirection: "asc" | "desc") => void;
	/** Whether clicking or pressing Space selects a row or a cell */
	selection?: "row" | "cell";
	/**
	 * The current selection: the row index in `row` mode, or a `{ row, col }`
	 * position in `cell` mode (0-based, within the current page). Two-way
	 * bindable; cleared when the grid pages or sorts.
	 */
	selected?: Bindable<number | { row: number; col: number } | undefined>;
	/** Called after the selection changes, with the selected row and (in cell mode) its column */
	onselect?: (row: any, column: DataColumn | undefined) => void;
}

/**
 * A table of rows that supports sorting, paging and loading data from the
 * network.
 *
 * See [the WAI-ARIA guidelines for grids](https://www.w3.org/WAI/ARIA/apg/patterns/grid/).
 *
 * Keyboard navigation: arrows move between cells, Home/End (with Ctrl for
 * the grid corners) jump to row edges, and PageUp/PageDown move a page of
 * rows -- one viewport when `virtual`, the adjacent page when `pageSize`
 * paginates.
 *
 * When rows are windowed (virtual), paged (`pageSize`) or loaded in part,
 * the grid sets aria-rowcount -- the full set's size including the header
 * row, or -1 when a paged loader doesn't report a total -- and positions
 * each rendered row with aria-rowindex (the header is row 1, data rows
 * count from 2).
 *
 * When `selection` is set, clicking a cell or pressing Space selects it
 * (or its row) and sets aria-selected; the selection binds through
 * `selected` and reports through `onselect`.
 *
 * The structure of a DataGrid is a table of DataGridColumnHeaders and
 * DataGridCells, rendered automatically from the columns and rows:
 *
 * ```
 * <DataGrid columns={columns} data={rows}>
 * 	(cell content, using $slot.row / $slot.column / $slot.value)
 * </DataGrid>
 * ```
 *
 * Cells render their value as text by default. Pass children to customize:
 *
 * ```
 * <DataGrid columns={columns} data={rows}>
 * 	{@if ($slot.column.key === "avatar") {
 * 		<img src={$slot.value} alt="" />
 * 	} else {
 * 		{$slot.value}
 * 	}}
 * </DataGrid>
 * ```
 *
 * Named slots: `loading` (while the first load is pending), `error`
 * (receives nothing -- use it around the message), `empty` (when there are
 * no rows) and `header` isn't needed since headers come from the columns.
 */
export default function DataGrid($props: DataGridProps) {
	let defaultId = getId();

	if (!$props.columns || $props.columns.length === 0) {
		throw new Error("DataGrid: pass a non-empty `columns` array");
	}
	const hasLoader = typeof $props.load === "function";
	if (hasLoader && $props.data !== undefined) {
		throw new Error("DataGrid: pass either `load` or `data`, not both");
	}
	if (!hasLoader && $props.data === undefined) {
		throw new Error("DataGrid: pass either `load` or `data`");
	}

	let tableElement: HTMLElement;
	let wrap: HTMLElement;

	// Columns re-read from the (possibly reactive) prop, so headers, cells
	// and sorting update when the app adds or replaces a column
	let $state = $watch({
		page: $props.page ?? 1,
		sortBy: $props.sortBy,
		sortDirection: $props.sortDirection ?? "asc",
		activeCell: { row: 0, col: 0 },
		selected: $props.selected,

		// The columns with their positions, so cells can be keyed and
		// addressed by index
		get columnEntries(): { column: DataColumn; index: number }[] {
			return $props.columns.map((column, index) => ({ column, index }));
		},

		// True while a loader request is in flight, so reloads (which keep the
		// stale rows visible) can flag the table with aria-busy / data-loading
		reloading: false,

		// The result of the current load. Suspends while pending when read,
		// which drives the @await boundary in the template.
		get loadResult(): LoadResult | undefined {
			if (!hasLoader) {
				return undefined;
			}
			return $async(() => runLoad());
		},
		get sortedRows(): any[] {
			if (hasLoader) {
				return this.loadResult?.items ?? [];
			}
			return sortRows($props.data ?? [], this.sortBy, this.sortDirection, this.columnEntries.map((e) => e.column));
		},
		get totalCount(): number {
			if (hasLoader && this.loadResult?.total !== undefined) {
				return this.loadResult.total;
			}
			return this.sortedRows.length;
		},
		get rows(): any[] {
			const pageSize = $props.pageSize;
			if (!pageSize || hasLoader) {
				return this.sortedRows;
			}
			const start = (this.page - 1) * pageSize;
			return this.sortedRows.slice(start, start + pageSize);
		},
		get rowEntries() {
			return this.rows.map((row: any, index: number) => ({ row, index }));
		},
		// The rows currently rendered: everything when not virtual, the
		// visible window otherwise
		get bodyEntries() {
			if (!isVirtual()) return this.rowEntries;
			return this.rows.slice(win.start, win.endExclusive).map(
				(row: any, i: number) => ({ row, index: win.start + i }),
			);
		},
	});

	$bind($state, $props, "page", "sortBy", "sortDirection", "selected");

	// --- Virtualization ---

	function isVirtual(): boolean {
		return $props?.virtual === true && ($props?.rowHeight ?? 0) > 0;
	}

	function getRowHeight(): number {
		return Math.max(1, Math.floor($props?.rowHeight ?? 32));
	}

	function getOverscan(): number {
		return Math.max(0, Math.floor($props?.overscan ?? 5));
	}

	function getViewportHeight(): number {
		return wrap?.clientHeight || $props?.height || 400;
	}

	// The rendered row window; endExclusive may pass loaded rows when a
	// loader reports a total larger than what it sent so far -- slicing is
	// naturally safe against that
	const win = $watch({ start: 0, endExclusive: 0 });

	function updateWindow() {
		if (!isVirtual()) return;

		const total = $state.totalCount;
		if (!total || !wrap) {
			win.start = 0;
			win.endExclusive = 0;
			return;
		}

		const rh = getRowHeight();
		const overscan = getOverscan();
		const start = Math.min(Math.max(0, Math.floor(wrap.scrollTop / rh) - overscan), total);
		const visible = Math.ceil(getViewportHeight() / rh);
		win.start = start;
		win.endExclusive = Math.min(total, start + visible + overscan * 2);
	}

	function handleScroll() {
		updateWindow();
	}

	// The active cell, clamped to the current grid size -- rows can shrink
	// (e.g. after a load returns fewer rows) and the stored position must
	// stay addressable so exactly one cell remains the tab stop.
	// Clamping is done at the use sites rather than in an effect: effects
	// can't safely read suspended ($async) getters.
	function activeCell(): { row: number; col: number } {
		const maxRow = Math.max(0, $state.rows.length - 1);
		const maxCol = Math.max(0, $props.columns.length - 1);
		return {
			row: Math.min(Math.max(0, $state.activeCell.row), maxRow),
			col: Math.min(Math.max(0, $state.activeCell.col), maxCol),
		};
	}

	// Incremented on every load; only the latest load's settle updates
	// the pending flag
	let loadGeneration = 0;
	// The in-flight load's controller: starting a new load aborts it, so
	// loaders that take the signal can cancel the wire request. Loaders that
	// ignore it still work — the generation check discards stale results
	// application-side either way.
	let loadAbort: AbortController | null = null;

	function runLoad(): Promise<LoadResult> {
		const request: LoadRequest = {};
		if ($props.pageSize) {
			request.page = $state.page;
			request.pageSize = $props.pageSize;
		}
		if ($state.sortBy != null) {
			request.sortBy = $state.sortBy;
			request.sortDirection = $state.sortDirection;
		}
		// Flag the load as pending (and notify the consumer) before awaiting;
		// only the latest load's settle clears the flag, so a reload that
		// overtakes an older request doesn't drop the indicator early
		const generation = ++loadGeneration;
		loadAbort?.abort();
		const controller = new AbortController();
		loadAbort = controller;
		$state.reloading = true;
		$props.onloadstart?.();
		const result = Promise.resolve(($props.load as Loader)(request, controller.signal))
			.then(normalizeLoadResult)
			.catch((error) => {
				// Our own abort is not an error — the superseding load owns the
				// UI, so this one never settles instead of rejecting into the
				// error boundary
				if (controller.signal.aborted) {
					return new Promise<LoadResult>(() => {});
				}
				throw error;
			});
		// Report successful loads to the consumer; failures surface through
		// the component's error boundary, not this notification chain
		result.then(
			(r) => {
				if (generation === loadGeneration) {
					$state.reloading = false;
					// Restore focus to a page-flip target now that its rows
					// have loaded (queued after the render)
					applyPendingFocus();
				}
				$props.onload?.(r);
			},
			() => {
				if (generation === loadGeneration) {
					$state.reloading = false;
					pendingFocus = null;
				}
			},
		);
		return result;
	}

	function cellValue(row: any, column: DataColumn): any {
		if (column.getValue) {
			return column.getValue(row);
		}
		return row?.[column.key];
	}

	function cellId(row: number, col: number): string {
		return `${row}:${col}`;
	}

	function isActiveCell(row: number, col: number): boolean {
		const active = activeCell();
		return active.row === row && active.col === col;
	}

	function isSelectedRow(row: number): boolean {
		return $props.selection === "row" && $state.selected === row;
	}

	function isSelectedCell(row: number, col: number): boolean {
		if ($props.selection !== "cell") {
			return false;
		}
		const selected = $state.selected;
		return (
			!!selected && typeof selected === "object" && selected.row === row && selected.col === col
		);
	}

	// Selects the row or cell at a rendered position (a click or Space)
	function select(row: number, col: number) {
		const mode = $props.selection;
		if (!mode) {
			return;
		}
		// Clamp to the current grid size, like keyboard focus
		row = Math.min(Math.max(0, row), Math.max(0, $state.rows.length - 1));
		col = Math.min(Math.max(0, col), Math.max(0, $props.columns.length - 1));
		if (mode === "row") {
			$state.selected = row;
		} else {
			$state.selected = { row, col };
		}
		$props.onselect?.($state.rows[row], mode === "cell" ? $props.columns[col] : undefined);
	}

	// Clicking a cell selects it (or its row) when a selection mode is set
	function handleClick(e: MouseEvent) {
		const target = e.target as HTMLElement;
		const cell = target.closest?.("td[data-cell]");
		if (!$props.selection || !cell || target.closest("button,input,select,textarea,a[href]")) {
			return;
		}
		const [row, col] = cell.getAttribute("data-cell")!.split(":").map(Number);
		select(row, col);
	}

	function ariaSort(key: string): "ascending" | "descending" | undefined {
		if ($state.sortBy !== key) {
			return undefined;
		}
		return $state.sortDirection === "asc" ? "ascending" : "descending";
	}

	// Whether the grid represents more rows than it renders, so
	// aria-rowcount and aria-rowindex apply (APG grid-and-table-properties:
	// when the DOM holds a subset, it must say so and position each of its
	// rows). A virtual window, a page slice, or a partial lazy load.
	function isRowSubset(): boolean {
		return hasLoader || isVirtual() || !!$props.pageSize;
	}

	// The aria-rowcount value: the full set's size, including the header
	// row. A paged loader without `total` reports -1 (more rows exist,
	// count unknown); grids rendering everything report nothing.
	function ariaRowcount(): number | undefined {
		if (!isRowSubset()) {
			return undefined;
		}
		if (hasLoader && $props.pageSize && $state.loadResult?.total === undefined) {
			return -1;
		}
		return $state.totalCount + 1;
	}

	// The 1-based position of a rendered row within the full grid, for
	// aria-rowindex: the header row is row 1, so data rows start at 2.
	// Rendered row indexes are positions in the full set already -- body
	// entries number virtual windows from the global start -- except for
	// page slices, which are offset by the page's first row.
	function ariaRowIndex(index: number): number | undefined {
		if (!isRowSubset()) {
			return undefined;
		}
		const pageSize = !isVirtual() ? $props.pageSize : undefined;
		const pageOffset = pageSize ? ($state.page - 1) * pageSize : 0;
		return index + pageOffset + 2;
	}

	function toggleSort(column: DataColumn) {
		if (!column.sortable) {
			return;
		}
		// A sort reorders the rows, so a pending page-flip focus target and an
		// index-based selection no longer point at what the user was on
		pendingFocus = null;
		$state.selected = undefined;
		if ($state.sortBy === column.key) {
			$state.sortDirection = $state.sortDirection === "asc" ? "desc" : "asc";
		} else {
			$state.sortBy = column.key;
			$state.sortDirection = "asc";
		}
		$props.onchange?.($state.sortBy, $state.sortDirection);
	}

	// Scrolls the virtual window so a logical row is rendered, before it is
	// focused
	function makeRowVisible(row: number) {
		if (!isVirtual() || !wrap) return;

		const rh = getRowHeight();
		const overscan = getOverscan();
		if (row < win.start) {
			wrap.scrollTop = Math.max(0, (row - overscan) * rh);
			updateWindow();
		} else if (row >= win.endExclusive) {
			const below = Math.max(
				0,
				(row + 1 + overscan) * rh - getViewportHeight(),
			);
			wrap.scrollTop = below;
			updateWindow();
		}
	}

	function focusCell(row: number, col: number) {
		// Clamp to the current grid size: pages can render fewer rows than
		// the requested position (a partial last page), and rows can shrink
		// after a load
		row = Math.min(Math.max(0, row), Math.max(0, $state.rows.length - 1));
		col = Math.min(Math.max(0, col), Math.max(0, $props.columns.length - 1));
		makeRowVisible(row);
		$state.activeCell = { row, col };
		tableElement.querySelector<HTMLElement>(`[data-cell="${cellId(row, col)}"]`)?.focus();
	}

	// Any other way of focusing a cell (tabbing in, script) also moves the
	// keyboard navigation origin
	function handleFocusin(e: FocusEvent) {
		const cell = (e.target as HTMLElement).closest?.("td[data-cell]");
		if (!cell) {
			return;
		}
		const [row, col] = cell.getAttribute("data-cell")!.split(":").map(Number);
		$state.activeCell = { row, col };
	}

	// The number of pages to paginate over, or undefined when a loader
	// doesn't report `total` (keyboard paging then advances while the
	// current page is full, since a partial page must be the last one)
	function pageCount(): number | undefined {
		const pageSize = $props.pageSize;
		if (!pageSize) {
			return undefined;
		}
		if (hasLoader) {
			const total = $state.loadResult?.total;
			return total === undefined ? undefined : Math.max(1, Math.ceil(total / pageSize));
		}
		return Math.max(1, Math.ceil(($props.data ?? []).length / pageSize));
	}

	// Focus to apply once a page-flip reload settles: a loader's new rows
	// arrive after the keydown, so the target cell doesn't exist yet. Applied
	// after the new page's rows have rendered; cleared if the load fails, so
	// a dead target can't steal focus
	let pendingFocus: { row: number; col: number } | null = null;

	function applyPendingFocus() {
		const target = pendingFocus;
		if (!target) {
			return;
		}
		pendingFocus = null;
		// Queued from the load's settle handler, which is registered before
		// the $async continuation that re-renders the new page's rows -- so
		// this lands after it, when the cells exist
		Promise.resolve().then(() => focusCell(target.row, target.col));
	}

	// Moves focus one page of rows up or down (APG grid: "Down one page").
	// A virtual grid steps by its visible row count; a paged grid flips to
	// the adjacent page, keeping the column and the row's position in the
	// page. Returns whether the key was handled, so the browser's default
	// scroll still applies to grids without paging.
	function pageStep(row: number, col: number, direction: -1 | 1): boolean {
		const pageSize = $props.pageSize;
		if (!pageSize) {
			return false;
		}
		const page = $state.page;
		if (direction === -1) {
			if (page > 1) {
				goToPage(page - 1, row, col);
			} else {
				// Clamped at the first page: settle on its first row
				focusCell(0, col);
			}
			return true;
		}
		const pages = pageCount();
		const hasNext = pages === undefined ? $state.rows.length === pageSize : page < pages;
		if (hasNext) {
			goToPage(page + 1, row, col);
		} else {
			// Clamped at the last page: settle on its last row
			focusCell($state.rows.length - 1, col);
		}
		return true;
	}

	function goToPage(page: number, row: number, col: number) {
		if (hasLoader) {
			pendingFocus = { row, col };
		}
		// A different page re-points an index-based selection at other rows
		$state.selected = undefined;
		$state.page = page;
		if (!hasLoader) {
			// Static pages slice synchronously, so the target cell exists
			// as soon as the page state settles
			focusCell(row, col);
		}
	}

	// Standard grid keyboard navigation (roving tabindex over body cells)
	function handleKeydown(e: KeyboardEvent) {
		const target = e.target as HTMLElement;
		if (!target.matches?.("td[data-cell]")) {
			return;
		}
		if (target.closest("button,input,select,textarea,a[href]")) {
			return;
		}
		const maxRow = $state.rows.length - 1;
		const maxCol = $props.columns.length - 1;
		const active = activeCell();
		const row = active.row;
		const col = active.col;
		switch (e.key) {
			case "ArrowLeft": {
				if (col > 0) {
					e.preventDefault();
					focusCell(row, col - 1);
				}
				break;
			}
			case "ArrowRight": {
				if (col < maxCol) {
					e.preventDefault();
					focusCell(row, col + 1);
				}
				break;
			}
			case "ArrowUp": {
				if (row > 0) {
					e.preventDefault();
					focusCell(row - 1, col);
				}
				break;
			}
			case "ArrowDown": {
				if (row < maxRow) {
					e.preventDefault();
					focusCell(row + 1, col);
				}
				break;
			}
			case "Home": {
				e.preventDefault();
				focusCell(e.ctrlKey || e.metaKey ? 0 : row, e.ctrlKey || e.metaKey ? 0 : 0);
				break;
			}
			case "End": {
				e.preventDefault();
				focusCell(e.ctrlKey || e.metaKey ? maxRow : row, maxCol);
				break;
			}
			case " ": {
				if ($props.selection) {
					e.preventDefault();
					select(row, col);
				}
				break;
			}
			case "PageUp": {
				if (isVirtual()) {
					e.preventDefault();
					const step = Math.max(1, Math.floor(getViewportHeight() / getRowHeight()));
					focusCell(Math.max(0, active.row - step), col);
				} else if (pageStep(row, col, -1)) {
					e.preventDefault();
				}
				break;
			}
			case "PageDown": {
				if (isVirtual()) {
					e.preventDefault();
					const step = Math.max(1, Math.floor(getViewportHeight() / getRowHeight()));
					focusCell(Math.min(maxRow, active.row + step), col);
				} else if (pageStep(row, col, 1)) {
					e.preventDefault();
				}
				break;
			}
		}
	}

	const alignClass = (align: "start" | "center" | "end" | undefined) =>
		align ? `torp-data-grid-align-${align}` : undefined;

	function wrapStyle(): string | undefined {
		if (!isVirtual()) return undefined;
		return `max-height:${getViewportHeight()}px;overflow:auto;`;
	}

	// Set the context to pass down to the headers and cells
	let context: DataGridContext = {
		toggleSort,
		getAriaSort: ariaSort,
		getAlignClass: alignClass,
		getCellValue: cellValue,
		isActiveCell,
		isSelectedCell,
		getCellId: cellId,
	};
	$context[DataGridContextName] = context;

	@render {
		@try {
			@await {
				<div
					class="torp-data-grid-wrap"
					style={wrapStyle()}
					onscroll={handleScroll}
					onmount={(el: HTMLElement) => {
						wrap = el;
						updateWindow();
					}}
					&ref={wrap}
				>
				<table
					id={$props.id ?? defaultId}
					class={["torp-data-grid", $props.class]}
					{$props?.style}
					&ref={tableElement}
					role="grid"
					aria-label={$props.ariaLabel}
					aria-labelledby={$props.ariaLabelledBy}
					aria-rowcount={ariaRowcount()}
					aria-busy={$state.reloading ? "true" : undefined}
					data-loading={$state.reloading ? "true" : undefined}
					onkeydown={handleKeydown}
					onfocusin={handleFocusin}
					onclick={handleClick}
				>
					@if ($props.caption) {
						<caption>{$props.caption}</caption>
					}
					<thead>
						<tr role="row" aria-rowindex={isRowSubset() ? 1 : undefined}>
							@for (let entry of $state.columnEntries) {
								@key = entry.column.key
								<DataGridColumnHeader column={entry.column} />
							}
						</tr>
					</thead>
					<tbody>
						@if ($state.rowEntries.length === 0) {
							<tr role="row">
								<td colspan={$props.columns.length}>
									<slot name="empty">No results.</slot>
								</td>
							</tr>
						} else {
							@if (isVirtual()) {
								<tr aria-hidden="true" class="torp-data-grid-spacer">
									<td colspan={$props.columns.length} style={`height:${win.start * getRowHeight()}px`} />
								</tr>
							}
							@for (let rowEntry of $state.bodyEntries) {
								@key = rowEntry.row
								<tr
									role="row"
									aria-rowindex={ariaRowIndex(rowEntry.index)}
									aria-selected={isSelectedRow(rowEntry.index) ? "true" : undefined}
								>
									@for (let entry of $state.columnEntries) {
										@key = entry.column.key
										<DataGridCell
											column={entry.column}
											rowIndex={rowEntry.index}
											colIndex={entry.index}
										>
											<slot
												row={rowEntry.row}
												column={entry.column}
												value={cellValue(rowEntry.row, entry.column)}
											>
												{cellValue(rowEntry.row, entry.column)}
											</slot>
										</DataGridCell>
									}
								</tr>
							}
							@if (isVirtual()) {
								<tr aria-hidden="true" class="torp-data-grid-spacer">
									<td
										colspan={$props.columns.length}
										style={`height:${Math.max(0, ($state.rows.length - win.endExclusive)) * getRowHeight()}px`}
									/>
								</tr>
							}
						}
					</tbody>
				</table>
				</div>
			} with {
				<div class="torp-data-grid-loading" role="status">
					<slot name="loading">Loading…</slot>
				</div>
			}
		} catch (err) {
			<div class="torp-data-grid-error" role="alert">
				<slot name="error">{err instanceof Error ? err.message : String(err)}</slot>
			</div>
		}
	}
}
