import type { ClassValue, StyleValue } from "@torpor/view";
import { type DataColumn, type DataGridContext, DataGridContextName } from "./DataGridTypes";

interface DataGridCellProps {
	/** An ID for the cell element */
	id?: string;
	/** Classes for the cell element */
	class?: ClassValue;
	/** Styles for the cell element */
	style?: StyleValue;
	/** The column this cell is in (for alignment) */
	column?: DataColumn;
	/** The cell's row position */
	rowIndex: number;
	/** The cell's column position */
	colIndex: number;
}

/**
 * One cell of a DataGrid's body, carrying the roving tabindex for keyboard
 * navigation. Cell content goes in the default slot.
 */
export default function DataGridCell($props: DataGridCellProps | undefined) {
	// Get stuff out of the DataGrid context
	const context = $context[DataGridContextName] as DataGridContext;
	if (!context) {
		throw new Error("DataGridCell must be contained within a DataGrid");
	}

	function getRowIndex(): number {
		return $props?.rowIndex ?? 0;
	}

	function getColIndex(): number {
		return $props?.colIndex ?? 0;
	}

	@render {
		<td
			{$props?.id}
			role="gridcell"
			class={[context.getAlignClass($props?.column?.align), $props?.class]}
			{$props?.style}
			data-cell={context.getCellId(getRowIndex(), getColIndex())}
			tabindex={context.isActiveCell(getRowIndex(), getColIndex()) ? 0 : -1}
		>
			<slot />
		</td>
	}
}
