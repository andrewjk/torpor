import type { ClassValue, StyleValue } from "@torpor/view";
import { type SegmentedControlContext, SegmentedControlContextName } from "./SegmentedControlTypes";

interface SegmentedItemProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The index of this item */
	index?: number;
	/** The value for this item */
	value?: string;
	/** If set to true, the user cannot interact with this item */
	disabled?: boolean;
}

/**
 * A segment in a SegmentedControl, one of which is always active.
 */
export default function SegmentedItem($props: SegmentedItemProps | undefined) {
	let button: HTMLButtonElement;

	// Get stuff out of the SegmentedControl context
	const context = $context[SegmentedControlContextName] as SegmentedControlContext;
	if (!context) {
		throw new Error("SegmentedItem must be contained within a SegmentedControl");
	}

	// Register this item with the parent SegmentedControl
	let $state = context.registerItem($props?.index, $props?.value, $props?.disabled);

	$run(() => {
		return () => {
			context.removeItem($state.index);
		};
	});

	// This function is called by the parent SegmentedControl to focus this item
	function setFocused() {
		button.focus();
	}
	$state.setFocused = setFocused;

	function getDisabled(): boolean {
		return $state.disabled || $state.parentDisabled;
	}

	function handleClick() {
		if (getDisabled()) return;
		context.triggerItem($state.value);
	}

	function handleKey(e: KeyboardEvent) {
		if (getDisabled()) return;
		context.handleItemKey($state.index, e);
	}

	@render {
		<button
			type="button"
			{$props?.id}
			class={["torp-segmented-item", $props?.class]}
			{$props?.style}
			role="radio"
			tabindex={$state.active ? 0 : -1}
			aria-checked={$state.active ? "true" : "false"}
			aria-disabled={getDisabled() ? "true" : undefined}
			data-state={$state.active ? "active" : "inactive"}
			onclick={handleClick}
			onkeydown={handleKey}
			&ref={button}
		>
			<slot />
		</button>
	}
}
