import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import {
	type FieldContext,
	FieldContextName,
	type FormContext,
	FormContextName,
} from "../Form/FormTypes";
import FormValues from "../Form/FormValues.torp";
import { defaultPalette, parseHex } from "../utils/colorUtils";
import createFormField from "../utils/formField";
import ColorPalette from "./ColorPalette.torp";

interface ColorPickerProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The selected color as "#rrggbb"; undefined if nothing is selected */
	value?: Bindable<string | undefined>;
	/** The colors offered in the palette */
	colors?: string[];
	/**
	 * If set to true, a text field for arbitrary hex values ("#ff8800") is
	 * shown below the palette
	 */
	showInput?: boolean;
	/** If set to true, the user cannot interact with this picker */
	disabled?: boolean;
	/** An accessible name for the picker */
	ariaLabel?: string;
	/** The name of the component's form data field */
	name?: string;
	/** Raised when the color has changed or been cleared */
	onchange?: (value: string | undefined) => void;
}

/**
 * A color input: a ColorPalette with an optional hex text field, sharing a
 * single bound value.
 *
 * ```
 * <ColorPicker name="accent" showInput &value={$state.accent} />
 * ```
 */
export default function ColorPicker($props: ColorPickerProps | undefined) {
	let hexInput: HTMLInputElement;

	// Wire up the enclosing Form and Field, if any
	const form = createFormField(
		$props?.name,
		$context[FormContextName] as FormContext | undefined,
		$context[FieldContextName] as FieldContext | undefined,
	);

	function getDisabled(): boolean {
		return $props?.disabled === true;
	}

	let $state = $watch({
		value: undefined as string | undefined,

		// Text while the hex input is being typed into; committed on blur or
		// Enter, invalid text reverting like NumberInput
		text: "",
		editing: false,
	});

	$bind($state, $props, "value");

	function handleSelect(value: string | undefined) {
		$state.text = value ?? "";
		form.handleInput();
		$props?.onchange?.(value);
	}

	function commit() {
		$state.editing = false;
		const next = parseHex($state.text);
		if ($state.text.trim() !== "" && !next) {
			// Not a color: revert to the last committed value
			$state.text = $state.value ?? "";
			return;
		}
		if (next !== $state.value) {
			$state.value = next;
			form.handleInput();
			$props?.onchange?.(next);
		}
		$state.text = $state.value ?? "";
	}

	function handleInput(e: Event) {
		const el = e.currentTarget as HTMLInputElement;
		$state.editing = true;
		$state.text = el.value;
	}

	function handleKey(e: KeyboardEvent) {
		if (e.key === "Enter") {
			e.preventDefault();
			commit();
		}
	}

	function handleChange() {
		commit();
	}

	// Keep the input's value in sync with the text; typing sets the
	// property directly, so an attribute alone would not update it
	function syncInput() {
		if (hexInput && !$state.editing && hexInput.value !== $state.text) {
			hexInput.value = $state.text;
		}
	}
	$run(() => {
		const text = $state.text;
		const editing = $state.editing;
		if (hexInput && !editing && hexInput.value !== text) {
			hexInput.value = text;
		}
	});
	$mount(() => syncInput());

	@render {
		<div class={["torp-color-picker", $props?.class]} {$props?.style}>
			<ColorPalette
				class="torp-color-picker-palette"
				colors={$props?.colors ?? defaultPalette}
				value={$state.value}
				disabled={getDisabled()}
				ariaLabel={$props?.ariaLabel}
				onchange={handleSelect}
			/>
			@if ($props?.showInput) {
				<input
					&ref={hexInput}
					type="text"
					class="torp-color-picker-input"
					spellcheck="false"
					placeholder="#rrggbb"
					aria-label={$props?.ariaLabel ? `${$props.ariaLabel} hex value` : "Hex value"}
					value={$state.editing ? $state.text : $state.value ?? ""}
					disabled={getDisabled()}
					oninput={handleInput}
					onchange={handleChange}
					onblur={handleChange}
					onkeydown={handleKey}
				/>
			}
		</div>

		<FormValues name={form.name} value={$state.value} />
	}
}
