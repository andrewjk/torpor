import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import {
	type FieldContext,
	FieldContextName,
	type FormContext,
	FormContextName,
} from "../Form/FormTypes";
import FormValues from "../Form/FormValues.torp";
import { defaultPalette } from "../utils/colorUtils";
import createFormField from "../utils/formField";
import ColorPalette from "./ColorPalette.torp";
import ColorPickerInput from "./ColorPickerInput.torp";
import { type ColorPickerContext, ColorPickerContextName } from "./ColorPickerTypes";

interface ColorPickerProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The selected color as "#rrggbb"; undefined if nothing is selected */
	value?: Bindable<string | undefined>;
	/** The colors offered in the palette */
	colors?: string[];
	/**
	 * If set to true, a text field for arbitrary hex values ("#ff8800") is
	 * shown below the palette
	 */
	showInput?: boolean;
	/** If set to true, the user cannot interact with this picker */
	disabled?: boolean;
	/** An accessible name for the picker */
	ariaLabel?: string;
	/** The name of the component's form data field */
	name?: string;
	/** Raised when the color has changed or been cleared */
	onchange?: (value: string | undefined) => void;
}

/**
 * A color input: a ColorPalette with an optional hex text field, sharing a
 * single bound value.
 *
 * ```
 * <ColorPicker name="accent" showInput &value={$state.accent} />
 * ```
 *
 * The structure of a ColorPicker is:
 *
 * ```
 * <ColorPicker>
 * 	<ColorPalette />
 * 	<ColorPickerInput />
 * </ColorPicker>
 * ```
 *
 * With no children, the palette and input are rendered automatically.
 */
export default function ColorPicker($props: ColorPickerProps | undefined) {
	// Wire up the enclosing Form and Field, if any
	const form = createFormField(
		$props?.name,
		$context[FormContextName] as FormContext | undefined,
		$context[FieldContextName] as FieldContext | undefined,
	);

	function getDisabled(): boolean {
		return $props?.disabled === true;
	}

	let $state = $watch({
		value: undefined as string | undefined,
	});

	$bind($state, $props, "value");

	function commitValue(next: string | undefined) {
		if (next !== $state.value) {
			$state.value = next;
			form.handleInput();
			$props?.onchange?.(next);
		}
	}

	function handleSelect(value: string | undefined) {
		commitValue(value);
	}

	// Set the context to pass down to the input
	let context: ColorPickerContext = {
		getDisabled,
		getValue: () => $state.value,
		getAriaLabel: () => $props?.ariaLabel,
		commitValue,
	};
	$context[ColorPickerContextName] = context;

	@render {
		<div class={["torp-color-picker", $props?.class]} {$props?.style}>
			<slot>
				<ColorPalette
					class="torp-color-picker-palette"
					colors={$props?.colors ?? defaultPalette}
					value={$state.value}
					disabled={getDisabled()}
					ariaLabel={$props?.ariaLabel}
					onchange={handleSelect}
				/>
				@if ($props?.showInput) {
					<ColorPickerInput />
				}
			</slot>
		</div>

		<FormValues name={form.name} value={$state.value} />
	}
}
