import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import {
	type FieldContext,
	FieldContextName,
	type FormContext,
	FormContextName,
} from "../Form/FormTypes";
import FormValues from "../Form/FormValues.torp";
import {
	type Color,
	type Hsv,
	hexToRgba,
	hsvToHex,
	rgbToHsv,
	withAlpha,
} from "../utils/colorUtils";
import createFormField from "../utils/formField";
import ColorPalette from "./ColorPalette.torp";
import ColorPickerAlpha from "./ColorPickerAlpha.torp";
import ColorPickerArea from "./ColorPickerArea.torp";
import ColorPickerEyedropper from "./ColorPickerEyedropper.torp";
import ColorPickerHue from "./ColorPickerHue.torp";
import ColorPickerInput from "./ColorPickerInput.torp";
import { type ColorPickerContext, ColorPickerContextName } from "./ColorPickerTypes";

interface ColorPickerProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The selected color as "#rrggbb"; undefined if nothing is selected */
	value?: Bindable<string | undefined>;
	/**
	 * The colors offered in the palette. Each entry is either a hex string or
	 * `{ value, name }`; names are used as the swatches' accessible names.
	 */
	colors?: Color[];
	/** The number of swatches per row, for up/down arrow movement (default 6) */
	columns?: number;
	/** If true, selecting the already-selected swatch clears the value */
	allowClear?: boolean;
	/**
	 * If set to true, a text field for arbitrary color values ("#ff8800",
	 * "rgb(255 136 0)", "hsl(32 100% 50%)") is shown below the palette
	 */
	showInput?: boolean;
	/** If set to true, a 2D saturation/brightness area is shown above the palette */
	showArea?: boolean;
	/** If set to true, a hue slider is shown above the palette */
	showHue?: boolean;
	/** If set to true, an alpha slider is shown above the palette */
	showAlpha?: boolean;
	/** If set to true, an eyedropper button is shown when the browser supports it */
	showEyedropper?: boolean;
	/** If set to true, the user cannot interact with this picker */
	disabled?: boolean;
	/** An accessible name for the picker */
	ariaLabel?: string;
	/** The name of the component's form data field */
	name?: string;
	/** Raised when the color has changed or been cleared */
	onchange?: (value: string | undefined) => void;
}

/**
 * A color input: a ColorPalette with optional saturation/brightness, hue
 * and alpha controls and a text field, sharing a single bound value.
 * Enable `showArea`, `showHue`, `showAlpha` and `showEyedropper` for the
 * full picker; by default it is just a swatch palette.
 *
 * Values are normalized hex colors, with an alpha channel when the color
 * isn't fully opaque ("#ff8800", "#ff880080").
 *
 * ```
 * <ColorPicker name="accent" showInput &value={$state.accent} />
 * ```
 *
 * The structure of a ColorPicker is:
 *
 * ```
 * <ColorPicker>
 * 	<ColorPalette />
 * 	<ColorPickerInput />
 * </ColorPicker>
 * ```
 *
 * With no children, the palette and input are rendered automatically.
 */
export default function ColorPicker($props: ColorPickerProps | undefined) {
	let root: HTMLElement;

	// Wire up the enclosing Form and Field, if any
	const form = createFormField(
		$props?.name,
		$context[FormContextName] as FormContext | undefined,
		$context[FieldContextName] as FieldContext | undefined,
	);

	// The palette and input inside are parts of this picker, not standalone
	// fields: hide the enclosing Field's context so they don't resolve its
	// name and each submit their own copy of the value
	$context[FieldContextName] = undefined;

	function getDisabled(): boolean {
		return $props?.disabled === true;
	}

	let $state = $watch({
		value: undefined as string | undefined,
		h: 0,
		s: 0,
		v: 0,
		a: 1,
	});

	$bind($state, $props, "value");

	// Keep the hue/saturation/value/alpha controls in sync with the value.
	// The hue is preserved for grays, which have no meaningful hue of their
	// own, so dragging into a gray doesn't snap the hue slider to red
	$run(() => {
		const value = $state.value;
		if (value === undefined) {
			$state.s = 0;
			$state.v = 0;
			$state.a = 1;
			return;
		}
		const rgba = hexToRgba(value);
		const hsv = rgbToHsv(rgba);
		if (hsv.s > 0 && hsv.v > 0) {
			$state.h = hsv.h;
		}
		$state.s = hsv.s;
		$state.v = hsv.v;
		$state.a = rgba.a;
	});

	function commitValue(next: string | undefined) {
		if (next !== $state.value) {
			$state.value = next;
			form.handleInput();
			$props?.onchange?.(next);
		}
	}

	function handleSelect(value: string | undefined) {
		commitValue(value);
	}

	function getHsv(): Hsv {
		return { h: $state.h, s: $state.s, v: $state.v };
	}

	function commitHsv(hsv: Hsv, alpha?: number) {
		commitValue(hsvToHex(hsv, alpha ?? $state.a));
	}

	function setAlpha(alpha: number) {
		commitValue(withAlpha($state.value ?? "#000000", alpha));
	}

	// Only blur when focus leaves the whole picker
	function handleFocusOut(e: FocusEvent) {
		if (!root.contains(e.relatedTarget as Node | null)) {
			form.handleBlur();
		}
	}

	// Set the context to pass down to the input
	let context: ColorPickerContext = {
		getDisabled,
		getValue: () => $state.value,
		getAriaLabel: () => $props?.ariaLabel,
		commitValue,
		getHsv,
		commitHsv,
		getAlpha: () => $state.a,
		setAlpha,
	};
	$context[ColorPickerContextName] = context;

	@render {
		<div
			{$props?.id}
			class={["torp-color-picker", $props?.class]}
			{$props?.style}
			role="group"
			aria-label={$props?.ariaLabel}
			aria-disabled={getDisabled() ? "true" : undefined}
			data-valid={form.valid ? "valid" : "invalid"}
			aria-describedby={form.messageId}
			onfocusout={handleFocusOut}
			&ref={root}
		>
			<slot>
				@if ($props?.showArea) {
					<ColorPickerArea />
				}
				@if ($props?.showHue) {
					<ColorPickerHue />
				}
				@if ($props?.showAlpha) {
					<ColorPickerAlpha />
				}
				@if ($props?.showEyedropper) {
					<ColorPickerEyedropper />
				}
				<ColorPalette
					class="torp-color-picker-palette"
					colors={$props?.colors}
					columns={$props?.columns}
					allowClear={$props?.allowClear}
					value={$state.value}
					disabled={getDisabled()}
					ariaLabel={$props?.ariaLabel}
					onchange={handleSelect}
				/>
				@if ($props?.showInput) {
					<ColorPickerInput />
				}
			</slot>
		</div>

		<FormValues name={form.name} value={$state.value} />
	}
}
