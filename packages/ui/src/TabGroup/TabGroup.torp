import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import { createItemGroup } from "../utils/createItemGroup";
import { type ItemState, type TabGroupContext, TabGroupContextName } from "./TabGroupTypes";

interface TabGroupProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The orientation of the tab buttons, which affects keyboard navigation */
	orientation?: "horizontal" | "vertical";
	/** How tabs are activated; if automatic they are shown on focus, if manual they must be clicked */
	activation?: "automatic" | "manual";
	/** The value of the active TabContent */
	value: Bindable<string | undefined>;
	/** If set to true, the user cannot interact with any items in the TabGroup */
	disabled?: boolean;
	/** Raised when the active item has changed */
	onchange?: (value: string | string[]) => void;
}

/**
 * A list of interactive headings coupled with layered sections of content that
 * enable users to reveal a single section of content at a time.
 *
 * See [the WAI ARIA guidelines for Tabs](https://www.w3.org/WAI/ARIA/apg/patterns/tabs/).
 *
 * The structure of a TabGroup is:
 *
 * ```
 * <TabGroup>
 * 	<TabList>
 * 		<TabHeader>
 * 			<TabTrigger />
 * 		</TabHeader>
 * 	</TabList>
 * 	<TabContent />
 * </TabGroup>
 * ```
 */
export default function TabGroup($props: TabGroupProps | undefined) {
	let $state = $watch({
		value: "",
	});

	$bind($state, $props, "value");

	const group = createItemGroup<ItemState>({
		state: $state,
		type: "single",
		selectedProperty: "active",
		allowDeselect: false,
		disabled: () => $props?.disabled,
	});

	// This is used to assign automatic indexes to items where needed
	let nextHeaderIndex = 0;
	let nextItemIndex = 0;

	// Set the context to pass down to headers and content, with functions for each item to call
	let context: TabGroupContext = {
		registerHeader,
		registerItem,
		removeItem: group.removeItem,
		triggerItem: group.toggleItem,
		handleHeaderKey,
		get orientation() {
			return $props?.orientation ?? "horizontal";
		},
		get activation() {
			return $props?.activation ?? "automatic";
		},
	};
	$context[TabGroupContextName] = context;

	// Dispatch the change event when the value changes
	$handle((first) => {
		const value = $props?.value;
		if (!first) $props?.onchange?.(value!);
	});

	// On mount, if no value was set, show the first tab content
	$mount(() => {
		if ($state.value === "" && group.itemStates.length) {
			$state.value = group.itemStates[0].value;
		}
	});

	function registerHeader(
		index: number | undefined,
		value: string | undefined,
		disabled: boolean | undefined,
	): ItemState {
		// If an index wasn't set for the header, set it automatically
		if (index === undefined) {
			index = nextHeaderIndex++;
		}

		// Get or add the ItemState at this index
		const itemState = getItemState(index, value, disabled);

		return itemState;
	}

	function registerItem(index: number | undefined, value: string | undefined): ItemState {
		// If an index wasn't set for the item, set it automatically
		if (index === undefined) {
			index = nextItemIndex++;
		}

		// Get or add the ItemState at this index
		const itemState = getItemState(index, value);

		return itemState;
	}

	function getItemState(index: number, value: string | undefined, disabled?: boolean): ItemState {
		// If we already have an item with this index, just return it
		const existing = group.itemStates.find((item) => item.index === index);
		if (existing) {
			return existing;
		}

		// If a value wasn't set for the item, set it to the index
		if (value === undefined) {
			value = index.toString();
		}

		// Add the item's state to the array; the group assigns the active and
		// parentDisabled states and places it at its index
		const newItemState: ItemState = $watch({
			index,
			value,
			active: false,
			headerId: "",
			contentId: "",
			disabled: $props?.disabled ?? disabled ?? false,
			parentDisabled: $props?.disabled ?? false,
			setFocused: () => {},
		});
		group.registerItem(newItemState);

		return newItemState;
	}

	function handleHeaderKey(headerIndex: number, e: KeyboardEvent) {
		const itemStates = group.itemStates;
		const orientation = $props?.orientation ?? "horizontal";
		switch (e.key) {
			case "ArrowLeft": {
				if (orientation === "horizontal") {
					for (let i = headerIndex - 1; i >= 0; i--) {
						if (!itemStates[i].disabled) {
							e.preventDefault();
							itemStates[i].setFocused();
							break;
						}
					}
				}
				break;
			}
			case "ArrowUp": {
				if (orientation === "vertical") {
					for (let i = headerIndex - 1; i >= 0; i--) {
						if (!itemStates[i].disabled) {
							e.preventDefault();
							itemStates[i].setFocused();
							break;
						}
					}
				}
				break;
			}
			case "ArrowRight": {
				if (orientation === "horizontal") {
					for (let i = headerIndex + 1; i < itemStates.length; i++) {
						if (!itemStates[i].disabled) {
							e.preventDefault();
							itemStates[i].setFocused();
							break;
						}
					}
				}
				break;
			}
			case "ArrowDown": {
				if (orientation === "vertical") {
					for (let i = headerIndex + 1; i < itemStates.length; i++) {
						if (!itemStates[i].disabled) {
							e.preventDefault();
							itemStates[i].setFocused();
							break;
						}
					}
				}
				break;
			}
			case "Home": {
				for (let i = 0; i < itemStates.length; i++) {
					if (!itemStates[i].disabled) {
						e.preventDefault();
						itemStates[i].setFocused();
						break;
					}
				}
				break;
			}
			case "End": {
				for (let i = itemStates.length - 1; i >= 0; i--) {
					if (!itemStates[i].disabled) {
						e.preventDefault();
						itemStates[i].setFocused();
						break;
					}
				}
				break;
			}
		}
	}

	@render {
		<div
			{$props?.id}
			class={["torp-tab-group", $props?.class]}
			{$props?.style}
			data-orientation={$props?.orientation}
		>
			<slot />
		</div>
	}
}
