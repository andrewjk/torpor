import type { ClassValue, StyleValue } from "@torpor/view";
import PopoutClickTrigger from "../utils/PopoutClickTrigger.torp";
import {
	type ContextualContext,
	ContextualContextName,
	type Point,
} from "./ContextualTypes";

interface ContextualTriggerProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
}

/**
 * The element that causes a Contextual to appear or disappear when
 * right-clicked.
 *
 * For hover activation, use ContextualHover instead -- hover surfaces need
 * an intent delay and an exit grace period that a right-click region
 * doesn't.
 */
export default function ContextualTrigger($props?: ContextualTriggerProps) {
	// Get stuff out of the ContextualContext
	const context = $context[ContextualContextName] as ContextualContext;
	if (!context) {
		throw new Error("ContextualTrigger must be contained within a Contextual");
	}
	const $state = context.state;

	function activate(node: HTMLElement, e: MouseEvent) {
		if ($state.position) {
			// Get the position relative to the element, so we can reposition on scroll
			const rect = node.getBoundingClientRect();
			const point: Point = {
				x: e.clientX - rect.left,
				y: e.clientY - rect.top,
			};
			$state.position = point;
		}
	}

	@render {
		<PopoutClickTrigger
			id={$props?.id}
			class={$props?.class ?? "torp-popover-trigger-contextual"}
			style={$props?.style}
			context={context}
			tag="div"
			event="contextmenu"
			onactivate={activate}
		>
			<slot />
		</PopoutClickTrigger>
	}
}
