import type { ClassValue, StyleValue } from "@torpor/view";
import hoverTrigger from "../mount/hoverTrigger";
import getId from "../utils/getId";
import { type ContextualContext, ContextualContextName } from "./ContextualTypes";

interface ContextualTriggerProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** Whether the popover is activated by click/press or by hover **/
	activation?: "press" | "hover";
}

/**
 * The element that causes a Contextual to appear or disappear when right-clicked.
 */
export default function ContextualTrigger($props: ContextualTriggerProps | undefined) {
	let defaultId = getId();
	let activation = $props?.activation ?? "press";

	// Get stuff out of the ContextualContext
	const context = $context[ContextualContextName] as ContextualContext;
	if (!context) {
		throw new Error("ContextualTrigger must be contained within a Contextual");
	}
	let $state = context.state;

	// Set the trigger ID so that it can be used with aria-labelledby
	$state.triggerId = $props?.id ?? defaultId;

	function handleContextualMenu(e: MouseEvent & { currentTarget: EventTarget & HTMLDivElement }) {
		if (activation !== "press") return;

		e.preventDefault();
		if ($state.position) {
			// Get the position relative to the element, so we can reposition on scroll
			const rect = e.currentTarget.getBoundingClientRect();
			const x = e.clientX - rect.left;
			const y = e.clientY - rect.top;
			$state.position = { x, y };
			//$state.position = { x: window.scrollX + e.clientX, y: window.scrollY + e.clientY };
		}
		$state.visible = !$state.visible;
	}

	function handleHover(node: HTMLElement, e: MouseEvent | TouchEvent) {
		if (activation !== "hover") return;

		if ($state.position) {
			// Get the position relative to the element, so we can reposition on scroll
			const rect = node.getBoundingClientRect();
			const point = e instanceof TouchEvent ? e.touches[0] : e;
			const x = (point?.clientX ?? 0) - rect.left;
			const y = (point?.clientY ?? 0) - rect.top;
			$state.position = { x, y };
			//$state.position = { x: window.scrollX + e.clientX, y: window.scrollY + e.clientY };
		}
		$state.visible = !$state.visible;
	}

	@render {
		<div
			id={$props?.id ?? defaultId}
			class={["torp-popover-trigger-contextual", $props?.class]}
			{$props?.style}
			aria-haspopup={$state.contentRole ?? "true"}
			aria-expanded={$state.visible ? "true" : "false"}
			aria-controls={$state.contentId}
			oncontextmenu={handleContextualMenu}
			onmount={(el) => hoverTrigger(el, { onHover: handleHover, onExit: handleHover })}
			&ref={context.anchorElement}
		>
			<slot />
		</div>
	}
}
