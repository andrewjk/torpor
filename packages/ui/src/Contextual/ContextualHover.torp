import type { ClassValue, StyleValue } from "@torpor/view";
import { createHoverReveal } from "../utils/hoverReveal";
import getId from "../utils/getId";
import {
	type ContextualContext,
	ContextualContextName,
} from "./ContextualTypes";

interface ContextualHoverProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** Milliseconds to wait before opening (default 500; 0 opens immediately) */
	hoverDelay?: number;
	/** Milliseconds to wait after the pointer or focus leaves before closing (default 300) */
	exitGrace?: number;
	/** Whether hovering and focusing are ignored */
	disabled?: boolean;
}

/**
 * An element that shows a Contextual while hovered at the pointer's
 * location, with proper hover semantics: an intent delay before opening
 * (so passing over the element doesn't flash a window), and an exit grace
 * period after leaving (so moving into the contextual content doesn't close
 * it).
 *
 * Focusing the element opens it immediately; blurring closes it. Use this
 * in place of ContextualTrigger:
 *
 * ```
 * <Contextual>
 * 	<ContextualHover>Anything can go here</ContextualHover>
 * 	<ContextualContent />
 * </Contextual>
 * ```
 */
export default function ContextualHover($props?: ContextualHoverProps) {
	let defaultId = getId();

	// Get stuff out of the ContextualContext
	const context = $context[ContextualContextName] as ContextualContext;
	if (!context) {
		throw new Error("ContextualHover must be contained within a Contextual");
	}
	const $state = context.state;

	// Set the trigger ID so that it can be used with aria-labelledby
	$state.triggerId = $props?.id ?? defaultId;

	let node: HTMLElement;

	function activate(e: MouseEvent | TouchEvent) {
		if ($state.position) {
			// Get the position relative to the element, so we can reposition on scroll
			const rect = node.getBoundingClientRect();
			const point = e instanceof TouchEvent ? e.touches[0] : e;
			$state.position = {
				x: (point?.clientX ?? 0) - rect.left,
				y: (point?.clientY ?? 0) - rect.top,
			};
		}
	}

	function setVisible(visible: boolean) {
		$state.visible = visible;
	}

	const hover = createHoverReveal({
		show: () => setVisible(true),
		hide: () => setVisible(false),
		isVisible: () => $state.visible,
		disabled: () => $props?.disabled === true,
		getContent: () => ($state.contentId ? document.getElementById($state.contentId) : undefined),
		hoverDelay: $props?.hoverDelay,
		exitGrace: $props?.exitGrace,
	});

	$run(() => {
		return () => hover.dispose();
	});

	function handleEnter() {
		activate({ clientX: node.offsetWidth / 2, clientY: node.offsetHeight / 2 } as MouseEvent);
		hover.handleEnter();
	}

	@render {
		<div
			id={$props?.id ?? defaultId}
			class={["torp-contextual-hover", $props?.class]}
			{$props?.style}
			tabindex="0"
			aria-haspopup={$state.contentRole ?? "true"}
			aria-expanded={$state.visible ? "true" : "false"}
			aria-controls={$state.contentId}
			onmouseenter={handleEnter}
			onmouseleave={(e: MouseEvent) => hover.handleLeave(e)}
			onfocus={() => hover.handleFocus()}
			onblur={(e: FocusEvent) => hover.handleBlur(e)}
			onmount={(el) => {
				node = el;
				context.anchorElement = el;
			}}
		>
			<slot />
		</div>
	}
}
