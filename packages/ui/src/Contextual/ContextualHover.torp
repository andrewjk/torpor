import type { ClassValue, StyleValue } from "@torpor/view";
import PopoverHover from "../Popover/PopoverHover.torp";

interface ContextualHoverProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** Milliseconds to wait before opening (default 500; 0 opens immediately) */
	hoverDelay?: number;
	/** Milliseconds to wait after the pointer or focus leaves before closing (default 300) */
	exitGrace?: number;
	/** Whether hovering and focusing are ignored */
	disabled?: boolean;
	/**
	 * How taps on touch screens open the contextual window (hover never
	 * fires on touch). "auto" (default): tapping the trigger's inert surface
	 * opens it, but tapping a control inside the trigger runs that control's
	 * action without opening. "open": any tap opens it. "ignore": taps never
	 * open it.
	 */
	touchBehavior?: "auto" | "open" | "ignore";
}

/**
 * An element that shows a Contextual while hovered at the pointer's
 * location. This is PopoverHover in contextual mode.
 *
 * ```
 * <Contextual>
 * 	<ContextualHover>Anything can go here</ContextualHover>
 * 	<ContextualContent />
 * </Contextual>
 * ```
 */
export default function ContextualHover($props?: ContextualHoverProps) {
	@render {
		<PopoverHover
			id={$props?.id}
			class={["torp-contextual-hover", $props?.class]}
			style={$props?.style}
			hoverDelay={$props?.hoverDelay}
			exitGrace={$props?.exitGrace}
			disabled={$props?.disabled}
			touchBehavior={$props?.touchBehavior}
		>
			<slot />
		</PopoverHover>
	}
}
