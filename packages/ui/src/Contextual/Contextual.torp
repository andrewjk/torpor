import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import Popover from "../Popover/Popover.torp";
import type { Point } from "../Popover/PopoverTypes";

interface ContextualProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** Whether the contextual is modal */
	modal?: boolean;
	/** Whether the contextual is visible */
	visible: Bindable<boolean | undefined>;
	/** The element to anchor this contextual to, as an alternative to supplying a ContextualTrigger */
	anchor?: HTMLElement;
	/** The position to display this contextual at */
	position?: Point;
	/** Raised when the contextual has opened */
	onopen?: () => void;
	/** Raised when the contextual has closed */
	onclose?: (result: any) => void;
}

/**
 * A contextual window that is shown to the user at the cursor's location.
 *
 * Contextual is Popover in contextual mode: the same root, trigger and
 * content machinery, positioned at a point instead of at a side.
 *
 * The structure of a Contextual is:
 *
 * ```
 * <Contextual>
 * 	<ContextualTrigger /> (optional)
 * 	<ContextualContent />
 * </Contextual>
 * ```
 */
export default function Contextual($props: ContextualProps | undefined) {
	// Forward the visible binding through to the Popover
	let $state = $watch({
		visible: $props?.visible as boolean | undefined,
	});
	$bind($state, $props, "visible");

	@render {
		<Popover
			{$props?.id}
			class={$props?.class}
			{$props?.style}
			contextual
			modal={$props?.modal}
			&visible={$state.visible}
			anchor={$props?.anchor}
			position={$props?.position}
			onopen={$props?.onopen}
			onclose={$props?.onclose}
		>
			<slot />
		</Popover>
	}
}
