import { type Bindable, type ClassValue, type StyleValue } from "@torpor/view";
import {
	type FieldContext,
	FieldContextName,
	type FormContext,
	FormContextName,
} from "../Form/FormTypes";
import { formatDate } from "../utils/dateUtils";
import { addDocumentEvent, removeDocumentEvent } from "../utils/documentEvents";
import getId from "../utils/getId";
import createFormField from "../utils/formField";
import DatePickerContent from "./DatePickerContent.torp";
import DatePickerTrigger from "./DatePickerTrigger.torp";
import { type DatePickerContext, DatePickerContextName } from "./DatePickerTypes";

interface DatePickerProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The name of the date picker's form data field */
	name?: string;
	/** The selected date */
	value?: Bindable<Date | undefined>;
	/** Text to display when the value is empty */
	placeholder?: string;
	/** The format for the displayed date (e.g. "d MMM yyyy") */
	dateFormat?: string;
	/** If set to true, the user cannot interact with this date picker */
	disabled?: boolean;
	/** An accessible name for the trigger button */
	ariaLabel?: string;
	/** Raised when the value has changed */
	onchange?: (value: Date) => void;
}

/**
 * An input for selecting a date from a calendar popout.
 *
 * The structure of a DatePicker is a trigger button that displays the
 * selected date, with a selectable Calendar in a popout:
 *
 * ```
 * <DatePicker>
 * 	<DatePickerTrigger />
 * 	<DatePickerContent />
 * </DatePicker>
 * ```
 *
 * With no children, the trigger and content are rendered automatically.
 */
export default function DatePicker($props: DatePickerProps | undefined) {
	let defaultId = getId();

	let content: HTMLDivElement | undefined;
	let closeOnClick = false;

	// Wire up the enclosing Form and Field, if any
	const form = createFormField(
		$props?.name,
		$context[FormContextName] as FormContext | undefined,
		$context[FieldContextName] as FieldContext | undefined,
	);

	function getDateFormat(): string {
		return $props?.dateFormat ?? "yyyy-MM-dd";
	}
	function getDisabled(): boolean {
		return $props?.disabled === true;
	}

	let $state = $watch({
		value: undefined as Date | undefined,
		visible: false,
		triggerId: "",
		contentId: "",
	});

	$bind($state, $props, "value");

	// Set default IDs so that the trigger can use aria-controls and the
	// content can be labelled by the trigger
	$run(() => {
		$state.triggerId = `${$props?.id ?? defaultId}-trigger`;
		$state.contentId = `${$props?.id ?? defaultId}-content`;
	});

	function displayText(): string {
		const value = $state.value;
		if (value) {
			return formatDate($unwrap(value), getDateFormat());
		}
		return $props?.placeholder || "-";
	}

	function toggle() {
		setVisible(!$state.visible);
	}

	// Set the context to pass down to the trigger and content
	let context: DatePickerContext = {
		getDisabled,
		getTriggerId: () => $state.triggerId,
		getContentId: () => $state.contentId,
		isVisible: () => $state.visible,
		toggle,
		getDisplayText: displayText,
		getAriaLabel: () => $props?.ariaLabel,
		inField: () => form.inField,
		valid: () => form.valid,
		messageId: () => form.messageId,
		handleBlur: () => form.handleBlur(),
		getValue: () => $state.value,
		selectDate: handleDate,
		close: handleClose,
		registerContent: (el) => {
			content = el;
		},
		unregisterContent: (el) => {
			if (content === el) {
				content = undefined;
			}
		},
	};
	$context[DatePickerContextName] = context;

	function setVisible(visible: boolean) {
		$state.visible = visible;
		if (visible) {
			// HACK: Because this may be shown with a click, we need to wait for
			// another mousedown before we close on click. Otherwise the click
			// immediately bubbles up to the document
			closeOnClick = false;
			addDocumentEvent("mousedown", handleDocumentMouseDown);
			addDocumentEvent("click", handleDocumentClick);
			focusCalendar();
		} else {
			removeDocumentEvent("mousedown", handleDocumentMouseDown);
			removeDocumentEvent("click", handleDocumentClick);
		}
	}

	function focusCalendar() {
		// Wait for the popout to be shown before focusing it
		setTimeout(() => {
			const grid = content?.querySelector(".torp-calendar-grid");
			if (grid instanceof HTMLElement && !getDisabled()) {
				grid.focus();
			}
		});
	}

	function handleDate(date: Date) {
		$state.value = new Date(date);
		$props?.onchange?.($state.value);
		form.handleInput();
		setVisible(false);
		focusTrigger();
	}

	function handleClose() {
		setVisible(false);
		focusTrigger();
	}

	function focusTrigger() {
		const trigger = document.getElementById($state.triggerId);
		if (trigger instanceof HTMLElement) {
			trigger.focus();
		}
	}

	function handleDocumentMouseDown() {
		closeOnClick = true;
	}

	function handleDocumentClick(e: MouseEvent) {
		if (closeOnClick && content && !content.contains(e.target as HTMLElement)) {
			e.preventDefault();
			setVisible(false);
		}
	}

	@render {
		<div
			{$props?.id}
			class={["torp-date-picker", getDisabled() ? "torp-date-picker-disabled" : undefined, $props?.class]}
			{$props?.style}
		>
			<slot>
				<DatePickerTrigger />
				<DatePickerContent />
			</slot>
		</div>

		@if (form.name) {
			<input type="hidden" name={form.name} value={$state.value ? formatDate($unwrap($state.value), "yyyy-MM-dd") : ""} />
		}
	}
}
