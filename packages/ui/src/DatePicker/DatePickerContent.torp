import type { ClassValue, StyleValue } from "@torpor/view";
import {
	Calendar,
	CalendarDay,
	CalendarDayHeader,
	CalendarGrid,
	CalendarGridHeader,
	CalendarHeader,
	CalendarHeaderTrigger,
} from "../Calendar/index";
import { type DatePickerContext, DatePickerContextName } from "./DatePickerTypes";
import DatePickerHeader from "./DatePickerHeader.torp";

interface DatePickerContentProps {
	/** An ID for the content element */
	id?: string;
	/** Classes for the content element */
	class?: ClassValue;
	/** Styles for the content element */
	style?: StyleValue;
}

/**
 * The popout of a DatePicker, containing the calendar the user selects a
 * date from.
 */
export default function DatePickerContent($props: DatePickerContentProps | undefined) {
	// Get stuff out of the DatePicker context
	const context = $context[DatePickerContextName] as DatePickerContext;
	if (!context) {
		throw new Error("DatePickerContent must be contained within a DatePicker");
	}

	@render {
		<div
			id={$props?.id ?? context.getContentId()}
			class={[
				"torp-date-picker-content",
				context.isVisible() ? undefined : "hidden",
				$props?.class,
			]}
			{$props?.style}
			aria-hidden={context.isVisible() ? undefined : "true"}
			onmount={(el) => {
				context.registerContent(el);
				return () => {
					context.unregisterContent(el);
				};
			}}
		>
			<slot>
				<Calendar
					selectable
					value={context.getValue()}
					onchange={context.selectDate}
					onclose={context.close}
				>
					<CalendarHeader>
						<CalendarHeaderTrigger type="previous" />
						<DatePickerHeader class="torp-date-picker-header" />
						<CalendarHeaderTrigger type="next" />
					</CalendarHeader>
					<CalendarGridHeader>
						@for (let day of $slot.days) {
							<CalendarDayHeader {day.dayName} {day.shortDayName} />
						}
					</CalendarGridHeader>
					<CalendarGrid>
						<CalendarDay date={$slot.day.date} muted={$slot.day.muted} active={$slot.day.active} />
					</CalendarGrid>
				</Calendar>
			</slot>
		</div>
	}

	@style {
		/* Visibility only -- see SelectBoxContent */
		.torp-date-picker-content.hidden {
			display: none;
		}
	}
}
