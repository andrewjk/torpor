import type { ClassValue, StyleValue } from "@torpor/view";
import Chart from "./Chart.torp";
import ChartArea from "./ChartArea.torp";
import ChartLines from "./ChartLines.torp";
import ChartXAxis from "./ChartXAxis.torp";
import ChartGrid from "./ChartGrid.torp";
import ChartYAxis from "./ChartYAxis.torp";
import type DataSeries from "./DataSeries";

interface AreaChartProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label describing the chart for screen readers */
	ariaLabel?: string;
	series: DataSeries[];
	height?: number;
	width?: number;
	xLabel?: string;
	yLabel?: string;
	maxValue?: number;
	stepCount?: number;
	stepValue?: number;
	showHLines?: boolean;
	showVLines?: boolean;
	/** The opacity of each area's fill (default 0.25) */
	opacity?: number;
	/** Stacks each series on top of the one below it */
	stacked?: boolean;
}

/**
 * An area chart: each series drawn as its line with the region under it
 * filled.
 *
 * This is a preset over the layered chart components:
 *
 * ```
 * <Chart>
 * 	<ChartYAxis />
 * 	<ChartGrid />
 * 	<ChartXAxis />
 * 	<ChartArea seriesIndex={0} />
 * 	<ChartLines seriesIndex={0} />
 * </Chart>
 * ```
 *
 * Compose those directly to customize -- e.g. a line for a second series
 * overlaid on the first's area, or `stacked` to pile the series up.
 */
export default function AreaChart($props: AreaChartProps) {
	@render {
		<Chart
			{$props?.id}
			class={["torp-area-chart", $props?.class]}
			{$props?.style}
			{$props?.ariaLabel}
			{$props?.series}
			{$props?.height}
			{$props?.width}
			{$props?.xLabel}
			{$props?.yLabel}
			{$props?.maxValue}
			{$props?.stepCount}
			{$props?.stepValue}
		>
			<ChartYAxis />
			<ChartGrid hLines={$props.showHLines === true} vLines={$props.showVLines === true} />
			<ChartXAxis />
			@for (let i of $props.series.map((_, i) => i)) {
				<ChartArea seriesIndex={i} opacity={$props.opacity} stacked={$props.stacked === true} />
				<ChartLines seriesIndex={i} stacked={$props.stacked === true} />
			}
		</Chart>
	}
}
