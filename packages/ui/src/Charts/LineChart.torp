import type { ClassValue, StyleValue } from "@torpor/view";
import Chart from "./Chart.torp";
import ChartXAxis from "./ChartXAxis.torp";
import ChartGrid from "./ChartGrid.torp";
import ChartLines from "./ChartLines.torp";
import ChartYAxis from "./ChartYAxis.torp";
import type DataSeries from "./DataSeries";

interface LineChartProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label describing the chart for screen readers */
	ariaLabel?: string;
	series: DataSeries[];
	height?: number;
	width?: number;
	xLabel?: string;
	yLabel?: string;
	maxValue?: number;
	stepCount?: number;
	stepValue?: number;
	showPoints?: boolean;
	showHLines?: boolean;
	showVLines?: boolean;
}

/**
 * A line chart: each series drawn as a connected line across the category
 * slots.
 *
 * This is a preset over the layered chart components:
 *
 * ```
 * <Chart>
 * 	<ChartValueAxis />
 * 	<ChartGrid />
 * 	<ChartXAxis />
 * 	<ChartLines seriesIndex={0} />
 * </Chart>
 * ```
 *
 * Compose those directly for overlaid layers (columns plus a line, multiple
 * separately-indexed lines etc).
 */
export default function LineChart($props: LineChartProps) {
	@render {
		<Chart
			{$props?.id}
			class={["torp-line-chart", $props?.class]}
			{$props?.style}
			{$props?.ariaLabel}
			{$props?.series}
			{$props?.height}
			{$props?.width}
			{$props?.xLabel}
			{$props?.yLabel}
			{$props?.maxValue}
			{$props?.stepCount}
			{$props?.stepValue}
		>
			<ChartYAxis />
			<ChartGrid hLines={$props.showHLines === true} vLines={$props.showVLines === true} />
			<ChartXAxis />
			@for (let i of $props.series.map((_, i) => i)) {
				<ChartLines seriesIndex={i} showPoints={$props.showPoints} />
			}
		</Chart>
	}
}
