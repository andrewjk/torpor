import type { ClassValue, StyleValue } from "@torpor/view";
import Chart from "./Chart.torp";
import ChartXAxis from "./ChartXAxis.torp";
import ChartColumns from "./ChartColumns.torp";
import ChartGrid from "./ChartGrid.torp";
import ChartYAxis from "./ChartYAxis.torp";
import type DataSeries from "./DataSeries";

interface ColumnChartProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label describing the chart for screen readers */
	ariaLabel?: string;
	series: DataSeries[];
	height?: number;
	width?: number;
	xLabel?: string;
	yLabel?: string;
	maxValue?: number;
	stepCount?: number;
	stepValue?: number;
	showHLines?: boolean;
	showVLines?: boolean;
}

/**
 * A column chart: each value in each series is drawn as a vertical column,
 * grouped under the series' label along the bottom axis.
 *
 * This is a preset over the layered chart components:
 *
 * ```
 * <Chart>
 * 	<ChartValueAxis />
 * 	<ChartGrid />
 * 	<ChartXAxis />
 * 	<ChartColumns />
 * </Chart>
 * ```
 *
 * Compose those directly to customize -- e.g. the value axis on the right,
 * or a line overlaid with ChartLines.
 */
export default function ColumnChart($props: ColumnChartProps) {
	@render {
		<Chart
			{$props?.id}
			class={["torp-column-chart", $props?.class]}
			{$props?.style}
			{$props?.ariaLabel}
			{$props?.series}
			{$props?.height}
			{$props?.width}
			{$props?.xLabel}
			{$props?.yLabel}
			{$props?.maxValue}
			{$props?.stepCount}
			{$props?.stepValue}
		>
			<ChartYAxis />
			<ChartGrid hLines={$props.showHLines === true} vLines={$props.showVLines === true} />
			<ChartXAxis />
			<ChartColumns />
		</Chart>
	}
}
