import type { ClassValue, StyleValue } from "@torpor/view";
import { chartColors } from "../utils/chartColors";
import { createChartLayout, measureChartText } from "../utils/chartLayout";
import type DataSeries from "./DataSeries";
import GridLines from "./GridLines.torp";
import XAxis from "./XAxis.torp";
import YAxis from "./YAxis.torp";

interface ColumnChartProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label describing the chart for screen readers */
	ariaLabel?: string;
	series: DataSeries[];
	height?: number;
	width?: number;
	xLabel?: string;
	yLabel?: string;
	maxValue?: number;
	stepCount?: number;
	stepValue?: number;
	hideXAxis?: boolean;
	hideYAxis?: boolean;
	showHLines?: boolean;
	showVLines?: boolean;
}

/**
 * A column chart: each value in each series is drawn as a vertical column.
 * Columns for a series are grouped under the series' label; when a series
 * has one value this looks like a bar chart, and with more values the
 * columns sit side by side within the label's slot.
 *
 * Use BarChart for one horizontal-positioned bar per series instead.
 */
export default function ColumnChart($props: ColumnChartProps) {
	let container: HTMLElement;
	let measurer: SVGTextElement;

	let $layout = createChartLayout({
		series: () => $props.series,
		height: () => $props.height,
		width: () => $props.width,
		xLabel: () => $props.xLabel,
		yLabel: () => $props.yLabel,
		maxValue: () => $props.maxValue,
		stepCount: () => $props.stepCount,
		stepValue: () => $props.stepValue,
		getContainer: () => container,
	});

	$mount(() => {
		// HACK: Wait until the measurer is really available
		setTimeout(() => measureChartText($layout, measurer), 1);
	});

	function columnWidth(count: number): number {
		return Math.max(1, ($layout.itemWidth / count) * 0.7);
	}

	function columnGap(count: number): number {
		return ($layout.itemWidth - columnWidth(count) * count) / (count + 1);
	}

	@render {
		<div {$props?.id} class={["torp-column-chart", $props?.class]} {$props?.style} &ref={container}>
			<svg
				role={$props?.ariaLabel ? "img" : undefined}
				aria-label={$props?.ariaLabel}
				version="1.1"
				width={$layout.calculatedWidth}
				height={$layout.calculatedHeight}
				xmlns="http://www.w3.org/2000/svg"
			>
				<g>
					<text &ref={measurer} x="-999" y="-999">8</text>

					@if ($layout.textWidth && $layout.textHeight) {
						<XAxis
							showAxis={!$props.hideXAxis}
							height={$layout.calculatedHeight}
							width={$layout.calculatedWidth}
							{$layout.itemWidth}
							{$layout.textHeight}
							xLabel={$props.xLabel ?? ""}
							stepLabels={[]}
							stepValue={0}
							{$layout.labels}
							{$layout.chartLeft}
							{$layout.chartBottom}
						/>
						<YAxis
							showAxis={!$props.hideYAxis}
							{$layout.valueHeight}
							{$layout.textHeight}
							yLabel={$props.yLabel ?? ""}
							{$layout.stepLabels}
							stepValue={$layout.stepValue}
							{$layout.chartLeft}
							{$layout.chartBottom}
						/>
						<GridLines
							{$props.showHLines}
							{$props.showVLines}
							width={$layout.calculatedWidth}
							{$layout.labels}
							xStepValue={0}
							xStepLabels={[]}
							yStepValue={$layout.stepValue}
							yStepLabels={$layout.stepLabels}
							{$layout.itemWidth}
							{$layout.valueHeight}
							{$layout.chartLeft}
							{$layout.chartBottom}
							type="bar"
						/>
						@for (let [i, series] of $props.series.entries()) {
							@for (let [j, value] of series.data.entries()) {
								<rect
									x={$layout.chartLeft +
										i * $layout.itemWidth +
										columnGap(series.data.length) +
										j * columnWidth(series.data.length)}
									y={$layout.chartBottom - Math.max(1, value * $layout.valueHeight)}
									width={columnWidth(series.data.length)}
									height={Math.max(1, value * $layout.valueHeight)}
									fill={series.color || chartColors[i % chartColors.length]}
								>
									<title>{`${[series.name, value].filter(Boolean).join("\n")}`}</title>
								</rect>
							}
						}
					}
				</g>
			</svg>
		</div>
	}
}
