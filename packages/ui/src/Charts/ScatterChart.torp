import type { ClassValue, StyleValue } from "@torpor/view";
import Chart from "./Chart.torp";
import ChartGrid from "./ChartGrid.torp";
import ChartScatter from "./ChartScatter.torp";
import ChartYAxis from "./ChartYAxis.torp";

interface Pair {
	x: number;
	y: number;
	/** An extra label for the point's tooltip */
	label?: string;
}

interface DataSeries {
	name: string;
	color?: string;
	data: Pair[];
}

interface ScatterChartProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label describing the chart for screen readers */
	ariaLabel?: string;
	series: DataSeries[];
	height?: number;
	width?: number;
	xLabel?: string;
	yLabel?: string;
	xStepCount?: number;
	xStepValue?: number;
	yStepCount?: number;
	yStepValue?: number;
	hideXAxis?: boolean;
	hideYAxis?: boolean;
	showHLines?: boolean;
	showVLines?: boolean;
}

function maxOf(series: DataSeries[], field: "x" | "y"): number {
	return series.reduce(
		(max, s) => Math.max(max, ...s.data.map((point) => point[field])),
		0,
	);
}

/**
 * A scatter chart preset: one point per `{ x, y }` pair, with a numeric x
 * axis and the standard value axis, laid out by Chart.
 */
export default function ScatterChart($props: ScatterChartProps) {
	// Chart's value scale works on plain numbers, so the points become the
	// y values and ChartScatter positions them by their x values
	function chartSeries() {
		return $props.series.map((series) => ({
			name: series.name,
			color: series.color,
			data: series.data.map((point) => point.y),
		}));
	}

	@render {
		<Chart
			{$props?.id}
			class={["torp-scatter-chart", $props?.class]}
			{$props?.style}
			ariaLabel={$props?.ariaLabel}
			series={chartSeries()}
			height={$props?.height}
			width={$props?.width}
			xLabel={$props?.xLabel}
			yLabel={$props?.yLabel}
			maxValue={maxOf($props.series, "y")}
			stepCount={$props?.yStepCount}
			stepValue={$props?.yStepValue}
		>
			<ChartYAxis showAxis={!$props?.hideYAxis} />
			<ChartGrid hLines={$props?.showHLines} />
			<ChartScatter
				series={$props.series}
				maxX={maxOf($props.series, "x")}
				stepCount={$props?.xStepCount}
				stepValue={$props?.xStepValue}
				showAxis={!$props?.hideXAxis}
				showVLines={$props?.showVLines}
				xLabel={$props?.xLabel}
			/>
		</Chart>
	}
}
