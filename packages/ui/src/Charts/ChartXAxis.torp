import { type ChartContext, ChartContextName } from "./ChartTypes";

interface ChartXAxisProps {
	/** Whether to draw the axis line itself (default true) */
	showAxis?: boolean;
	/** An axis title, overriding the Chart's x label */
	label?: string;
}

/**
 * The x axis for a chart. For vertical marks (columns, lines) it runs along
 * the bottom with each series' label centered under its slot; for
 * horizontal marks (bars) it becomes the value scale, with a tick for each
 * step along the bottom.
 *
 * Adding it to a Chart reserves a strip along the bottom for its labels
 * (and its title, when there is one): marks and other layers draw only in
 * the space left over.
 */
export default function ChartXAxis($props?: ChartXAxisProps) {
	const context = $context[ChartContextName] as ChartContext;
	if (!context) {
		throw new Error("ChartXAxis must be contained within a Chart");
	}
	const { layout, xLabel, horizontal, vertical, linear } = context;

	function showAxis(): boolean {
		return $props?.showAxis !== false;
	}

	function title(): string {
		if ($props?.label !== undefined) return $props.label;
		return xLabel();
	}

	// Reserve a strip along the bottom: one row for the labels, plus one
	// more for the title when there is one
	$run(() => {
		const size = layout.textHeight * (title() ? 2 : 1);
		layout.reserve("xaxis", "bottom", size);
		return () => layout.release("xaxis");
	});

	// The top edge of the strip reserved by this axis, where the plot ends
	function plotBottom(): number {
		return layout.plotY + layout.plotHeight;
	}

	function unitWidth(): number {
		return layout.plotWidth / Math.max(1, layout.maxValue);
	}

	function tickX(i: number): number {
		return layout.plotX + i * layout.stepValue * unitWidth();
	}

	// Labels hang just under the axis line, with a small buffer, at the top
	// of the strip; the title sits at the bottom of the strip, under the
	// labels
	function tickY(): number {
		return plotBottom() + layout.textHeight * (2 / 3) + 4;
	}

	function titleY(): number {
		return plotBottom() + layout.textHeight * 2;
	}

	// The x of label i. Charts with slot marks (columns) center each label
	// in its slot; charts with only point marks (lines, areas, points)
	// spread the labels across the plot, matching where the marks are
	function labelX(i: number): number {
		if (horizontal()) {
			return tickX(i);
		}
		const count = layout.labels.length;
		if (linear() && !vertical()) {
			if (count <= 1) {
				return layout.plotX + layout.plotWidth / 2;
			}
			return layout.plotX + (i / (count - 1)) * layout.plotWidth;
		}
		return layout.plotX + layout.itemWidth * i + layout.itemWidth / 2;
	}

	// Edge ticks and labels turn inward so they don't hang past the plot
	function tickAnchor(i: number, count: number): string {
		if (i === 0) return "start";
		if (i === count - 1) return "end";
		return "middle";
	}

	function labelAnchor(i: number): string {
		if (horizontal()) {
			return tickAnchor(i, layout.stepLabels.length);
		}
		const count = layout.labels.length;
		if (linear() && !vertical() && count > 1) {
			return tickAnchor(i, count);
		}
		return "middle";
	}

	@render {
		<svg>
			@if (showAxis()) {
				<line x1={layout.plotX} y1={plotBottom() + 0.5} x2={layout.plotX + layout.plotWidth} y2={plotBottom() + 0.5} stroke="currentcolor" />
			}
			@if (!horizontal()) {
				@if (title()) {
					<text
						fill="currentcolor"
						text-anchor="middle"
						dominant-baseline="text-after-edge"
						x={layout.plotX + layout.plotWidth / 2}
						y={titleY()}
					>
						{title()}
					</text>
				}
				@for (let [i, label] of layout.labels.entries()) {
					<text
						fill="currentcolor"
						text-anchor={labelAnchor(i)}
						dominant-baseline="text-after-edge"
						x={labelX(i)}
						y={tickY()}
					>
						{label}
					</text>
				}
			} else {
				@for (let [i, label] of layout.stepLabels.entries()) {
					<text text-anchor={tickAnchor(i, layout.stepLabels.length)} dominant-baseline="text-after-edge" x={tickX(i)} y={tickY()}>
						{label}
					</text>
				}
			}
		</svg>
	}
}
