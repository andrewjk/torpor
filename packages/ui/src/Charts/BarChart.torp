import type { ClassValue, StyleValue } from "@torpor/view";
import Chart from "./Chart.torp";
import ChartBars from "./ChartBars.torp";
import ChartXAxis from "./ChartXAxis.torp";
import ChartGrid from "./ChartGrid.torp";
import ChartYAxis from "./ChartYAxis.torp";
import type DataSeries from "./DataSeries";

interface BarChartProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label describing the chart for screen readers */
	ariaLabel?: string;
	series: DataSeries[];
	height?: number;
	width?: number;
	xLabel?: string;
	yLabel?: string;
	maxValue?: number;
	stepCount?: number;
	stepValue?: number;
	showHLines?: boolean;
	showVLines?: boolean;
}

/**
 * A bar chart: one thick horizontal bar per series, drawn from the left
 * edge towards its first value, with category labels down the side and the
 * value scale along the bottom.
 *
 * This is a preset over the layered chart components:
 *
 * ```
 * <Chart>
 * 	<ChartYAxis />
 * 	<ChartGrid />
 * 	<ChartXAxis />
 * 	<ChartBars />
 * </Chart>
 * ```
 *
 * For a vertical column per value, use ColumnChart instead.
 */
export default function BarChart($props: BarChartProps) {
	@render {
		<Chart
			id={$props.id}
			class={["torp-bar-chart", $props.class]}
			style={$props.style}
			ariaLabel={$props.ariaLabel}
			series={$props.series}
			height={$props.height}
			width={$props.width}
			xLabel={$props.xLabel}
			yLabel={$props.yLabel}
			maxValue={$props.maxValue}
			stepCount={$props.stepCount}
			stepValue={$props.stepValue}
		>
			<ChartYAxis />
			<ChartGrid hLines={$props.showHLines === true} vLines={$props.showVLines === true} />
			<ChartXAxis />
			<ChartBars />
		</Chart>
	}
}
