import type { ClassValue, StyleValue } from "@torpor/view";
import { chartColors } from "../utils/chartColors";
import { createChartLayout, measureChartText, type ChartLayout } from "../utils/chartLayout";
import type DataSeries from "./DataSeries";
import { type ChartContext, ChartContextName } from "./ChartTypes";

interface ChartProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label describing the chart for screen readers */
	ariaLabel?: string;
	/** The series that layers draw from (layers reference them by index) */
	series: DataSeries[];
	/** Fixed height in pixels (default 200) */
	height?: number;
	/** Fixed width in pixels (default: fills the container, minimum 400) */
	width?: number;
	/** Label under the x axis, drawn by ChartXAxis */
	xLabel?: string;
	/** Label beside the y axis, drawn by ChartYAxis */
	yLabel?: string;
	/** The value at the top of the value axis, instead of the series' maximum */
	maxValue?: number;
	/** The number of steps between 0 and the maximum value (default 2) */
	stepCount?: number;
	/** The size of each step, instead of being calculated */
	stepValue?: number;
}

/**
 * A container for layered chart components. It measures its text, works out
 * the scales, and provides them to whatever axes, grid lines and marks are
 * slotted inside:
 *
 * ```
 * <Chart ariaLabel="Revenue" series={revenue}>
 * 	<ChartYAxis side="right" />
 * 	<ChartGrid />
 * 	<ChartXAxis />
 * 	<ChartColumns />
 * 	<ChartLines seriesIndex={1} showPoints />
 * </Chart>
 * ```
 *
 * Layers **reserve space** through the Chart's layout: adding a ChartXAxis
 * claims a strip along the bottom, a ChartYAxis claims a strip on its side,
 * a ChartLegend claims a strip for itself, and so on. The plot area is
 * whatever space is left over, and the mark layers -- columns, bars, lines,
 * areas, points -- draw only into that, overlapping each other freely. A
 * Chart with no axes uses the whole svg; take one away and the marks grow
 * into the space it gives back.
 *
 * Layers can be mixed freely -- columns with a line overlaid, an axis on
 * either side, only a y axis with no x axis -- so a preset like LineChart is
 * just one such combination.
 *
 * See also the ready-made presets: AreaChart, BarChart, ColumnChart,
 * LineChart, ScatterChart.
 */
export default function Chart($props: ChartProps | undefined) {
	let container: HTMLElement;
	let measurer: SVGTextElement;

	const $layout = createChartLayout({
		series: () => $props?.series ?? [],
		height: () => $props?.height,
		width: () => $props?.width,
		maxValue: () => $props?.maxValue,
		stepCount: () => $props?.stepCount,
		stepValue: () => $props?.stepValue,
		getContainer: () => container,
	});

	$onmount(() => {
		// HACK: Wait until the measurer is really available
		setTimeout(() => measureChartText($layout, measurer), 1);
	});

	function colorAt(i: number): string {
		const series = $props?.series[i];
		return series?.color || chartColors[i % chartColors.length];
	}

	let $chartState = $watch({
		horizontal: false,
	});

	const context: ChartContext = {
		layout: $layout as unknown as ChartLayout,
		series: () => $props?.series ?? [],
		xLabel: () => $props?.xLabel ?? "",
		yLabel: () => $props?.yLabel ?? "",
		horizontal: () => $chartState.horizontal,
		registerMark: (orientation) => {
			if (orientation === "horizontal") {
				$chartState.horizontal = true;
			}
		},
		registerMax: (id, value) => {
			$layout.announceMax(id, value);
		},
		colorAt,
	};
	$context[ChartContextName] = context;

	@render {
		<div {$props?.id} class={["torp-chart", $props?.class]} {$props?.style} &ref={container}>
			<svg
				role={$props?.ariaLabel ? "img" : undefined}
				aria-label={$props?.ariaLabel}
				version="1.1"
				width={$layout.calculatedWidth}
				height={$layout.calculatedHeight}
			>
				<g>
					<text &ref={measurer} x="-999" y="-999">8</text>

					@if ($layout.textWidth && $layout.textHeight) {
						<slot />
					}
				</g>
			</svg>
		</div>
	}
}
