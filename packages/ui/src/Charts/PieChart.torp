import type { ClassValue, StyleValue } from "@torpor/view";
import { chartColors } from "../utils/chartColors";

interface PieData {
	name: string;
	value: number;
	/** The color to draw the slice with (default: the next palette color) */
	color?: string;
}

interface SegmentData {
	name: string;
	value: number;
	color?: string;
	path: string;
	/** The angle the slice spans, in degrees */
	angle: number;
	/** The angle the slice starts at, in degrees */
	startAngle: number;
}

interface PieChartProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label describing the chart for screen readers */
	ariaLabel?: string;
	data: PieData[];
	size?: number;
	radius?: number;
	cutout?: number;
	/** Draws each slice's name and value on the slice (skips thin slices) */
	labels?: boolean;
	/** Draws an inset key down the right of the chart, with the pie shifted left */
	legend?: boolean;
}

export default function PieChart($props: PieChartProps) {
	// Default values
	$props.size ||= 200;
	$props.radius ||= 50;

	// NOTE: Take two pixels off the radius so that the stroke doesn't go outside the border
	let $state = $watch({
		get radius() {
			// With a legend, keep the pie clear of the key
			const percent = $props.legend ? Math.min($props.radius!, 26) : $props.radius!;
			return (percent / 100) * $props.size! - 2;
		},
		get cutout() {
			return ($props.cutout! / 100) * $props.size! - 2;
		},
		get centerX() {
			return $props.legend ? $props.size! * 0.32 : $props.size! / 2;
		},
		get centerY() {
			return $props.size! / 2;
		},
		get segments() {
			return buildSegments(this.centerX, this.centerY, $props.data, this.radius, this.cutout);
		},
		get labels() {
			// The name and value at the middle of each slice, when the slice
			// is big enough to carry a label
			return this.segments
				.filter((s: SegmentData) => s.angle >= 20)
				.map((s: SegmentData) => {
					const r = this.radius * 0.62;
					const a = (Math.PI * (s.startAngle - s.angle / 2)) / 180;
					return {
						x: +(this.centerX + r * Math.sin(a)).toFixed(2),
						y: +(this.centerY + r * Math.cos(a)).toFixed(2),
						text: `${s.name} ${s.value}`,
					};
				});
		},
		get key() {
			return $props.data.map((d, i) => ({
				name: d.name,
				color: d.color || chartColors[i % chartColors.length],
			}));
		},
	});

	function buildSegments(
		centerX: number,
		centerY: number,
		theData: PieData[],
		theRadiusSize: number,
		theCutoutSize: number,
	): SegmentData[] {
		const segments = [];
		const totalValue = theData.reduce((a, b) => a + b.value, 0);

		// Start at the top of the chart, at 180 + 360 so that we don't have to
		// take wrapping angles into account
		let startAngle = 540;
		for (let i = 0; i < theData.length; i++) {
			// Subtract the angle to go clockwise
			const endAngle = startAngle - (theData[i].value / totalValue) * 360;
			const largeArc = startAngle - endAngle > 180 ? 1 : 0;
			segments.push({
				name: theData[i].name,
				value: theData[i].value,
				color: theData[i].color,
				startAngle,
				angle: startAngle - endAngle,
				path: buildPath(centerX, centerY, theRadiusSize, theCutoutSize, startAngle, endAngle, largeArc),
			});
			startAngle = endAngle;
		}
		return segments;
	}

	function buildPath(
		x: number,
		y: number,
		theRadiusSize: number,
		theCutoutSize: number,
		startAngle: number,
		endAngle: number,
		largeArc: number,
	): string {
		// HACK: Drawing an arc of 360 degrees doesn't work
		if (startAngle - endAngle === 360) {
			endAngle = 359.9999;
		}

		// Use some trig to find the points on the circumference at the start and end angles
		const startx = x + theRadiusSize * Math.sin((Math.PI * startAngle) / 180);
		const starty = y + theRadiusSize * Math.cos((Math.PI * startAngle) / 180);

		const endx = x + theRadiusSize * Math.sin((Math.PI * endAngle) / 180);
		const endy = y + theRadiusSize * Math.cos((Math.PI * endAngle) / 180);

		if ($props.cutout) {
			// Use some trig to find the points on the cutout at the start and end angles
			const cutoutstartx = x + theCutoutSize * Math.sin((Math.PI * startAngle) / 180);
			const cutoutstarty = y + theCutoutSize * Math.cos((Math.PI * startAngle) / 180);

			const cutoutendx = x + theCutoutSize * Math.sin((Math.PI * endAngle) / 180);
			const cutoutendy = y + theCutoutSize * Math.cos((Math.PI * endAngle) / 180);

			// Build the path - move to the cutout start, line to the start angle on the circumference,
			// arc to the end angle on the circumference, line to the cutout end, and then arc to the
			// cutout start
			const path = `
M${cutoutstartx},${cutoutstarty}
L${startx},${starty}
A${theRadiusSize},${theRadiusSize} 0 ${largeArc} 1 ${endx},${endy}
L${cutoutendx},${cutoutendy}
A${theCutoutSize},${theCutoutSize} 0 ${largeArc} 0 ${cutoutstartx},${cutoutstarty}`.trim();
			return path;
		} else {
			// Build the path - move to the origin, line to the start angle on the circumference,
			// arc to the end angle on the circumference, and then close back to the start
			const path = `M${x},${y} L${startx},${starty} A${theRadiusSize},${theRadiusSize} 0 ${largeArc} 1 ${endx},${endy} Z`;
			return path;
		}
	}

	function keyX(): number {
		return $props.size! * 0.58;
	}

	function keyRowY(i: number): number {
		const rowHeight = 18;
		return $props.size! / 2 - ($props.data.length * rowHeight) / 2 + i * rowHeight;
	}

	@render {
		<div {$props?.id} class={["torp-pie-chart", $props?.class]} {$props?.style}>
			<svg role={$props?.ariaLabel ? "img" : undefined} aria-label={$props?.ariaLabel} version="1.1" width={$props.size} height={$props.size}>
				<g>
					@for (let [i, segment] of $state.segments.entries()) {
						<path d={segment.path} fill={segment.color || chartColors[i % chartColors.length]}>
							<title>{`${segment.name}\n${segment.value}`}</title>
						</path>
					}
					@if ($props.labels) {
						@for (let label of $state.labels) {
							<text
								x={label.x}
								y={label.y}
								text-anchor="middle"
								dominant-baseline="middle"
								fill="white"
								style="paint-order: stroke; stroke: currentcolor; stroke-width: 3px; stroke-opacity: 0.2;"
							>
								{label.text}
							</text>
						}
					}
					@if ($props.legend) {
						@for (let [i, entry] of $state.key.entries()) {
							<rect x={keyX()} y={keyRowY(i) + 4} width={10} height={10} rx="2" fill={entry.color} />
							<text fill="currentcolor" dominant-baseline="middle" x={keyX() + 14} y={keyRowY(i) + 9}>
								{entry.name}
							</text>
						}
					}
				</g>
			</svg>
		</div>
	}
}
