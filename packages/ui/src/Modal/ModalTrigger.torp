import type { ClassValue, StyleValue } from "@torpor/view";
import PopoutClickTrigger from "../utils/PopoutClickTrigger.torp";
import { type ModalContext, ModalContextName } from "./ModalTypes";

interface ModalTriggerProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
}

/**
 * The button that opens a Modal when pressed.
 *
 * Modals require a deliberate act to open, so there is no hover activation.
 */
export default function ModalTrigger($props?: ModalTriggerProps) {
	// Get stuff out of the ModalContext
	const context = $context[ModalContextName] as ModalContext;
	if (!context) {
		throw new Error("ModalTrigger must be contained within a Modal");
	}

	@render {
		<PopoutClickTrigger
			id={$props?.id}
			class={$props?.class ?? "torp-modal-trigger"}
			style={$props?.style}
			context={context}
			tag="button"
			event="click"
		>
			<slot />
		</PopoutClickTrigger>
	}
}
