import type { ClassValue, StyleValue } from "@torpor/view";
import getId from "../utils/getId";
import { createPopoutContent } from "../utils/popoutContent";
import { type ModalContext, ModalContextName } from "./ModalTypes";

interface ModalContentProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
}

/**
 * The content that is displayed for a Modal when it is open.
 */
export default function ModalContent($props: ModalContentProps | undefined) {
	let defaultId = getId();

	// Get stuff out of the ModalContext
	const context = $context[ModalContextName] as ModalContext;
	if (!context) {
		throw new Error("ModalContent must be contained within a Modal");
	}
	let $state = context.state;

	// Set the content ID so that the trigger can use it with aria-controls
	$state.contentId = $props?.id ?? defaultId;

	const popout = createPopoutContent({
		getAnchor: () => undefined,
		getContent: () => div,
		close: (e) => context.handleClickOutside?.(e),
	});

	let div: HTMLDivElement;

	$run(() => {
		if (!$state.visible) {
			popout.hide();
		}
	});

	@render {
		@if ($state.visible) {
			<div
				id={$props?.id ?? defaultId}
				class={["torp-modal-content", $props?.class]}
				{$props?.style}
				&ref={div}
				onmount={() => popout.show()}
			>
				<slot />
			</div>
		}
	}
}
