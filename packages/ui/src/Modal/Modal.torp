import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import { type PopoutContext, PopoutContextName } from "../utils/PopoutTypes";
import { type ModalContext, ModalContextName, type ModalState } from "./ModalTypes";

interface ModalProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** Whether the modal is visible  */
	visible: Bindable<boolean | undefined>;
	/** Raised when the modal has opened */
	onopen?: () => void;
	/** Raised when the modal has closed */
	onclose?: (result: any) => void;
}

/**
 * A modal window that can be used to show rich content or obtain information from a user.
 *
 * See [the WAI ARIA guidelines for Modals](https://www.w3.org/WAI/ARIA/apg/patterns/dialogmodal/).
 *
 * The structure of a Modal is:
 *
 * ```
 * <Modal>
 * 	<ModalOverlay />
 * 	<ModalTrigger /> (optional)
 * 	<ModalContent />
 * </Modal>
 * ```
 */
export default function Modal($props: ModalProps | undefined) {
	let $state: ModalState = $watch({
		visible: false,
		contentId: undefined,
		triggerId: undefined,
		contentRole: undefined,
	});

	$bind($state, $props, "visible");

	let result: any;

	// Set the context to pass down to items
	let context: ModalContext = {
		handleButton,
		handleClickOutside,
		state: $state,
	};
	$context[ModalContextName] = context;

	// Set the context to pass down to items
	let popoutContext: PopoutContext = context;
	$context[PopoutContextName] = popoutContext;

	// Dispatch the open/close events when the modal is opened or closed
	$handle((first) => {
		const visible = $state.visible;
		if (first) return;
		if (visible) {
			$props?.onopen?.();
		} else {
			$props?.onclose?.(result);
		}
	});

	function handleButton(type: "confirm" | "cancel" | undefined, value?: any) {
		// Get the button's result
		switch (type) {
			case "confirm": {
				result = value ?? true;
				break;
			}
			case "cancel": {
				result = value ?? false;
				break;
			}
			default: {
				result = value;
				break;
			}
		}

		// Hide the modal
		$state.visible = false;
	}

	function handleClickOutside(e: MouseEvent | KeyboardEvent) {
		e.preventDefault();
		$state.visible = false;
	}

	@render {
		<div {$props?.id} class={["torp-modal", $props?.class]} {$props?.style}>
			<slot />
		</div>
	}
}
