import type { ClassValue, StyleValue } from "@torpor/view";
import { createHoverReveal } from "../utils/hoverReveal";
import getId from "../utils/getId";
import { type TooltipContext, TooltipContextName } from "./TooltipTypes";

interface TooltipTriggerProps {
	/** An ID for the trigger element */
	id?: string;
	/** Classes for the trigger element */
	class?: ClassValue;
	/** Styles for the trigger element */
	style?: StyleValue;
	/** Raised when the trigger is clicked */
	onclick?: (e: MouseEvent) => void;
}

/**
 * The element that shows a Tooltip on hover or focus. Rendered as a button,
 * so it is reachable by keyboard and works on touch screens.
 */
export default function TooltipTrigger($props: TooltipTriggerProps | undefined) {
	let defaultId = getId($context);

	// Get stuff out of the TooltipContext
	const context = $context[TooltipContextName] as TooltipContext;
	if (!context) {
		throw new Error("TooltipTrigger must be contained within a Tooltip");
	}
	const $state = context.state;

	// Set the trigger ID so that it can be used with aria-describedby
	$state.triggerId = $props?.id ?? defaultId;

	const hover = createHoverReveal({
		show: () => context.show(),
		hide: () => context.hide(),
		isVisible: () => $state.visible,
		disabled: context.getDisabled,
		getContent: () => ($state.contentId ? document.getElementById($state.contentId) : undefined),
		hoverDelay: context.getOpenDelay(),
		exitGrace: context.getCloseDelay() ?? 100,
	});

	$run(() => {
		return () => hover.dispose();
	});

	function handleKey(e: KeyboardEvent) {
		if (e.key === "Escape" && $state.visible) {
			e.preventDefault();
			context.hide();
		}
	}

	@render {
		<button
			type="button"
			id={$props?.id ?? defaultId}
			class={["torp-tooltip-trigger", $props?.class]}
			{$props?.style}
			aria-describedby={$state.contentId}
			onmouseenter={() => hover.handleEnter()}
			onmouseleave={(e: MouseEvent) => hover.handleLeave(e)}
			onpointerdown={(e: PointerEvent) => hover.handlePointerDown(e)}
			onfocus={() => hover.handleFocus()}
			onblur={(e: FocusEvent) => hover.handleBlur(e)}
			onkeydown={handleKey}
			onclick={(e: MouseEvent) => $props?.onclick?.(e)}
			onmount={(el: HTMLButtonElement) => {
				context.anchorElement = el;
				return () => {
					if (context.anchorElement === el) context.anchorElement = undefined;
				};
			}}
		>
			<slot />
		</button>
	}
}
