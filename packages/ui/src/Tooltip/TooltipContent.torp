import type { ClassValue, StyleValue } from "@torpor/view";
import getId from "../utils/getId";
import { createPopoutContent } from "../utils/popoutContent";
import { type TooltipContext, TooltipContextName } from "./TooltipTypes";

interface TooltipContentProps {
	/** An ID for the content element */
	id?: string;
	/** Classes for the content element */
	class?: ClassValue;
	/** Styles for the content element */
	style?: StyleValue;
	/** Where the tooltip is shown, relative to the trigger (default from the Tooltip) */
	side?: "top" | "right" | "bottom" | "left";
	/** How the tooltip is aligned, relative to the trigger (default from the Tooltip) */
	alignment?: "start" | "center" | "end";
}

/**
 * The hint displayed for a Tooltip while its trigger is hovered or focused.
 */
export default function TooltipContent($props: TooltipContentProps | undefined) {
	let defaultId = getId();
	let div: HTMLDivElement;

	// Get stuff out of the TooltipContext
	const context = $context[TooltipContextName] as TooltipContext;
	if (!context) {
		throw new Error("TooltipContent must be contained within a Tooltip");
	}
	const $state = context.state;

	// Set the content ID so that the trigger can reference it with aria-describedby
	$state.contentId = $props?.id ?? defaultId;

	const popout = createPopoutContent({
		getAnchor: () => context.anchorElement,
		getContent: () => div,
		close: () => context.hide(),
		side: $props?.side ?? context.getSide(),
		alignment: $props?.alignment ?? context.getAlignment(),
		closeOnEscape: true,
		ignoreAnchorClicks: true,
	});

	/**
	 * The content is fixed-positioned with viewport coordinates, so move it
	 * to the body where fixed descendants aren't captured.
	 */
	function portal(el: HTMLElement) {
		const root = el.ownerDocument.body;
		if (root !== null && el.parentNode !== root) {
			root.appendChild(el);
		}
	}

	$run(() => {
		if (!$state.visible) {
			popout.hide();
		}
		return () => popout.hide();
	});

	@render {
		@if ($state.visible) {
			<div
				id={$props?.id ?? defaultId}
				class={["torp-tooltip-content", $props?.class]}
				{$props?.style}
				role="tooltip"
				&ref={div}
				onmount={(el) => {
					portal(el);
					popout.show();
				}}
			>
				<slot />
			</div>
		}
	}
}
