import type { ClassValue, StyleValue } from "@torpor/view";
import { areDatesEqual } from "../utils/dateUtils";
import { type CalendarContext, CalendarContextName, type DayState } from "./CalendarTypes";

interface CalendarGridProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label for describing the grid to screen readers  */
	ariaLabel?: string | undefined;
}

/**
 * The grid of calendar days, wrapped in the row/gridcell structure that the
 * grid role requires: each week is a `role="row"` and each day is a
 * `role="gridcell"`.
 *
 * The days come from the Calendar's state as a flat list; they are grouped
 * into rows of seven here. The slot is rendered once per day, with the day
 * passed back to the slot content (`$slot.day`).
 */
export default function CalendarGrid($props: CalendarGridProps | undefined) {
	// Get stuff out of the Calendar context
	const context = $context[CalendarContextName] as CalendarContext;
	if (!context) {
		throw new Error("CalendarGrid must be contained within a Calendar");
	}
	const { handleKey, state: $state } = context;

	// Group the flat days list into rows of seven (one row per week)
	let $grid = $watch({
		get weeks(): DayState[][] {
			return $cache(() => {
				const days = $state.days;
				const weeks: DayState[][] = [];
				for (let i = 0; i < days.length; i += 7) {
					weeks.push(days.slice(i, i + 7));
				}
				return weeks;
			});
		},
	});

	// The active date is the selected date, so cells can be marked with
	// aria-selected (which is only valid on a gridcell, not on the day
	// component's button)
	function isSelected(day: DayState): boolean {
		return areDatesEqual(day.date, $state.activeDate);
	}

	// Focus the day with `class=active`
	function handleFocus(e: FocusEvent & { currentTarget: EventTarget & HTMLElement }) {
		const el = e.currentTarget.getElementsByClassName("active")[0];
		if (el && el.children[0] instanceof HTMLElement) {
			el.children[0].focus();
			e.preventDefault();
		}
	}

	@render {
		<div
			{$props?.id}
			class={["torp-calendar-grid", $props?.class]}
			{$props?.style}
			tabindex={context.selectable ? 0 : -1}
			onfocus={handleFocus}
			onkeydown={handleKey}
			role="grid"
			aria-label={$props?.ariaLabel ?? "Calendar"}
			aria-colcount="7"
			aria-readonly={!context.selectable ? "true" : undefined}
		>
			@for (let week of $grid.weeks) {
				<div role="row" class="torp-calendar-row">
					@for (let day of week) {
						@key = day.date
						<span
							role="gridcell"
							class="torp-calendar-cell"
							aria-selected={context.selectable ? (isSelected(day) ? "true" : "false") : undefined}
						>
							<slot {day} />
						</span>
					}
				</div>
			}
		</div>
	}

	@style {
		.torp-calendar-grid {
			display: grid;
		}
		.torp-calendar-row {
			display: grid;
			grid-template-columns: repeat(7, 1fr);
		}
		.torp-calendar-cell {
			display: grid;
		}
	}
}
