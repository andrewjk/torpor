import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import { type NavMenuPopoutContext, NavMenuPopoutContextName } from "./NavMenuTypes";

interface NavMenuPopoutProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** Whether the popout is visible */
	visible: Bindable<boolean | undefined>;
	/** Raised when the popout has opened */
	onopen?: () => void;
	/** Raised when the popout has closed */
	onclose?: (result: any) => void;
}

/**
 * A popout that is attached to a menu button and can be used to show a submenu.
 *
 * The structure of a NavMenuPopout is:
 *
 * ```
 * <NavMenuPopout>
 * 	<NavMenuPopoutTrigger />
 * 	<NavMenuPopoutContent />
 * </NavMenuPopout>
 * ```
 */
export default function NavMenuPopout($props: NavMenuPopoutProps | undefined) {
	let $state = $watch({
		visible: false,
	});

	$bind($state, $props, "visible");

	let result: any;

	// Set the context to pass down to items
	let context: NavMenuPopoutContext = {
		state: $state,
	};
	$context[NavMenuPopoutContextName] = context;

	// Dispatch the toggle event when the popout is opened or closed
	$handle((first) => {
		const visible = $state.visible;
		if (first) return;
		if (visible) {
			$props?.onopen?.();
		} else {
			$props?.onclose?.(result);
		}
	});

	function handleMouseLeave() {
		$state.visible = false;
	}

	@render {
		<div
			{$props?.id}
			class={["torp-nav-menu-popout", $props?.class]}
			{$props?.style}
			onmouseleave={handleMouseLeave}
		>
			<slot />
		</div>
	}
}
