import type { ClassValue, StyleValue } from "@torpor/view";
import SubmenuPopoutTrigger from "../utils/SubmenuPopoutTrigger.torp";
import { type NavMenuContext, NavMenuContextName } from "./NavMenuTypes";

interface NavMenuPopoutTriggerProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The delay before showing the popout, in milliseconds */
	hoverDelay?: number;
	/** Whether this button is disabled */
	disabled?: boolean;
}

/**
 * A button that is placed in a NavMenu and signals a response by a user.
 *
 */
export default function NavMenuPopoutTrigger($props: NavMenuPopoutTriggerProps | undefined) {
	// Get stuff out of the NavMenuContext
	const menuContext = $context[NavMenuContextName] as NavMenuContext;
	if (!menuContext) {
		throw new Error("NavMenuPopoutTrigger must be contained within a NavMenu");
	}
	const { registerItem, handleItemKey, handleItemFocus } = menuContext;

	@render {
		<SubmenuPopoutTrigger
			id={$props?.id}
			class={["torp-nav-menu-popout-button", $props?.class]}
			style={$props?.style}
			hoverDelay={$props?.hoverDelay}
			disabled={$props?.disabled}
			role="menuitem"
			tabindex="-1"
			openKey="ArrowRight"
			registerItem={registerItem}
			handleItemKey={handleItemKey}
			handleItemFocus={handleItemFocus}
		>
			<slot />
		</SubmenuPopoutTrigger>
	}
}
