import type { ClassValue, StyleValue } from "@torpor/view";
import { type SplitterContext, SplitterContextName } from "./SplitterTypes";

interface SplitterHandleProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An accessible name for the separator */
	ariaLabel?: string;
	/** If set to true, the user cannot interact with this handle */
	disabled?: boolean;
}

/**
 * The separator in a Splitter that a user can drag, or move with the
 * keyboard, to resize the panes on either side of it.
 *
 * See [the WAI ARIA guidelines for Window Splitters](https://www.w3.org/WAI/ARIA/apg/patterns/windowsplitter/).
 */
export default function SplitterHandle($props: SplitterHandleProps | undefined) {
	// Get stuff out of the Splitter context
	const context = $context[SplitterContextName] as SplitterContext;
	if (!context) {
		throw new Error("SplitterHandle must be contained within a Splitter");
	}

	function getDisabled(): boolean {
		return $props?.disabled === true || context.getDisabled();
	}

	let dragging = false;

	function removeDragListeners() {
		removeEventListener("mousemove", handleMouseMove);
		removeEventListener("mouseup", handleMouseUp);
	}

	// Convert a pointer position into a percentage of the container
	function valueFromPointer(e: { clientX: number; clientY: number }): number {
		const container = context.getContainer();
		if (!container) return context.getValue();
		const rect = container.getBoundingClientRect();
		const horizontal = context.getOrientation() === "horizontal";
		const pos = horizontal ? e.clientX - rect.left : e.clientY - rect.top;
		const size = horizontal ? rect.width : rect.height;
		if (!(size > 0)) return context.getValue();
		const ratio = Math.min(1, Math.max(0, pos / size));
		return ratio * 100;
	}

	function handleMouseDown(e: MouseEvent) {
		if (getDisabled()) return;
		e.preventDefault();
		dragging = true;
		context.setValue(valueFromPointer(e));
		addEventListener("mousemove", handleMouseMove);
		addEventListener("mouseup", handleMouseUp);
	}

	function handleMouseMove(e: MouseEvent) {
		if (!dragging || getDisabled()) return;
		context.setValue(valueFromPointer(e));
	}

	function handleMouseUp() {
		if (!dragging) return;
		dragging = false;
		removeDragListeners();
	}

	// Stop listening if the handle is unmounted mid-drag
	$onmount(() => {
		return () => removeDragListeners();
	});

	function handleKey(e: KeyboardEvent) {
		if (getDisabled()) return;
		const step = context.getStep();
		const vertical = context.getOrientation() === "vertical";

		switch (e.key) {
			case "ArrowRight": {
				if (!vertical) {
					e.preventDefault();
					context.setValue(context.getValue() + step);
				}
				break;
			}
			case "ArrowLeft": {
				if (!vertical) {
					e.preventDefault();
					context.setValue(context.getValue() - step);
				}
				break;
			}
			case "ArrowUp": {
				if (vertical) {
					e.preventDefault();
					context.setValue(context.getValue() + step);
				}
				break;
			}
			case "ArrowDown": {
				if (vertical) {
					e.preventDefault();
					context.setValue(context.getValue() - step);
				}
				break;
			}
			case "PageUp": {
				e.preventDefault();
				context.setValue(context.getValue() + step * 10);
				break;
			}
			case "PageDown": {
				e.preventDefault();
				context.setValue(context.getValue() - step * 10);
				break;
			}
			case "Home": {
				e.preventDefault();
				context.setValue(context.getMin());
				break;
			}
			case "End": {
				e.preventDefault();
				context.setValue(context.getMax());
				break;
			}
		}
	}

	@render {
		<div
			{$props?.id}
			class={["torp-splitter-handle", $props?.class]}
			{$props?.style}
			role="separator"
			tabindex={getDisabled() ? -1 : 0}
			aria-label={$props?.ariaLabel ?? "Resize"}
			aria-orientation={context.getOrientation()}
			aria-valuemin={Math.round(context.getMin())}
			aria-valuemax={Math.round(context.getMax())}
			aria-valuenow={Math.round(context.getValue())}
			aria-disabled={getDisabled() ? "true" : undefined}
			onmousedown={handleMouseDown}
			onkeydown={handleKey}
		/>
	}

	@style {
		/* Headless: behavior only, so the handle can be dragged on touch
		   devices. All appearance is up to the consuming theme */
		.torp-splitter-handle {
			touch-action: none;
		}
	}
}
