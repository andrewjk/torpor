import type { ClassValue, StyleValue } from "@torpor/view";
import { type SplitterContext, SplitterContextName } from "./SplitterTypes";

interface SplitterPaneProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
}

/**
 * A pane in a Splitter. When there is more than one pane, the first pane is
 * sized to the splitter's value and the others share what's left.
 */
export default function SplitterPane($props: SplitterPaneProps | undefined) {
	// Get stuff out of the Splitter context
	const context = $context[SplitterContextName] as SplitterContext;
	if (!context) {
		throw new Error("SplitterPane must be contained within a Splitter");
	}

	// Register this pane with the parent Splitter
	let $state = context.registerPane();

	$run(() => {
		return () => {
			context.removePane($state.index);
		};
	});

	// The primary (first) pane is sized to the value when there are other
	// panes to share the rest of the space with
	function getFlex(): string {
		if ($state.index === 0 && context.count() > 1) {
			return `0 0 ${context.getValue()}%;`;
		}
		return "1 1 0;";
	}

	@render {
		<div
			{$props?.id}
			class={["torp-splitter-pane", $props?.class]}
			{$props?.style}
			data-orientation={context.getOrientation()}
			style={`flex: ${getFlex()}`}
		>
			<slot />
		</div>
	}

	@style {
		/* Headless: min sizes only, so the panes can shrink below their
		   content. All other appearance is up to the consuming theme */
		.torp-splitter-pane {
			min-height: 0;
			min-width: 0;
			overflow: hidden;
		}
	}
}
