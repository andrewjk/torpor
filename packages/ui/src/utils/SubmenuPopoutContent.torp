import type { ClassValue, StyleValue } from "@torpor/view";
import getId from "./getId";
import { createPopoutContent } from "./popoutContent";
import { type PopoutContext, PopoutContextName } from "./PopoutTypes";

interface SubmenuPopoutContentProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** Where the popout will be shown, relative to the popout button */
	side?: "top" | "right" | "bottom" | "left";
	/** How the popout will be aligned, relative to the popout button */
	alignment?: "start" | "center" | "end";
	/** Whether pressing Escape closes the popout (default true) */
	closeOnEscape?: boolean;
	/** Only close on Escape when the focus is inside the content */
	escapeOnlyWhenFocused?: boolean;
	/** The ARIA role of the content element, e.g. "menu" */
	role?: string;
	/**
	 * The role of the popout's content, published so that triggers can use it
	 * for aria-haspopup
	 */
	contentRole?: string;
}

/**
 * The shared primitive behind MenuPopoutContent, MenuBarItemContent,
 * ToolBarPopoutContent and NavMenuPopoutContent: it positions the content
 * against the trigger, handles outside clicks, Escape and focus, and renders
 * the content when the popout is visible.
 */
export default function SubmenuPopoutContent($props: SubmenuPopoutContentProps | undefined) {
	const defaultId = getId();

	// Get stuff out of the PopoutContext
	const popoutContext = $context[PopoutContextName] as PopoutContext;
	if (!popoutContext) {
		throw new Error("SubmenuPopoutContent must be contained within a SubmenuPopout");
	}
	let $state = popoutContext.state;

	// Set the content ID so that triggers can use it with aria-controls
	$state.contentId = $props?.id ?? defaultId;

	// Set the content role so that triggers can use it with aria-haspopup
	$state.contentRole = $props?.contentRole ?? $state.contentRole;

	const popout = createPopoutContent({
		getAnchor: () => popoutContext.anchorElement,
		getContent: () => div,
		close: () => ($state.visible = false),
		side: $props?.side ?? "bottom",
		alignment: $props?.alignment ?? "start",
		closeOnEscape: $props?.closeOnEscape ?? true,
		escapeOnlyWhenFocused: $props?.escapeOnlyWhenFocused,
		focusFirstElement: () => popoutContext.focusFirstElement?.(),
		refocusAnchorOnHide: true,
	});

	let div: HTMLDivElement;

	$run(() => {
		if (!$state.visible) {
			popout.hide();
		}
	});

	@render {
		@if ($state.visible) {
			<div
				id={$props?.id ?? defaultId}
				class={$props?.class}
				{$props?.style}
				role={$props?.role}
				aria-labelledby={$props?.role ? $state.triggerId : undefined}
				&ref={div}
				onmount={() => popout.show()}
			>
				<slot />
			</div>
		}
	}
}
