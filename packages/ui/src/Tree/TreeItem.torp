import type { ClassValue, StyleValue } from "@torpor/view";
import type { Loader } from "../utils/loader";
import getId from "../utils/getId";
import {
	type ItemState,
	type TreeContext,
	TreeContextName,
	type TreeItemContext,
	TreeItemContextName,
	type TreeLoadRequest,
} from "./TreeTypes";
import TreeLoadedChildren from "./TreeLoadedChildren.torp";

interface TreeItemProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** A value for the item */
	value?: string;
	/**
	 * Declares that the item has children that are not slotted in. When a
	 * `load` function is available (this item's, or the tree's) they are
	 * loaded from the network when the item is first expanded.
	 */
	hasChildren?: boolean;
	/** If set to true, the user cannot interact with this TreeItem */
	disabled?: boolean;
	/**
	 * Reads this item's children from the network (or anywhere async),
	 * receiving `{ item }` (the item's value). Set alongside `hasChildren`;
	 * overrides the tree's `load` function for this item.
	 */
	load?: Loader<any, TreeLoadRequest>;
	/** Raised when this item is expanded or collapsed */
	onexpand?: (expanded: boolean) => void;
	/** Raised when this item is selected or deselected */
	onselect?: (selected: boolean) => void;
}

/**
 * An item in a Tree, which can contain nested TreeItems via TreeItemChildren.
 *
 * The structure of a TreeItem is:
 *
 * ```
 * <TreeItem>
 * 	<TreeItemContent>
 * 		<TreeItemTrigger />
 * 		<TreeItemLabel />
 * 	</TreeItemContent>
 * 	<TreeItemChildren>
 * 		<TreeItem />
 * 	</TreeItemChildren>
 * </TreeItem>
 * ```
 */
export default function TreeItem($props: TreeItemProps | undefined) {
	let defaultId = getId();

	const parentContext = $context[TreeItemContextName] as TreeItemContext;
	const level = parentContext ? parentContext.state.level + 1 : 0;

	let $state: ItemState = $watch({
		id: $props?.id ?? defaultId,
		index: -1,
		value: $props?.value ?? "",
		expanded: false,
		selected: false,
		disabled: $props?.disabled ?? false,
		parentDisabled: false,
		level,
		hasChildren: false,
		setFocused,
	});

	const context = $context[TreeContextName] as TreeContext;
	if (!context) {
		throw new Error("TreeItem must be contained within a Tree");
	}

	// Whether the item declares children that aren't slotted in and can be
	// loaded when expanded. TreeItemChildren sets `slottedChildren` itself.
	const declaredChildren = $props?.hasChildren === true;
	const slottedLoad = typeof $props?.load === "function" ? $props.load : undefined;
	let slottedChildren = false;

	function updateHasChildren() {
		if (declaredChildren || slottedChildren) {
			if (!$state.hasChildren) $state.hasChildren = true;
		} else if ($state.hasChildren) {
			$state.hasChildren = false;
		}
	}
	updateHasChildren();

	// The loader for this item's children: the item's own or the tree's
	const itemLoader = slottedLoad ?? (declaredChildren ? context.load : undefined);
	if (declaredChildren && !itemLoader) {
		throw new Error(
			"TreeItem: declaring `hasChildren` requires a `load` function on the item or on the tree",
		);
	}

	context.registerItem($state, $state.level);

	$run(() => {
		return () => {
			context.removeItem($state.index);
		};
	});

	$run(() => {
		const onexpand = $props?.onexpand;
		const expanded = $state.expanded;
		if (onexpand) {
			onexpand(expanded);
		}
	});

	$run(() => {
		const onselect = $props?.onselect;
		const selected = $state.selected;
		if (onselect) {
			onselect(selected);
		}
	});

	let focusLabel: (() => void) | undefined;

	function setFocused() {
		focusLabel?.();
	}

	let itemContext: TreeItemContext = {
		state: $state,
		setHasChildren: (hasChildren) => {
			slottedChildren = hasChildren;
			updateHasChildren();
		},
	};
	$context[TreeItemContextName] = itemContext;

	@render {
		<div
			{$state.id}
			class={["torp-tree-item", $props?.class]}
			{$props?.style}
			role="treeitem"
			aria-level={$state.level + 1}
			aria-expanded={$state.hasChildren ? ($state.expanded ? "true" : "false") : undefined}
			aria-selected={$state.selected ? "true" : "false"}
			aria-disabled={$state.disabled || $state.parentDisabled ? "true" : undefined}
			data-selected={$state.selected ? "selected" : undefined}
		>
			@// HACK: May be better to do this with CSS?
			@if ($state.level) {
				<div style="display: flex">
					<div class={["torp-tree-item", $props?.class, "spacer"]} />
					<div>
						<slot />
					</div>
				</div>
			} else {
				<div>
					<slot />
				</div>
			}
			@if (declaredChildren && itemLoader) {
				<TreeLoadedChildren itemState={$state} load={itemLoader} />
			}
		</div>
	}
}
