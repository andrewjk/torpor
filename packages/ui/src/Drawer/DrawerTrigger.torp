import type { ClassValue, StyleValue } from "@torpor/view";
import PopoutClickTrigger from "../utils/PopoutClickTrigger.torp";
import { type DrawerContext, DrawerContextName } from "./DrawerTypes";

interface DrawerTriggerProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
}

/**
 * The button that causes a Drawer to appear or disappear.
 */
export default function DrawerTrigger($props: DrawerTriggerProps | undefined) {
	// Get stuff out of the DrawerContext
	const context = $context[DrawerContextName] as DrawerContext;
	if (!context) {
		throw new Error("DrawerTrigger must be contained within a Drawer");
	}

	@render {
		<PopoutClickTrigger
			id={$props?.id}
			class={$props?.class ?? "torp-drawer-trigger"}
			style={$props?.style}
			context={context}
			tag="button"
			event="click"
		>
			<slot />
		</PopoutClickTrigger>
	}
}
