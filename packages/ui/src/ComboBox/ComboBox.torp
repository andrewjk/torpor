import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import { type PopoutContext, PopoutContextName } from "../utils/PopoutTypes";
import { type ComboBoxContext, ComboBoxContextName, type ComboBoxState } from "./ComboBoxTypes";

interface ComboBoxProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The name of the input's form data field */
	name?: string;
	/** The data value selected by the user */
	value: Bindable<any>;
	/** Text to display when the input value is empty */
	placeholder?: string;
	/** Whether the input's value is required */
	required?: boolean;
	/** Whether the popout is visible  */
	visible: Bindable<boolean | undefined>;
	/** A function to be called when the user selects a response */
	callback?: (value: any) => void;
	/** Raised when the popout is opened or closed */
	ontoggle?: (open: boolean) => void;
	/** Raised when the popout has opened */
	onopen?: () => void;
	/** Raised when the popout has closed */
	onclose?: (result: any) => void;
}

/**
 * An input box for selecting a value from a popout ListBox or Dialog.
 *
 * See [the WAI ARIA guidelines for ComboBoxes](https://www.w3.org/WAI/ARIA/apg/patterns/combobox/).
 *
 * The structure of a ComboBox is:
 *
 * ```
 * <ComboBox>
 * 	<ComboBoxInput />
 * 	<ComboBoxTrigger /> (optional)
 * 	<ComboBoxContent />
 * </ComboBox>
 * ```
 */
export default function ComboBox($props: ComboBoxProps | undefined) {
	let $state: ComboBoxState = $watch({
		visible: false,
		value: $props?.value,
	});

	$bind($state, $props, "visible", "value");

	let result: any;

	// Set the context to pass down to items
	let context: ComboBoxContext = {
		handleButton,
		handleClickOutside,
		placeholder: $props?.placeholder,
		required: $props?.required,
		ariaLabel: $props?.ariaLabel,
		name: $props?.name,
		state: $state,
	};
	$context[ComboBoxContextName] = context;

	// Set the context to pass down to items
	let popoutContext: PopoutContext = context;
	$context[PopoutContextName] = popoutContext;

	// Dispatch the toggle event when the popout is opened or closed
	$handle((first) => {
		const visible = $state.visible;
		if (first) return;
		$props?.ontoggle?.(visible);
		if (visible) {
			$props?.onopen?.();
		} else {
			$props?.onclose?.(result);
		}
	});

	function handleButton(type: "confirm" | "cancel" | undefined, value?: any) {
		// Get the button's result
		switch (type) {
			case "confirm": {
				result = value ?? true;
				break;
			}
			case "cancel": {
				result = value ?? false;
				break;
			}
			default: {
				result = value;
				break;
			}
		}

		// Update the value
		if (type !== "cancel") {
			$state.value = result;
		}

		// Hide the popout and focus input
		if (type === "confirm") {
			$state.visible = false;
			if (context.focusInput) {
				context.focusInput();
			}
		} else if (type === "cancel") {
			$state.visible = false;
		}

		// Call the callback
		if ($props?.callback) {
			$props?.callback(result);
		}
	}

	function handleClickOutside(e: MouseEvent) {
		e.preventDefault();
		$state.visible = false;
	}

	@render {
		<div {$props?.id} class={["torp-combo-box", $props?.class]} {$props?.style}>
			<slot />
		</div>
	}
}
