import type { ClassValue, StyleValue } from "@torpor/view";
import { type FormContext, FormContextName, type ValidationIssue } from "./FormTypes";
import { StandardSchemaV1 } from "./StandardSchemaV1";

interface FormProps<Data = Record<string, any>> {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/**
	 * The data to display in the form. Type it with the page's form result
	 * (e.g. `PageForm<typeof server>`) to get field name autocomplete
	 */
	data?: Data;
	/** Where to post the form's data **/
	action?: string;
	/** The action to use when submitting the form, which defaults to POST */
	method?: string;
	/**
	 * The form's encoding type e.g. `multipart/form-data` where there are file
	 * inputs. This will be automatically set unless overridden
	 */
	enctype?: string;
	/** The schema validator to use for this form */
	schema?: StandardSchemaV1;
	onsubmit?: (e: SubmitEvent) => boolean | void | Promise<boolean | void>;
}

/**
 * A form for submitting values.
 */
export default function Form<Data = Record<string, any>>($props: FormProps<Data> | undefined) {
	let $state = $watch({
		data: $props?.data ?? {},
		hasFile: false,
		issues: [] as ValidationIssue[],
		get valid() {
			return this.issues.length === 0;
		},
	});

	let submitted = false;

	// TODO: Load context from build with a submit method that submits to a form action

	// Set the context to pass down to Fields
	let context: FormContext = {
		schema: $props?.schema,
		state: $state,
		validate: handleValidate,
	};

	$context[FormContextName] = context;

	function applyIssues(result: StandardSchemaV1.Result<any> | undefined) {
		let issues: ValidationIssue[] = [];
		if (result?.issues) {
			for (let issue of result.issues) {
				if (issue.path) {
					// TODO: arrays with `[0]` etc
					issues.push({
						// @ts-ignore
						path: issue.path.map((p) => p.key ?? p).join("."),
						message: issue.message,
					});
				}
			}
		}
		$state.issues = issues;
	}

	/**
	 * Validates the form's data. Returns synchronously for synchronous schemas,
	 * or a promise that must be awaited for asynchronous ones.
	 */
	function validate(): void | Promise<void> {
		if (!$props?.schema) {
			return;
		}
		const result = $props.schema["~standard"].validate($props.data);
		if (result instanceof Promise) {
			return result.then(applyIssues);
		}
		applyIssues(result);
	}

	async function handleSubmit(e: SubmitEvent) {
		// Run validation. A synchronous schema is fully resolved by this point,
		// but an async one returns a promise -- and if we awaited it we'd only
		// call `preventDefault` after the browser had already started its own
		// submission (loading the action's response as a full page). So stop the
		// native submit up front and carry on once validation resolves.
		const validation = validate();
		if (validation instanceof Promise) {
			e.preventDefault();
			await validation;
			await finishSubmit(e, true);
		} else {
			await finishSubmit(e, false);
		}
	}

	async function finishSubmit(e: SubmitEvent, prePrevented: boolean) {
		// Validation has run: proceed if there are no errors
		let proceed = $state.valid;

		// Changing inputs from now on will cause revalidation
		submitted = true;

		// If validation failed, don't continue
		if (!proceed) {
			e.preventDefault();
			return false;
		}

		// Dispatch the submit event for the user to handle
		if ($props?.onsubmit) {
			let userSubmit = $props.onsubmit(e);
			if (userSubmit instanceof Promise) {
				userSubmit = await userSubmit;
			}
			// When the default was already prevented (async validation) we
			// can't use `defaultPrevented` to see if the handler opted out, so
			// only its return value counts
			proceed = userSubmit !== false && (prePrevented || !e.defaultPrevented);
		}

		// If the user handled the submit, don't continue
		if (!proceed) {
			e.preventDefault();
			return false;
		}

		// If there's a @torpor/build context, it handles the submission itself
		// (it posts the form and prevents the native submit)
		let buildContext = $context?.["TorporBuildContext"];
		if (buildContext?.onformsubmit) {
			let buildSubmit = buildContext.onformsubmit(e);
			if (buildSubmit instanceof Promise) {
				buildSubmit = await buildSubmit;
			}
			if (buildSubmit === false) {
				e.preventDefault();
			}
			return false;
		}

		// Nothing handled the submit. When validation was synchronous the
		// browser's own submission is still pending, so let it happen.
		// Otherwise it was already prevented, so submit the form ourselves.
		if (prePrevented) {
			(e.target as HTMLFormElement).submit();
		}
	}

	async function handleValidate() {
		if (submitted) {
			await validate();
		}
	}

	@render {
		<form
			{$props?.id}
			class={["torp-form", $props?.class]}
			{$props?.style}
			{$props?.action}
			method={$props?.method ?? "POST"}
			enctype={$props?.enctype ?? ($state.hasFile ? "multipart/form-data" : undefined)}
			onsubmit={handleSubmit}
			onmount={(e) => e.novalidate = true }
		>
			<slot />
		</form>
	}
}
