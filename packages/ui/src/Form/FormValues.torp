interface FormValuesProps {
	/** The name of the form data field(s) */
	name?: string;
	/** The value, or an array of values, to submit with the form */
	value?: any;
}

/**
 * Converts a form value to its text representation, without relying on
 * implicit primitive conversion (which fails for reactive proxies).
 */
function toText(value: any): string {
	if (value == null) return "";
	if (typeof value === "string") return value;
	if (typeof value === "number" || typeof value === "boolean") return String(value);
	return JSON.stringify(value);
}

/**
 * Renders hidden inputs for a component's value, so that it can take part
 * in native form submission. One input per entry when the value is an array.
 */
export default function FormValues($props: FormValuesProps | undefined) {
	@render {
		@if ($props?.name) {
			@if (Array.isArray($props.value)) {
				@for (let item of $props.value) {
					<input type="hidden" name={$props.name} value={toText(item)} />
				}
			} @else {
				<input type="hidden" name={$props.name} value={toText($props.value)} />
			}
		}
	}
}
