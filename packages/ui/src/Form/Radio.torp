import type { ClassValue, StyleValue } from "@torpor/view";
import getId from "../utils/getId";
import { type RadioGroupContext, RadioGroupContextName } from "./RadioGroupTypes";

interface RadioProps {
	/** An ID for the radio element */
	id?: string;
	/** Classes for the radio element */
	class?: ClassValue;
	/** Styles for the radio element */
	style?: StyleValue;
	/** The value submitted when this radio is selected */
	value?: any;
	/** If set to true, the user cannot interact with this radio */
	disabled?: boolean;
}

/**
 * One option in a RadioGroup. Its content is the radio's label.
 */
export default function Radio($props: RadioProps | undefined) {
	let defaultId = getId($context);
	let button: HTMLButtonElement;

	// Get stuff out of the RadioGroupContext
	const context = $context[RadioGroupContextName] as RadioGroupContext;
	if (!context) {
		throw new Error("Radio must be contained within a RadioGroup");
	}

	const id = $props?.id ?? defaultId;
	const $state = context.registerItem(undefined, $props?.value, $props?.disabled, id);
	$state.setFocused = () => button.focus();

	function getDisabled(): boolean {
		return context.getDisabled() || $state.disabled === true;
	}

	function select() {
		if (getDisabled()) return;
		context.select($state);
	}

	function handleKey(e: KeyboardEvent) {
		if (getDisabled()) return;
		context.handleKey($state.index!, e);
	}

	@render {
		<button
			type="button"
			id={id}
			class={["torp-radio", $props?.class]}
			{$props?.style}
			role="radio"
			tabindex={context.isTabStop($state.index!) ? 0 : -1}
			aria-checked={context.isSelected($state) ? "true" : "false"}
			aria-disabled={getDisabled() ? "true" : undefined}
			data-valid={context.getValid() ? "valid" : "invalid"}
			aria-describedby={context.getMessageId()}
			aria-invalid={context.inField() && !context.getValid() ? "true" : undefined}
			disabled={getDisabled()}
			onclick={select}
			onfocus={() => context.handleItemFocus($state.index!)}
			onkeydown={handleKey}
			&ref={button}
		>
			<slot />
		</button>
	}
}
