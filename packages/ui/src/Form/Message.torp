import type { ClassValue, StyleValue } from "@torpor/view";
import getId from "../utils/getId";
import { type FieldContext, FieldContextName } from "./FormTypes";

interface MessageProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
}

/**
 * A validation message to show when the contents of an input component have
 * problems that need to be fixed.
 */
export default function Message($props: MessageProps | undefined) {
	let defaultId = getId();

	// Get stuff out of the FieldContext
	const context = $context[FieldContextName] as FieldContext;
	if (!context) {
		throw new Error("Message must be contained within a Field");
	}
	const { state: $state } = context;

	// Set the message ID so that it can be used with aria-describedby in
	// input components
	$state.messageId = $props?.id ?? defaultId;

	@render {
		@if ($state.message) {
			<div
				id={$props?.id ?? defaultId}
				class={["torp-message", $props?.class]}
				{$props?.style}
				role="alert"
				data-valid={$state.valid ? "valid" : "invalid"}
			>
				<slot name="message">
					{$state.message}
				</slot>
			</div>
		}
	}
}
