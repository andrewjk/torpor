import type { ClassValue, StyleValue } from "@torpor/view";
import createFormField from "../utils/formField";
import getId from "../utils/getId";
import {
	type FieldContext,
	FieldContextName,
	type FormContext,
	FormContextName,
} from "./FormTypes";

interface SwitchProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The name of the toggle's form data field */
	name?: string;
	/** Whether the toggle is switched on */
	checked?: boolean;
	/** If set to true, the user cannot interact with this toggle */
	disabled?: boolean;
	/** An ARIA label for describing the toggle to screen readers when there is no associated label element */
	ariaLabel?: string;
	/** Raised on change */
	onchange?: (e: Event) => void;
	/** Raised on input */
	oninput?: (e: Event) => void;
}

/**
 * A switch input in a form, which can be turned on or off.
 *
 * Named after the switch role: unlike a ToggleButton, a switch has an
 * on/off state, not a pressed/not-pressed action. `Toggle` is kept as a
 * deprecated alias for the original name.
 *
 * See [the WAI ARIA guidelines for Switches](https://www.w3.org/WAI/ARIA/apg/patterns/switch/).
 */
export default function Switch($props: SwitchProps | undefined) {
	let defaultId = getId();

	// Get stuff out of the FormContext and FieldContext
	const formContext = $context[FormContextName] as FormContext | undefined;
	const fieldContext = $context[FieldContextName] as FieldContext | undefined;
	const form = createFormField(() => $props?.name, formContext, fieldContext);

	// Use the FieldContext's state, or create a new one
	let $state =
		fieldContext?.state ??
		$watch({
			inputId: $props?.id ?? defaultId,
			value: $props?.checked,
			errors: {} as Record<string, string>,
			valid: false,
			message: "",
		});

	// Binding
	$run(() => {
		if ($props !== undefined) {
			$props.checked = $state.value === true;
		}
	});

	// Set the input ID now that we know it and it will get linked with the associated label
	$state.inputId = $props?.id ?? defaultId;

	function handleInput(e: Event) {
		form.handleInput();
		if ($props?.oninput) {
			$props.oninput(e);
		}
	}

	function handleBlur() {
		form.handleBlur();
	}

	@render {
		<input
			id={$props?.id ?? defaultId}
			class={["torp-switch", "torp-toggle", $props?.class]}
			type="checkbox"
			role="switch"
			name={form.name}
			&checked={$state.value}
			aria-checked={$state.value === true ? "true" : "false"}
			disabled={$props?.disabled}
			aria-label={$props?.ariaLabel}
			data-valid={form.valid ? "valid" : "invalid"}
			aria-describedby={form.messageId}
			aria-invalid={form.inField && !form.valid ? "true" : undefined}
			{$props?.onchange}
			oninput={handleInput}
			onblur={handleBlur}
		/>
	}
}
