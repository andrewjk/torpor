import type { ClassValue, StyleValue } from "@torpor/view";
import { type PopoutContext, PopoutContextName } from "../utils/PopoutTypes";
import { focusItem as focusListItem } from "../utils/focusItem";
import { type ItemState, type MenuContext, MenuContextName } from "./MenuTypes";

interface MenuProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label for describing the menu to screen readers */
	ariaLabel?: string;
}

/**
 * A list of choices for the user, such as a set of actions or functions. A
 * menu is usually hidden until made visible by the user.
 *
 * See [the WAI ARIA guidelines for Menus](https://www.w3.org/WAI/ARIA/apg/patterns/menu/).
 *
 * The structure of a Menu is:
 *
 * ```
 * <Menu>
 * 	<MenuButton />
 * 	<MenuSeparator /> (optional)
 * 	<MenuGroup> (optional)
 * 		<MenuButton />
 * 	</MenuGroup>
 * </Menu>
 * ```
 */
export default function Menu($props: MenuProps | undefined) {
	// A collection containing the state and some functions for each item
	let itemStates: ItemState[] = [];
	let focusIndex = -1;

	// The text typed for type-ahead, which is reset after a short pause between key presses
	let searchText = "";
	let searchTimer: ReturnType<typeof setTimeout> | undefined;

	// Get stuff out of the PopoutContext
	const popoutContext = $context[PopoutContextName] as PopoutContext;
	if (!popoutContext) {
		throw new Error("Menu must be contained within a popout component");
	}
	const { handleButton, state } = popoutContext;

	const inPopout = state.contentRole === "menu";
	state.contentRole = "menu";

	// Set the focusFirstElement method in the PopoverContext(s) so that it can be called after everything has been shown
	popoutContext.focusFirstElement = focusFirstElement;
	popoutContext.focusLastElement = focusLastElement;

	// Set the context to pass down to items
	let context: MenuContext = {
		handleButton,
		handleItemFocus,
		handleItemKey,
		handlePopout,
		state,
		registerItem,
	};
	$context[MenuContextName] = context;

	function focusFirstElement() {
		if (itemStates.length) {
			itemStates[0].setFocused();
		}
	}

	function focusLastElement() {
		if (itemStates.length > 0) {
			itemStates.at(-1)!.setFocused();
		}
	}

	function registerItem(item: ItemState) {
		// Add the item's state to the array and return its index
		item.index = itemStates.length;
		itemStates.push(item);
		return { index: item.index };
	}

	function handleItemFocus(index: number) {
		focusIndex = index;
	}

	function handleItemKey(e: KeyboardEvent) {
		switch (e.key) {
			case "Escape": {
				e.preventDefault();
				state.visible = false;
				break;
			}
			case "ArrowDown": {
				e.preventDefault();
				focusItem("next");
				break;
			}
			case "ArrowUp": {
				e.preventDefault();
				focusItem("previous");
				break;
			}
			case "ArrowLeft": {
				if (popoutContext.navigateMenuBar) {
					// In a menu under a menubar item: move to the previous item and open its menu
					e.preventDefault();
					popoutContext.navigateMenuBar("previous");
				} else if (inPopout) {
					// TODO: This should be based on what side the menu shows on
					e.preventDefault();
					state.visible = false;
				}
				break;
			}
			case "ArrowRight": {
				if (popoutContext.navigateMenuBar) {
					// In a menu under a menubar item: move to the next item and open its menu
					e.preventDefault();
					popoutContext.navigateMenuBar("next");
				}
				break;
			}
			case "Home": {
				e.preventDefault();
				focusItem("start");
				break;
			}
			case "End": {
				e.preventDefault();
				focusItem("end");
				break;
			}
			case "Tab": {
				state.visible = false;
				break;
			}
			default: {
				// Type-ahead: typing a character focuses the next item whose label starts with it
				if (e.key.length === 1 && e.key !== " ") {
					e.preventDefault();
					search(e.key);
				}
				break;
			}
		}
	}

	function search(key: string) {
		const character = key.toLocaleLowerCase();
		if (searchTimer) {
			clearTimeout(searchTimer);
			// Typing the same character repeatedly cycles through the items that
			// start with it, instead of searching for a repeated-character string
			if (searchText.length !== 1 || character !== searchText) {
				searchText += character;
			}
		} else {
			searchText = character;
		}
		searchTimer = setTimeout(() => {
			searchTimer = undefined;
			searchText = "";
		}, 1000);

		// Focus the next item whose label starts with the search text, wrapping
		// around to the start and skipping disabled items
		for (let offset = 1; offset <= itemStates.length; offset++) {
			const item = itemStates[(focusIndex + offset) % itemStates.length];
			if (!item.disabled && item.text?.toLocaleLowerCase().startsWith(searchText)) {
				item.setFocused();
				break;
			}
		}
	}

	function focusItem(target: "start" | "previous" | "next" | "end") {
		focusIndex = focusListItem(itemStates, focusIndex, target);
	}

	function handlePopout(index: number) {
		// Hide all other submenus
		for (let item of itemStates) {
			if (item.index !== index) {
				item.setVisible?.(false);
			}
		}
	}

	@render {
		<div
			{$props?.id}
			class={["torp-menu", $props?.class]}
			{$props?.style}
			tabindex="-1"
			role="menu"
			aria-labelledby={state.triggerId}
			aria-label={$props?.ariaLabel}
			aria-orientation="vertical"
		>
			<slot />
		</div>
	}
}
