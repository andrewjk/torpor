import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import $handle from "../utils/$handle";
import { createItemGroup } from "../utils/createItemGroup";
import {
	type MenuRadioGroupContext,
	MenuRadioGroupContextName,
	type RadioGroupItemState,
} from "./MenuTypes";

interface MenuRadioGroupProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label for describing the menu to screen readers */
	ariaLabel?: string;
	/** The value of the checked MenuRadio */
	value: Bindable<string | undefined>;
	/** Raised when the checked item has changed */
	onchange?: (value: any) => void;
}

/**
 * A container for a logical group of menu RadioGroup items.
 */
export default function MenuRadioGroup($props: MenuRadioGroupProps | undefined) {
	let $state = $watch({
		value: $props?.value,
	});

	$bind($state, $props, "value");

	const group = createItemGroup<RadioGroupItemState>({
		state: $state,
		type: "single",
		selectedProperty: "checked",
		allowDeselect: false,
	});

	// Dispatch the change event when the value changes
	$handle((first) => {
		const value = $state.value;
		if (!first) $props?.onchange?.(value);
	});

	// Set the context to pass down to items
	let context: MenuRadioGroupContext = {
		registerItemInGroup: group.registerItem,
		toggleItem: group.toggleItem,
	};
	$context[MenuRadioGroupContextName] = context;

	@render {
		<div
			{$props?.id}
			class={["torp-menu-radio-group", $props?.class]}
			{$props?.style}
			role="group"
			aria-label={$props?.ariaLabel}
		>
			<slot />
		</div>
	}
}
