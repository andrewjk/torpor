import type { ClassValue, StyleValue } from "@torpor/view";
import { type PopoutContext, PopoutContextName } from "../utils/PopoutTypes";
import getId from "../utils/getId";
import { createHoverOpen } from "../utils/hoverOpen";
import { type ItemState, type MenuContext, MenuContextName } from "./MenuTypes";

interface MenuPopoutTriggerProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The delay before showing the popout, in milliseconds */
	hoverDelay?: number;
	/** Whether this button is disabled */
	disabled?: boolean;
}

/**
 * A button that is placed in a Menu or MenuGroup and signals a response by a user.
 */
export default function MenuPopoutTrigger($props: MenuPopoutTriggerProps | undefined) {
	let defaultId = getId();

	let defaultHoverDelay = 500;

	let button: HTMLButtonElement;

	// Get stuff out of the MenuContext
	const menuContext = $context[MenuContextName] as MenuContext;
	if (!menuContext) {
		throw new Error("MenuPopoutTrigger must be contained within a Menu");
	}
	const { registerItem, handleItemKey, handleItemFocus, handlePopout } = menuContext;

	// Get stuff out of the PopoutContext
	const popoutContext = $context[PopoutContextName] as PopoutContext;
	if (!popoutContext) {
		throw new Error("MenuPopoutTrigger must be contained within a MenuPopout");
	}
	const { state: $state } = popoutContext;

	// Set the trigger ID so that it can be used with aria-labelledby
	$state.triggerId = $props?.id ?? defaultId;

	// Register this item with the parent Menu and store the index
	const item: ItemState = { setFocused, setVisible, disabled: $props?.disabled };
	const { index } = registerItem(item);

	function setFocused() {
		button.focus();
	}

	function setVisible(visible: boolean) {
		$state.visible = visible;
	}

	// Store the anchor element, and the item's label for type-ahead
	function handleMount(el: HTMLButtonElement) {
		popoutContext.anchorElement = el;
		item.text = el.textContent.trim();
	}

	function handleClick() {
		handlePopout(index);
		$state.visible = !$state.visible;
	}

	function handlePopoutKey(e: KeyboardEvent) {
		switch (e.key) {
			case "ArrowRight":
				// TODO: This should be based on what side the menu shows on
				e.preventDefault();
				$state.visible = true;
				break;
			default:
				handleItemKey(e);
		}
	}

	const hoverOpen = createHoverOpen(
		() => ($state.visible = true),
		() => $props?.disabled ?? false,
		$props?.hoverDelay ?? defaultHoverDelay,
	);

	@render {
		<button
			id={$props?.id ?? defaultId}
			class={["torp-menu-popout-trigger", $props?.class]}
			{$props?.style}
			type="button"
			{$props?.disabled}
			role="menuitem"
			tabindex="-1"
			aria-haspopup={$state.contentRole ?? "true"}
			aria-expanded={$state.visible ? "true" : "false"}
			aria-controls={$state.contentId}
			aria-disabled={$props?.disabled ? "true" : undefined}
			onkeydown={handlePopoutKey}
			onclick={handleClick}
			onfocus={() => handleItemFocus(index)}
			onmouseenter={hoverOpen.handleMouseEnter}
			onmouseleave={hoverOpen.handleMouseLeave}
			onmousemove={hoverOpen.handleMouseMove}
			&ref={button}
			onmount={handleMount}
		>
			<slot />
		</button>
	}
}
