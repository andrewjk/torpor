import type { ClassValue, StyleValue } from "@torpor/view";
import { type ProgressContext, ProgressContextName } from "./ProgressTypes";

interface ProgressIndicatorProps {
	/** An ID for the indicator element */
	id?: string;
	/** Classes for the indicator element */
	class?: ClassValue;
	/** Styles for the indicator element */
	style?: StyleValue;
}

/**
 * The bar of a Progress that fills the track in proportion to the current
 * value, or animates while the progress is indeterminate.
 */
export default function ProgressIndicator($props: ProgressIndicatorProps | undefined) {
	// Get stuff out of the Progress context
	const context = $context[ProgressContextName] as ProgressContext;
	if (!context) {
		throw new Error("ProgressIndicator must be contained within a Progress");
	}

	function state(): "indeterminate" | "determinate" {
		return context.isIndeterminate() ? "indeterminate" : "determinate";
	}

	function widthStyle(): string | undefined {
		return context.isIndeterminate() ? undefined : `width: ${context.getPct()}%;`;
	}

	@render {
		<div
			{$props?.id}
			class={["torp-progress-bar", $props?.class]}
			style={[widthStyle(), $props?.style]}
			data-state={state()}
		/>
	}

	@style {
		/* Headless: layout only, so the bar fills the track proportionally.
		   All appearance is up to the consuming theme */
		.torp-progress-bar {
			position: absolute;
			inset: 0 auto 0 0;
		}
		.torp-progress-bar[data-state="indeterminate"] {
			width: 100%;
		}
	}
}
