import type { ClassValue, StyleValue } from "@torpor/view";
import { type ProgressContext, ProgressContextName } from "./ProgressTypes";
import ProgressIndicator from "./ProgressIndicator.torp";

interface ProgressProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The minimum value (default 0) */
	min?: number;
	/** The maximum value (default 100) */
	max?: number;
	/** The current value; omit it for an indeterminate progress bar */
	value?: number;
	/** A human-readable version of the current value, e.g. "3 of 10 files" */
	valuetext?: string;
	/** An accessible name for the progress bar */
	ariaLabel?: string;
}

/**
 * A progress bar that shows how far along an operation is, either with a
 * specific value or as indeterminate when the extent is unknown.
 *
 * See [the WAI ARIA guidelines for Progress Bars](https://www.w3.org/WAI/ARIA/apg/patterns/progressbar/).
 *
 * The structure of a Progress is:
 *
 * ```
 * <Progress>
 * 	<ProgressIndicator />
 * </Progress>
 * ```
 *
 * With no children, the indicator is rendered automatically.
 */
export default function Progress($props: ProgressProps | undefined) {
	function getMin(): number {
		return $props?.min ?? 0;
	}
	function getMax(): number {
		return $props?.max ?? 100;
	}
	function isIndeterminate(): boolean {
		return $props?.value == null;
	}

	// The clamped value that is reported to assistive tech
	function getValue(): number {
		return Math.min(getMax(), Math.max(getMin(), $props?.value ?? getMin()));
	}

	// The percentage of the range that the value represents (0..100)
	function getPct(): number {
		const min = getMin();
		const max = getMax();
		if (max <= min) return 0;
		return ((getValue() - min) / (max - min)) * 100;
	}

	// Set the context to pass down to the indicator
	let context: ProgressContext = {
		isIndeterminate,
		getPct,
	};
	$context[ProgressContextName] = context;

	@render {
		<div
			{$props?.id}
			class={["torp-progress", $props?.class]}
			{$props?.style}
			role="progressbar"
			aria-label={$props?.ariaLabel}
			aria-valuemin={isIndeterminate() ? undefined : getMin()}
			aria-valuemax={isIndeterminate() ? undefined : getMax()}
			aria-valuenow={isIndeterminate() ? undefined : getValue()}
			aria-valuetext={$props?.valuetext}
			data-state={isIndeterminate() ? "indeterminate" : "determinate"}
		>
			<slot>
				<ProgressIndicator />
			</slot>
		</div>
	}

	@style {
		/* Headless: layout only, so the indicator fills the track. All
		   appearance is up to the consuming theme */
		.torp-progress {
			position: relative;
			overflow: hidden;
		}
	}
}
