import type { ClassValue, StyleValue } from "@torpor/view";
import {
	type FocusGroupContext,
	FocusGroupContextName,
} from "./FocusGroupTypes";

interface FocusGroupButtonProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** Whether this button is disabled */
	disabled?: boolean;
	/** Raised when the button is clicked */
	onclick?: (e: MouseEvent) => void;
}

/**
 * A button inside a FocusGroup. The group's tab stop roves with focus:
 * it starts on the first button and lands wherever focus last rested.
 */
export default function FocusGroupButton($props?: FocusGroupButtonProps) {
	let button: HTMLButtonElement;

	const context = $context[FocusGroupContextName] as FocusGroupContext;
	if (!context) {
		throw new Error("FocusGroupButton must be contained within a FocusGroup");
	}

	function setFocused() {
		button.focus();
	}

	const { index } = context.registerItem({ setFocused, disabled: $props?.disabled });

	$run(() => {
		return () => context.removeItem(index);
	});

	@render {
		<button
			{$props?.id}
			class={["torp-focus-group-button", $props?.class]}
			{$props?.style}
			type="button"
			tabindex={context.tabStopIndex() === index ? 0 : -1}
			{$props?.disabled}
			aria-disabled={$props?.disabled ? "true" : undefined}
			onclick={$props?.onclick}
			onkeydown={(e: KeyboardEvent) => context.handleItemKey(e)}
			onfocus={() => context.handleItemFocus(index)}
			&ref={button}
		>
			<slot />
		</button>
	}
}
