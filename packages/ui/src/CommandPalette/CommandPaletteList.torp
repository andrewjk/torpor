import type { ClassValue, StyleValue } from "@torpor/view";
import { type CommandPaletteContext, CommandPaletteContextName } from "./CommandPaletteTypes";
import CommandPaletteItem from "./CommandPaletteItem.torp";

interface CommandPaletteListProps {
	/** An ID for the list element */
	id?: string;
	/** Classes for the list element */
	class?: ClassValue;
	/** Styles for the list element */
	style?: StyleValue;
}

/**
 * The list of a CommandPalette, showing the commands that match the current
 * search text (or a message when none match).
 */
export default function CommandPaletteList($props: CommandPaletteListProps | undefined) {
	// Get stuff out of the CommandPalette context
	const context = $context[CommandPaletteContextName] as CommandPaletteContext;
	if (!context) {
		throw new Error("CommandPaletteList must be contained within a CommandPalette");
	}

	@render {
		<ul
			id={$props?.id ?? context.getListId()}
			class={["torp-command-palette-list", $props?.class]}
			{$props?.style}
			role="listbox"
		>
			<slot>
				@for (let [index, command] of context.getFilteredCommands().entries()) {
					@key = command.value
					<CommandPaletteItem {index} {command} />
				}
			</slot>
			@if (context.getFilteredCommands().length === 0) {
				<li class="torp-command-palette-empty">
					{context.getEmptyText()}
				</li>
			}
		</ul>
	}

	@style {
		/* Headless: layout only, so the input sits above the list. All
		   appearance is up to the consuming theme */
		.torp-command-palette-list {
			list-style: none;
			margin: 0;
			padding: 0;
		}
	}
}
