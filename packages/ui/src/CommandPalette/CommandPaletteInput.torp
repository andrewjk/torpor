import type { ClassValue, StyleValue } from "@torpor/view";
import { type CommandPaletteContext, CommandPaletteContextName } from "./CommandPaletteTypes";

interface CommandPaletteInputProps {
	/** An ID for the input element */
	id?: string;
	/** Classes for the input element */
	class?: ClassValue;
	/** Styles for the input element */
	style?: StyleValue;
	/** Text to display in the input when it is empty; falls back to the palette's placeholder */
	placeholder?: string;
	/** An accessible name for the input; falls back to the palette's ariaLabel */
	ariaLabel?: string;
}

/**
 * The search input of a CommandPalette, filtering the commands as the user
 * types.
 */
export default function CommandPaletteInput($props: CommandPaletteInputProps | undefined) {
	// Get stuff out of the CommandPalette context
	const context = $context[CommandPaletteContextName] as CommandPaletteContext;
	if (!context) {
		throw new Error("CommandPaletteInput must be contained within a CommandPalette");
	}

	@render {
		<input
			{$props?.id}
			class={["torp-command-palette-input", $props?.class]}
			{$props?.style}
			type="text"
			role="combobox"
			aria-expanded="true"
			aria-controls={context.getListId()}
			aria-activedescendant={context.getActiveItemId()}
			aria-autocomplete="list"
			aria-label={$props?.ariaLabel ?? context.getAriaLabel()}
			placeholder={$props?.placeholder ?? context.getPlaceholder()}
			oninput={context.handleInput}
			onkeydown={context.handleKey}
			onmount={(el) => {
				context.registerInput(el);
				return () => {
					context.unregisterInput(el);
				};
			}}
		/>
	}
}
