import type { ClassValue, StyleValue } from "@torpor/view";
import { type CommandPaletteContext, CommandPaletteContextName } from "./CommandPaletteTypes";
import type { Command } from "./CommandTypes";

interface CommandPaletteItemProps {
	/** An ID for the item element */
	id?: string;
	/** Classes for the item element */
	class?: ClassValue;
	/** Styles for the item element */
	style?: StyleValue;
	/** The item's position in the list */
	index: number;
	/** The command that choosing this item runs */
	command: Command;
}

/**
 * One command of a CommandPalette, showing its label and shortcut hint.
 * Choosing it runs the command and closes the palette.
 */
export default function CommandPaletteItem($props: CommandPaletteItemProps | undefined) {
	// Get stuff out of the CommandPalette context
	const context = $context[CommandPaletteContextName] as CommandPaletteContext;
	if (!context) {
		throw new Error("CommandPaletteItem must be contained within a CommandPalette");
	}

	function getIndex(): number {
		return $props?.index ?? 0;
	}

	function getCommand(): Command | undefined {
		return $props?.command;
	}

	function getDisabled(): boolean {
		return getCommand()?.disabled === true;
	}

	@render {
		<li
			id={$props?.id ?? context.getItemId(getIndex())}
			class={["torp-command-palette-item", $props?.class]}
			{$props?.style}
			role="option"
			aria-selected={context.isActiveCommand(getIndex()) ? "true" : "false"}
			aria-disabled={getDisabled() ? "true" : undefined}
			data-state={context.isActiveCommand(getIndex()) ? "active" : "inactive"}
			onclick={() => context.runCommand(getCommand())}
		>
			<slot>
				<span class="torp-command-palette-label">{getCommand()?.label}</span>
				@if (getCommand()?.shortcut) {
					<span class="torp-command-palette-shortcut" aria-hidden="true">
						{getCommand()?.shortcut}
					</span>
				}
			</slot>
		</li>
	}
}
