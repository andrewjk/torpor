import type { ClassValue, StyleValue } from "@torpor/view";
import { type MeterContext, MeterContextName } from "./MeterTypes";

interface MeterIndicatorProps {
	/** An ID for the indicator element */
	id?: string;
	/** Classes for the indicator element */
	class?: ClassValue;
	/** Styles for the indicator element */
	style?: StyleValue;
}

/**
 * The bar of a Meter that fills the track in proportion to the current
 * value.
 */
export default function MeterIndicator($props: MeterIndicatorProps | undefined) {
	// Get stuff out of the Meter context
	const context = $context[MeterContextName] as MeterContext;
	if (!context) {
		throw new Error("MeterIndicator must be contained within a Meter");
	}

	@render {
		<div
			{$props?.id}
			class={["torp-meter-bar", $props?.class]}
			style={[`width: ${context.getPct()}%;`, $props?.style]}
			data-state={context.getState()}
		/>
	}

	@style {
		/* Headless: layout only, so the bar fills the track proportionally.
		   All appearance is up to the consuming theme */
		.torp-meter-bar {
			position: absolute;
			inset: 0 auto 0 0;
		}
	}
}
