import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import {
	type FieldContext,
	FieldContextName,
	type FormContext,
	FormContextName,
} from "../Form/FormTypes";
import FormValues from "../Form/FormValues.torp";
import { type LoadResult, type Loader, createItemLoader } from "../utils/loader";
import { type PopoutContext, PopoutContextName } from "../utils/PopoutTypes";
import createFormField from "../utils/formField";
import { type SelectBoxContext, SelectBoxContextName, type SelectBoxState } from "./SelectBoxTypes";

interface SelectBoxProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The name of the input's form data field */
	name?: string;
	/** The data value selected by the user, or an array of values if multiple is set */
	value: Bindable<any>;
	/** Whether multiple values can be selected at the same time */
	multiple?: boolean;
	/**
	 * Reads options from the network (or anywhere async) when the box is
	 * shown. When set and no content is slotted in, the options are rendered
	 * automatically.
	 */
	load?: Loader;
	/** Called after each successful load with the normalized result */
	onload?: (result: LoadResult) => void;
	/** Extracts the display text for a loaded item (defaults to `label ?? text ?? item`) */
	getItemLabel?: (item: any) => any;
	/** Extracts the value for a loaded item (defaults to `value ?? id`) */
	getItemValue?: (item: any) => any;
	/** Text to display when the input value is empty */
	placeholder?: string;
	///** Whether the input's value is required */
	//required?: boolean,
	/** Whether the popout is visible; only bind this to control it from outside */
	visible?: Bindable<boolean | undefined>;
	/** Raised when the value has changed */
	onchange?: (value: any) => void;
	/** Raised when the popout has opened */
	onopen?: () => void;
	/** Raised when the popout has closed */
	onclose?: (result: any) => void;
}

/**
 * An input box for selecting a value from a popout ListBox or Dialog.
 *
 * See [the WAI ARIA guidelines for ComboBoxes](https://www.w3.org/WAI/ARIA/apg/patterns/combobox/).
 *
 * The structure of a SelectBox is:
 *
 * ```
 * <SelectBox>
 * 	<SelectBoxTrigger />
 * 	<SelectBoxContent />
 * </SelectBox>
 * ```
 */
export default function SelectBox($props: SelectBoxProps | undefined) {
	// Wire up the enclosing Form and Field, if any
	const form = createFormField(
		$props?.name,
		$context[FormContextName] as FormContext | undefined,
		$context[FieldContextName] as FieldContext | undefined,
	);

	let $state: SelectBoxState = $watch({
		visible: false,
		value: $props?.value,
		contentId: undefined,
		triggerId: undefined,
		contentRole: undefined,
	});

	$bind($state, $props, "visible", "value");

	if ($props?.load !== undefined && typeof $props.load !== "function") {
		throw new Error("SelectBox: `load` must be a function");
	}
	const hasLoader = typeof $props?.load === "function";

	// Load options from the network (lazily, on first read)
	const $load = hasLoader
		? createItemLoader({
				load: $props!.load!,
				getRequest: () => ({}),
				onload: (r) => $props?.onload?.(r),
			})
		: undefined;

	let result: any;

	// Set the context to pass down to items
	let context: SelectBoxContext = {
		handleButton,
		handleClickOutside,
		get placeholder() {
			return $props?.placeholder;
		},
		get multiple() {
			return $props?.multiple === true;
		},
		inField: () => form.inField,
		valid: () => form.valid,
		messageId: () => form.messageId,
		handleBlur: () => form.handleBlur(),
		state: $state,
		getLoadedItems: $load ? () => $load.items : undefined,
		getItemLabel: $props?.getItemLabel,
		getItemValue: $props?.getItemValue,
	};
	$context[SelectBoxContextName] = context;

	// Set the context to pass down to items
	let popoutContext: PopoutContext = context;
	$context[PopoutContextName] = popoutContext;

	// Dispatch the change event when the value changes
	$handle((first) => {
		const value = $state.value;
		if (!first) {
			form.handleInput();
			$props?.onchange?.(value);
		}
	});

	// Dispatch the open/close events when the popout is opened or closed
	$handle((first) => {
		const visible = $state.visible;
		if (first) return;
		if (visible) {
			$props?.onopen?.();
		} else {
			$props?.onclose?.(result);
		}
	});

	function handleButton(type: "confirm" | "cancel" | undefined, value?: any) {
		// Get the button's result
		switch (type) {
			case "confirm": {
				result = value ?? true;
				break;
			}
			case "cancel": {
				result = value ?? false;
				break;
			}
			default: {
				result = value;
				break;
			}
		}

		// Update the value
		if (type !== "cancel") {
			$state.value = result;
		}

		// Hide the popout and focus the button
		if (type === "confirm" || type === "cancel") {
			$state.visible = false;
			if (context.focusTrigger) {
				context.focusTrigger();
			}
		}
	}

	function handleClickOutside(e: MouseEvent | KeyboardEvent) {
		e.preventDefault();
		$state.visible = false;
	}

	@render {
		<div {$props?.id} class={["torp-select-box", $props?.class]} {$props?.style}>
			<slot />
		</div>

		<FormValues name={form.name} value={$state.value} />
	}
}
