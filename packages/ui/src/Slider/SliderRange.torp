import type { ClassValue, StyleValue } from "@torpor/view";
import { type SliderContext, SliderContextName } from "./SliderTypes";

interface SliderRangeProps {
	/** An ID for the range element */
	id?: string;
	/** Classes for the range element */
	class?: ClassValue;
	/** Styles for the range element */
	style?: StyleValue;
}

/**
 * The filled portion of a Slider, from the start of the track to the
 * current value.
 */
export default function SliderRange($props: SliderRangeProps | undefined) {
	// Get stuff out of the Slider context
	const context = $context[SliderContextName] as SliderContext;
	if (!context) {
		throw new Error("SliderRange must be contained within a Slider");
	}

	function fillStyle(): string {
		const property = context.getOrientation() === "vertical" ? "height" : "width";
		return `${property}: ${context.getPct()}%;`;
	}

	@render {
		<div
			{$props?.id}
			class={["torp-slider-fill", $props?.class]}
			style={[fillStyle(), $props?.style]}
		/>
	}
}
