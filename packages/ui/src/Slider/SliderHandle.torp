import type { ClassValue, StyleValue } from "@torpor/view";
import { type SliderContext, SliderContextName } from "./SliderTypes";

interface SliderHandleProps {
	/** An ID for the handle element */
	id?: string;
	/** Classes for the handle element */
	class?: ClassValue;
	/** Styles for the handle element */
	style?: StyleValue;
	/** An accessible name for the slider; falls back to the Slider's ariaLabel */
	ariaLabel?: string;
	/** If set to true, the user cannot interact with this handle */
	disabled?: boolean;
}

/**
 * The thumb of a Slider that the user drags along the track, or moves with
 * the keyboard. It carries `role="slider"` and all of the slider's ARIA
 * value attributes.
 *
 * See [the WAI ARIA guidelines for Sliders](https://www.w3.org/WAI/ARIA/apg/patterns/slider/).
 */
export default function SliderHandle($props: SliderHandleProps | undefined) {
	// Get stuff out of the Slider context
	const context = $context[SliderContextName] as SliderContext;
	if (!context) {
		throw new Error("SliderHandle must be contained within a Slider");
	}

	function getDisabled(): boolean {
		return $props?.disabled === true || context.getDisabled();
	}

	function positionStyle(): string {
		if (context.getOrientation() === "vertical") {
			return `position: absolute; transform: translate(-50%, -50%); top: ${context.getPct()}%; left: 50%;`;
		}
		return `position: absolute; transform: translate(-50%, -50%); left: ${context.getPct()}%; top: 50%;`;
	}

	function handleKey(e: KeyboardEvent) {
		if (getDisabled()) return;

		switch (e.key) {
			case "ArrowRight":
			case "ArrowUp": {
				e.preventDefault();
				context.setValue(context.getValue() + context.getStep());
				break;
			}
			case "ArrowLeft":
			case "ArrowDown": {
				e.preventDefault();
				context.setValue(context.getValue() - context.getStep());
				break;
			}
			case "PageUp": {
				e.preventDefault();
				context.setValue(context.getValue() + context.getStep() * 10);
				break;
			}
			case "PageDown": {
				e.preventDefault();
				context.setValue(context.getValue() - context.getStep() * 10);
				break;
			}
			case "Home": {
				e.preventDefault();
				context.setValue(context.getMin());
				break;
			}
			case "End": {
				e.preventDefault();
				context.setValue(context.getMax());
				break;
			}
		}
	}

	@render {
		<div
			{$props?.id}
			class={["torp-slider-thumb", $props?.class]}
			style={[positionStyle(), $props?.style]}
			role="slider"
			tabindex={getDisabled() ? -1 : 0}
			aria-orientation={context.getOrientation()}
			aria-valuemin={context.getMin()}
			aria-valuemax={context.getMax()}
			aria-valuenow={context.getValue()}
			aria-label={$props?.ariaLabel ?? context.getAriaLabel()}
			aria-disabled={getDisabled() ? "true" : undefined}
			data-valid={context.valid() ? "valid" : "invalid"}
			aria-describedby={context.messageId()}
			aria-invalid={context.inField() && !context.valid() ? "true" : undefined}
			onblur={() => context.handleBlur()}
			onkeydown={handleKey}
			onmount={(el) => {
				context.registerHandle(el);
				return () => {
					context.unregisterHandle(el);
				};
			}}
		/>
	}
}
