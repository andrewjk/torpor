import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import $handle from "../utils/$handle";
import {
	type FieldContext,
	FieldContextName,
	type FormContext,
	FormContextName,
} from "../Form/FormTypes";
import FormValues from "../Form/FormValues.torp";
import createFormField from "../utils/formField";

interface SliderProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** The minimum allowed value */
	min?: number;
	/** The maximum allowed value */
	max?: number;
	/** The amount by which the value is increased or decreased */
	step?: number;
	/** The current value of the slider */
	value?: Bindable<number>;
	/** The orientation of the slider */
	orientation?: "horizontal" | "vertical";
	/** If set to true, the user cannot interact with this slider */
	disabled?: boolean;
	/** An accessible name for the slider */
	ariaLabel?: string;
	/** The name of the component's form data field */
	name?: string;
	/** Raised when the value has changed */
	onchange?: (value: number) => void;
}

/**
 * An input where the user selects a value from within a given range, by
 * dragging a thumb along a track or by using the keyboard.
 *
 * See [the WAI ARIA guidelines for Sliders](https://www.w3.org/WAI/ARIA/apg/patterns/slider/).
 */
export default function Slider($props: SliderProps | undefined) {
	let track: HTMLElement;
	let thumb: HTMLElement;

	// Wire up the enclosing Form and Field, if any
	const form = createFormField(
		$props?.name,
		$context[FormContextName] as FormContext | undefined,
		$context[FieldContextName] as FieldContext | undefined,
	);

	function getMin(): number {
		return $props?.min ?? 0;
	}
	function getMax(): number {
		return $props?.max ?? 100;
	}
	function getStep(): number {
		const step = $props?.step ?? 1;
		return step > 0 ? step : 1;
	}
	function getOrientation(): "horizontal" | "vertical" {
		return $props?.orientation === "vertical" ? "vertical" : "horizontal";
	}
	function getDisabled(): boolean {
		return $props?.disabled === true;
	}

	let $state = $watch({
		value: 0,
	});

	$bind($state, $props, "value");

	// Dispatch the change event when the value changes
	$handle((first) => {
		const value = $state.value;
		if (!first) $props?.onchange?.(value);
	});

	function clamp(value: number): number {
		return Math.min(getMax(), Math.max(getMin(), value));
	}

	// Snap a raw position-derived value to the nearest step multiple
	function snap(value: number): number {
		const min = getMin();
		const snapped = min + Math.round((value - min) / getStep()) * getStep();
		return snapped === -0 ? 0 : snapped;
	}

	// The clamped value that is displayed and reported to assistive tech
	function getValue(): number {
		return clamp($state.value);
	}

	// The percentage of the range that the value represents (0..100)
	function getPct(): number {
		const min = getMin();
		const max = getMax();
		if (max <= min) return 0;
		return ((getValue() - min) / (max - min)) * 100;
	}

	function setValue(value: number) {
		const next = clamp(snap(value));
		if (next !== $state.value) {
			$state.value = next;
			form.handleInput();
			return true;
		}
		return false;
	}

	// Convert a pointer position into a value along the track
	function valueFromPointer(e: { clientX: number; clientY: number }): number {
		const rect = track.getBoundingClientRect();
		const horizontal = getOrientation() === "horizontal";
		const pos = horizontal ? e.clientX - rect.left : e.clientY - rect.top;
		const size = horizontal ? rect.width : rect.height;
		if (!(size > 0)) {
			return getValue();
		}
		const ratio = Math.min(1, Math.max(0, pos / size));
		return getMin() + ratio * (getMax() - getMin());
	}

	let dragging = false;

	function removeDragListeners() {
		removeEventListener("mousemove", handleMouseMove);
		removeEventListener("mouseup", handleMouseUp);
	}

	function handleMouseDown(e: MouseEvent) {
		if (getDisabled()) return;
		e.preventDefault();
		dragging = true;
		setValue(valueFromPointer(e));
		thumb.focus();
		addEventListener("mousemove", handleMouseMove);
		addEventListener("mouseup", handleMouseUp);
	}

	function handleMouseMove(e: MouseEvent) {
		if (!dragging || getDisabled()) return;
		setValue(valueFromPointer(e));
	}

	function handleMouseUp() {
		if (!dragging) return;
		dragging = false;
		removeDragListeners();
	}

	// Stop listening if the slider is unmounted mid-drag
	$onmount(() => {
		return () => removeDragListeners();
	});

	function handleKey(e: KeyboardEvent) {
		if (getDisabled()) return;

		switch (e.key) {
			case "ArrowRight":
			case "ArrowUp": {
				e.preventDefault();
				setValue($state.value + getStep());
				break;
			}
			case "ArrowLeft":
			case "ArrowDown": {
				e.preventDefault();
				setValue($state.value - getStep());
				break;
			}
			case "PageUp": {
				e.preventDefault();
				setValue($state.value + getStep() * 10);
				break;
			}
			case "PageDown": {
				e.preventDefault();
				setValue($state.value - getStep() * 10);
				break;
			}
			case "Home": {
				e.preventDefault();
				setValue(getMin());
				break;
			}
			case "End": {
				e.preventDefault();
				setValue(getMax());
				break;
			}
		}
	}

	@render {
		<div
			{$props?.id}
			class={["torp-slider", getDisabled() ? "torp-slider-disabled" : undefined, $props?.class]}
			{$props?.style}
			onmousedown={handleMouseDown}
			&ref={track}
		>
			<div class="torp-slider-fill" style={`${getOrientation() === "vertical" ? "height" : "width"}: ${getPct()}%;`} />
			<div
				class="torp-slider-thumb"
				style={`position: absolute; transform: translate(-50%, -50%); ${getOrientation() === "vertical" ? `top: ${getPct()}%; left: 50%` : `left: ${getPct()}%; top: 50%`};`}
				role="slider"
				tabindex={getDisabled() ? -1 : 0}
				aria-orientation={getOrientation()}
				aria-valuemin={getMin()}
				aria-valuemax={getMax()}
				aria-valuenow={getValue()}
				aria-label={$props?.ariaLabel}
				aria-disabled={getDisabled() ? "true" : undefined}
				data-valid={form.valid ? "valid" : "invalid"}
				aria-describedby={form.messageId}
				aria-invalid={form.inField && !form.valid ? "true" : undefined}
				onblur={form.handleBlur}
				onkeydown={handleKey}
				&ref={thumb}
			/>
		</div>

		<FormValues name={form.name} value={getValue()} />
	}

	@style {
		/* Headless: all positioning is done with inline styles (so that theme
		   CSS can't dislodge the thumb from the track). All appearance is up
		   to the consuming theme */
		.torp-slider {
			position: relative;
			touch-action: none;
		}
	}
}
