import type { Bindable, ClassValue, StyleValue } from "@torpor/view";
import {
	type FieldContext,
	FieldContextName,
	type FormContext,
	FormContextName,
} from "../Form/FormTypes";
import FormValues from "../Form/FormValues.torp";
import { extractRaw, formatMask, parseMask } from "../utils/maskUtils";
import createFormField from "../utils/formField";

interface MaskedInputProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/**
	 * The input mask: `9` accepts a digit, `L` a letter and `a` an
	 * alphanumeric character; any other character is a literal shown as-is.
	 * Use `\x` to escape a token character as a literal. e.g. "(999) 999-9999"
	 */
	mask: string;
	/** The raw entered characters, without mask literals */
	value?: Bindable<string>;
	/** Text displayed when no value has been entered (defaults to the mask) */
	placeholder?: string;
	/** If set to true, the user cannot interact with this input */
	disabled?: boolean;
	/** An accessible name for the input */
	ariaLabel?: string;
	/** The name of the component's form data field */
	name?: string;
	/** Raised when the value has changed */
	onchange?: (value: string) => void;
}

/**
 * An input that formats its contents as the user types -- phone numbers,
 * credit cards, product codes -- displaying literals automatically while
 * binding only the underlying characters.
 *
 * ```
 * <MaskedInput mask="(999) 999-9999" &value={$state.phone} />
 * <MaskedInput mask="LLL-9999" name="code" />
 * ```
 *
 * Note that a complete value is not required: the bound value grows as the
 * user types, so validate completeness with a schema when needed.
 */
export default function MaskedInput($props: MaskedInputProps | undefined) {
	let input: HTMLInputElement;

	const tokens = parseMask($props?.mask ?? "");

	// Wire up the enclosing Form and Field, if any
	const form = createFormField(
		$props?.name,
		$context[FormContextName] as FormContext | undefined,
		$context[FieldContextName] as FieldContext | undefined,
	);

	function getDisabled(): boolean {
		return $props?.disabled === true;
	}

	// The bound value is the raw entered characters, so the state key
	// matches the prop name for $bind
	let $state = $watch({
		value: "",
	});

	$bind($state, $props, "value");

	function display(): string {
		return formatMask(tokens, $state.value ?? "");
	}

	function getPlaceholder(): string | undefined {
		return $props?.placeholder ?? $props?.mask;
	}

	// Keep the element's text matching the formatted raw value; typing sets
	// the property directly, so an attribute alone would not update it
	function syncInput() {
		if (input && !getDisabled() && input.value !== display()) {
			input.value = display();
		}
	}
	$run(() => {
		if (!input) return;
		const raw = $state.value ?? "";
		const next = formatMask(tokens, raw);
		if (input.value !== next) {
			input.value = next;
		}
	});
	$mount(() => syncInput());

	function handleInput(e: Event) {
		if (getDisabled()) return;
		const el = e.currentTarget as HTMLInputElement;

		const raw = extractRaw(tokens, el.value);
		if (raw !== $state.value) {
			$state.value = raw;
			form.handleInput();
			$props?.onchange?.(raw);
		}

		// Rewrite the element so rejected characters disappear immediately
		el.value = formatMask(tokens, raw);
	}

	function handleBlur() {
		form.handleBlur();
	}

	@render {
		<input
			&ref={input}
			id={$props?.id}
			class={["torp-masked-input", $props?.class]}
			{$props?.style}
			type="text"
			spellcheck="false"
			autocomplete="off"
			value={display()}
			placeholder={getPlaceholder()}
			disabled={getDisabled()}
			tabindex={getDisabled() ? -1 : 0}
			aria-label={$props?.ariaLabel}
			data-valid={form.valid ? "valid" : "invalid"}
			aria-describedby={form.messageId}
			aria-invalid={form.inField && !form.valid ? "true" : undefined}
			oninput={handleInput}
			onblur={handleBlur}
		/>

		<FormValues name={form.name} value={$state.value || undefined} />
	}
}
