import type { ClassValue, StyleValue } from "@torpor/view";
import StepperMarker from "./StepperMarker.torp";
import { type StepperContext, StepperContextName } from "./StepperTypes";

interface StepperStepProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** A label for the step, shown next to its marker */
	label?: string;
}

/**
 * A step in a Stepper, which is complete once the stepper has moved past it,
 * and current when the stepper is on it.
 */
export default function StepperStep($props: StepperStepProps | undefined) {
	// Get stuff out of the Stepper context
	const context = $context[StepperContextName] as StepperContext;
	if (!context) {
		throw new Error("StepperStep must be contained within a Stepper");
	}

	// Register this step with the parent Stepper
	let $state = context.registerStep();

	$run(() => {
		return () => {
			context.removeStep($state.index);
		};
	});

	function isComplete(): boolean {
		return $state.index < context.getValue();
	}

	function isCurrent(): boolean {
		return $state.index === context.getValue();
	}

	// Steps can always be revisited once complete; when the stepper is not
	// linear, any step can be jumped to
	function canVisit(): boolean {
		return isComplete() || !context.linear;
	}

	function handleClick() {
		if (canVisit()) {
			context.setValue($state.index);
		}
	}

	function stepLabel(): string {
		return $props?.label ?? `Step ${$state.index + 1}`;
	}

	@render {
		<li
			{$props?.id}
			class={["torp-stepper-step", $props?.class]}
			{$props?.style}
			aria-current={isCurrent() ? "step" : undefined}
			data-state={isComplete() ? "complete" : isCurrent() ? "current" : "upcoming"}
		>
			@if (canVisit()) {
				<button
					type="button"
					class="torp-stepper-step-button"
					aria-label={`Go to ${stepLabel()}`}
					onclick={handleClick}
				>
					<StepperMarker complete={isComplete()} index={$state.index} />
					<slot>
						<span>{stepLabel()}</span>
					</slot>
				</button>
			} @else {
				<span class="torp-stepper-step-label">
					<StepperMarker complete={isComplete()} index={$state.index} />
					<slot>
						<span>{stepLabel()}</span>
					</slot>
				</span>
			}
		</li>
	}
}
