import type { ClassValue, StyleValue } from "@torpor/view";
import ChevronRight from "../icons/ChevronRight.torp";
import { type StepperContext, StepperContextName } from "./StepperTypes";

interface StepperNextProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label for the button, for screen readers when the button contains no text */
	ariaLabel?: string;
	/** If set to true, the user cannot interact with this button */
	disabled?: boolean;
}

/**
 * The button in a Stepper that a user can press to move to the next step,
 * which raises the stepper's oncomplete event on the last step.
 */
export default function StepperNext($props: StepperNextProps | undefined) {
	// Get stuff out of the Stepper context
	const context = $context[StepperContextName] as StepperContext;
	if (!context) {
		throw new Error("StepperNext must be contained within a Stepper");
	}

	@render {
		<button
			{$props?.id}
			class={["torp-stepper-next", $props?.class]}
			{$props?.style}
			type="button"
			aria-label={$props?.ariaLabel ?? "Next step"}
			disabled={$props?.disabled}
			onclick={() => context.next()}
		>
			<slot>
				<ChevronRight />
			</slot>
		</button>
	}
}
