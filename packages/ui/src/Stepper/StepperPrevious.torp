import type { ClassValue, StyleValue } from "@torpor/view";
import ChevronLeft from "../icons/ChevronLeft.torp";
import { type StepperContext, StepperContextName } from "./StepperTypes";

interface StepperPreviousProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label for the button, for screen readers when the button contains no text */
	ariaLabel?: string;
	/** If set to true, the user cannot interact with this button */
	disabled?: boolean;
}

/**
 * The button in a Stepper that a user can press to move to the previous
 * step.
 */
export default function StepperPrevious($props: StepperPreviousProps | undefined) {
	// Get stuff out of the Stepper context
	const context = $context[StepperContextName] as StepperContext;
	if (!context) {
		throw new Error("StepperPrevious must be contained within a Stepper");
	}

	@render {
		<button
			{$props?.id}
			class={["torp-stepper-previous", $props?.class]}
			{$props?.style}
			type="button"
			aria-label={$props?.ariaLabel ?? "Previous step"}
			disabled={$props?.disabled || !context.canPrevious()}
			onclick={() => context.previous()}
		>
			<slot>
				<ChevronLeft />
			</slot>
		</button>
	}
}
