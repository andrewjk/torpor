import type { ClassValue, StyleValue } from "@torpor/view";
import {
	Calendar,
	CalendarDayHeader,
	CalendarGrid,
	CalendarGridHeader,
	CalendarHeader,
	CalendarHeaderTrigger,
} from "../Calendar/index";
import DatePickerHeader from "../DatePicker/DatePickerHeader.torp";
import DateRangePickerDay from "./DateRangePickerDay.torp";
import {
	type DateRangePickerShellContext,
	DateRangePickerShellContextName,
} from "./DateRangePickerTypes";

interface DateRangePickerContentProps {
	/** An ID for the content element */
	id?: string;
	/** Classes for the content element */
	class?: ClassValue;
	/** Styles for the content element */
	style?: StyleValue;
}

/**
 * The popout of a DateRangePicker, containing the calendar the user selects
 * a range of dates from.
 */
export default function DateRangePickerContent($props: DateRangePickerContentProps | undefined) {
	// Get stuff out of the DateRangePicker context
	const context = $context[DateRangePickerShellContextName] as DateRangePickerShellContext;
	if (!context) {
		throw new Error("DateRangePickerContent must be contained within a DateRangePicker");
	}

	@render {
		<div
			id={$props?.id ?? context.getContentId()}
			class={[
				"torp-date-range-picker-content",
				context.isVisible() ? undefined : "hidden",
				$props?.class,
			]}
			{$props?.style}
			aria-hidden={context.isVisible() ? undefined : "true"}
			onmount={(el) => {
				context.registerContent(el);
				return () => {
					context.unregisterContent(el);
				};
			}}
		>
			<slot>
				<Calendar
					selectable
					value={context.getStartValue()}
					isSelected={context.isDaySelected}
					onchange={context.selectDay}
					onclose={context.close}
				>
					<CalendarHeader>
						<CalendarHeaderTrigger type="previous" />
						<DatePickerHeader class="torp-date-range-picker-header" />
						<CalendarHeaderTrigger type="next" />
					</CalendarHeader>
					<CalendarGridHeader>
						@for (let day of $slot.days) {
							<CalendarDayHeader {day.dayName} {day.shortDayName} />
						}
					</CalendarGridHeader>
					<CalendarGrid>
						<DateRangePickerDay
							date={$slot.day.date}
							muted={$slot.day.muted}
							active={$slot.day.active}
						/>
					</CalendarGrid>
				</Calendar>
			</slot>
		</div>
	}

	@style {
		/* Visibility only -- see SelectBoxContent */
		.torp-date-range-picker-content.hidden {
			display: none;
		}
	}
}
