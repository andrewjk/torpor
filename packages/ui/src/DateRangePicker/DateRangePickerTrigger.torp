import type { ClassValue, StyleValue } from "@torpor/view";
import {
	type DateRangePickerShellContext,
	DateRangePickerShellContextName,
} from "./DateRangePickerTypes";

interface DateRangePickerTriggerProps {
	/** An ID for the trigger element */
	id?: string;
	/** Classes for the trigger element */
	class?: ClassValue;
	/** Styles for the trigger element */
	style?: StyleValue;
	/** An accessible name for the trigger; falls back to the picker's ariaLabel */
	ariaLabel?: string;
	/** If set to true, the user cannot interact with this trigger */
	disabled?: boolean;
}

/**
 * The button of a DateRangePicker that displays the selected range and
 * opens the calendar popout.
 */
export default function DateRangePickerTrigger($props: DateRangePickerTriggerProps | undefined) {
	// Get stuff out of the DateRangePicker context
	const context = $context[DateRangePickerShellContextName] as DateRangePickerShellContext;
	if (!context) {
		throw new Error("DateRangePickerTrigger must be contained within a DateRangePicker");
	}

	function getDisabled(): boolean {
		return $props?.disabled === true || context.getDisabled();
	}

	@render {
		<button
			type="button"
			id={$props?.id ?? context.getTriggerId()}
			class={["torp-date-range-picker-trigger", $props?.class]}
			{$props?.style}
			aria-haspopup="dialog"
			aria-expanded={context.isVisible() ? "true" : "false"}
			aria-controls={context.isVisible() ? context.getContentId() : undefined}
			aria-label={$props?.ariaLabel ?? context.getAriaLabel()}
			data-valid={context.valid() ? "valid" : "invalid"}
			aria-describedby={context.messageId()}
			aria-invalid={context.inField() && !context.valid() ? "true" : undefined}
			onblur={() => context.handleBlur()}
			disabled={getDisabled()}
			onclick={(e: MouseEvent) => {
				// Don't close when the trigger itself is clicked
				e.stopPropagation();
				context.toggle();
			}}
		>
			<slot>{context.getDisplayText()}</slot>
		</button>
	}
}
