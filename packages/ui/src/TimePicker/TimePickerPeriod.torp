import type { ClassValue, StyleValue } from "@torpor/view";
import { type TimePickerContext, TimePickerContextName } from "./TimePickerTypes";

interface TimePickerPeriodProps {
	/** An ID for the period element */
	id?: string;
	/** Classes for the period element */
	class?: ClassValue;
	/** Styles for the period element */
	style?: StyleValue;
}

/**
 * The AM/PM toggle of a TimePicker, shown in 12-hour mode.
 */
export default function TimePickerPeriod($props: TimePickerPeriodProps | undefined) {
	// Get stuff out of the TimePicker context
	const context = $context[TimePickerContextName] as TimePickerContext;
	if (!context) {
		throw new Error("TimePickerPeriod must be contained within a TimePicker");
	}

	function getDisabled(): boolean {
		return context.getDisabled();
	}

	@render {
		<button
			{$props?.id}
			type="button"
			class={["torp-time-picker-period", $props?.class]}
			{$props?.style}
			disabled={getDisabled()}
			tabindex={getDisabled() ? -1 : 0}
			aria-label={context.isPM() ? "PM" : "AM"}
			onclick={() => context.togglePeriod()}
			onkeydown={context.handlePeriodKey}
			onmount={(el) => {
				context.registerPeriod(el);
				return () => {
					context.unregisterPeriod(el);
				};
			}}
		>
			{context.isPM() ? "PM" : "AM"}
		</button>
	}
}
