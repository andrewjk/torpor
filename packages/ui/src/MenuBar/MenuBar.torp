import type { ClassValue, StyleValue } from "@torpor/view";
import { focusItem as focusListItem } from "../utils/focusItem";
import { type ItemState, type MenuBarContext, MenuBarContextName } from "./MenuBarTypes";

interface MenuBarProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** An ARIA label for describing the menu to screen readers */
	ariaLabel?: string;
	/** The orientation of the menu, which affects keyboard navigation */
	orientation?: "horizontal" | "vertical";
}

/**
 * A menu bar, similar to that shown at the top of Windows applications or at the top of the screen on Macs.
 *
 * See [the WAI ARIA guidelines for Menus](https://www.w3.org/WAI/ARIA/apg/patterns/menu/).
 *
 * The structure of a MenuBar is:
 *
 * ```
 * <MenuBar>
 * 	<MenuBarItem>
 * 		<MenuBarItemTrigger />
 * 		<MenuBarItemContent>
 * 			<Menu />
 * 		</MenuBarItemContent>
 * 	</MenuBarItem>
 * </MenuBar>
 * ```
 */
export default function MenuBar($props: MenuBarProps | undefined) {
	let orientation = $props?.orientation ?? "horizontal";

	let $state = $watch({
		active: false,
	});

	// A collection containing the state and some functions for each item
	let itemStates: ItemState[] = [];
	let focusIndex = -1;

	// Set the context to pass down to items
	let context: MenuBarContext = {
		handleItemShow,
		handleButtonFocus,
		handleButtonKey,
		registerItem,
		state: $state,
	};
	$context[MenuBarContextName] = context;

	function registerItem(item: ItemState) {
		// Add the item's state to the array and return its index
		itemStates.push(item);
		itemStates = itemStates;
		return { index: itemStates.length - 1 };
	}

	function handleItemShow(index: number) {
		// Make sure other items are hidden
		itemStates.forEach((item, i) => {
			if (i !== index) {
				item.setVisible(false);
			}
		});
	}

	function handleButtonFocus(index: number) {
		focusIndex = index;
	}

	function handleButtonKey(e: KeyboardEvent) {
		switch (e.key) {
			case "ArrowRight": {
				if (orientation === "horizontal") {
					e.preventDefault();
					focusItem("next");
				}
				break;
			}
			case "ArrowLeft": {
				if (orientation === "horizontal") {
					e.preventDefault();
					focusItem("previous");
				}
				break;
			}
			case "ArrowDown": {
				if (orientation === "vertical") {
					e.preventDefault();
					focusItem("next");
				}
				break;
			}
			case "ArrowUp": {
				if (orientation === "vertical") {
					e.preventDefault();
					focusItem("previous");
				}
				break;
			}
			case "Home": {
				e.preventDefault();
				focusItem("start");
				break;
			}
			case "End": {
				e.preventDefault();
				focusItem("end");
				break;
			}
		}
	}

	function focusItem(target: "start" | "previous" | "next" | "end") {
		focusIndex = focusListItem(itemStates, focusIndex, target);
	}

	@render {
		<div
			{$props?.id}
			class={["torp-menu-bar", $props?.class]}
			{$props?.style}
			tabindex="-1"
			role="menubar"
			aria-label={$props?.ariaLabel}
			aria-orientation={orientation}
		>
			<slot />
		</div>
	}
}
