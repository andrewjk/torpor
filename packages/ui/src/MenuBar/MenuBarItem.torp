import type { ClassValue, StyleValue } from "@torpor/view";
import SubmenuPopout from "../utils/SubmenuPopout.torp";
import {
	type MenuBarContext,
	MenuBarContextName,
	type MenuBarItemContext,
	MenuBarItemContextName,
} from "./MenuBarTypes";

interface MenuBarItemProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** Whether the item is visible */
	visible?: boolean;
	/** Raised when the item has opened */
	onopen?: () => void;
	/** Raised when the item has closed */
	onclose?: (result: any) => void;
}

/**
 * A popout that is attached to a menubar button and can be used to show a submenu.
 *
 * The structure of a MenuBarItem is:
 *
 * ```
 * <MenuBarItem>
 * 	<MenuBarItemTrigger /> (optional)
 * 	<MenuBarItemContent />
 * </MenuBarItem>
 * ```
 */
export default function MenuBarItem($props: MenuBarItemProps | undefined) {
	let $state = $watch({
		visible: false,
		contentId: undefined,
		triggerId: undefined,
		contentRole: undefined,
	});

	// Get stuff out of the MenuBarContext
	const menubarContext = $context[MenuBarContextName] as MenuBarContext;
	if (!menubarContext) {
		throw new Error("MenuBarItem must be contained within a MenuBar");
	}
	const { handleItemShow, handleAdjacentItem } = menubarContext;

	// Set the context to pass down to the trigger and content
	let itemContext: MenuBarItemContext = {
		setVisible,
		state: $state,
		index: -1,
	};
	$context[MenuBarItemContextName] = itemContext;

	function handleNavigateMenuBar(target: "previous" | "next") {
		// Called from a contained Menu when focus should move to an adjacent
		// menubar item; the MenuBar moves focus and opens that item's menu
		handleAdjacentItem(itemContext.index, target);
	}

	function setVisible(value: boolean) {
		if (!value || menubarContext.state.active) {
			$state.visible = value;
			if (value) {
				handleItemShow(itemContext.index);
			}
		}
	}

	function handleButton(_type: "confirm" | "cancel" | undefined, _value?: any) {
		menubarContext.state.active = false;
		setVisible(false);
	}

	@render {
		<SubmenuPopout
			id={$props?.id}
			class={["torp-menu-bar-item", $props?.class]}
			style={$props?.style}
			visible={$props?.visible}
			onopen={$props?.onopen}
			onclose={$props?.onclose}
			state={$state}
			context={{ handleButton, navigateMenuBar: handleNavigateMenuBar }}
			closeOnMouseLeave={false}
		>
			<slot />
		</SubmenuPopout>
	}
}
