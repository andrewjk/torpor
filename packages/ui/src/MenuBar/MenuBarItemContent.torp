import type { ClassValue, StyleValue } from "@torpor/view";
import SubmenuPopoutContent from "../utils/SubmenuPopoutContent.torp";

interface MenuBarItemContentProps {
	/** An ID for the root element */
	id?: string;
	/** Classes for the root element */
	class?: ClassValue;
	/** Styles for the root element */
	style?: StyleValue;
	/** Where the popout will be shown, relative to the popout button */
	side?: "top" | "right" | "bottom" | "left";
	/** How the popout will be aligned, relative to the popout button */
	alignment?: "start" | "center" | "end";
}

/**
 * The content that is displayed for a MenuBarItem when it is open.
 */
export default function MenuBarItemContent($props: MenuBarItemContentProps | undefined) {
	@render {
		<SubmenuPopoutContent
			id={$props?.id}
			class={["torp-menu-bar-item-content", $props?.class]}
			style={$props?.style}
			side={$props?.side}
			alignment={$props?.alignment}
			closeOnEscape={false}
		>
			<slot />
		</SubmenuPopoutContent>
	}
}
