import type { ClassValue, StyleValue } from "@torpor/view";
import { type TagInputContext, TagInputContextName } from "./TagInputTypes";

interface TagInputTagProps {
	/** An ID for the tag element */
	id?: string;
	/** Classes for the tag element */
	class?: ClassValue;
	/** Styles for the tag element */
	style?: StyleValue;
	/** The tag's position in the list */
	index: number;
	/** The tag's text */
	tag: string;
	/** If set to true, the tag cannot be removed */
	disabled?: boolean;
}

/**
 * One tag of a TagInput: its text with a button to remove it.
 */
export default function TagInputTag($props: TagInputTagProps | undefined) {
	// Get stuff out of the TagInput context
	const context = $context[TagInputContextName] as TagInputContext;
	if (!context) {
		throw new Error("TagInputTag must be contained within a TagInput");
	}

	function getIndex(): number {
		return $props?.index ?? 0;
	}

	function getTag(): string {
		return $props?.tag ?? "";
	}

	function getDisabled(): boolean {
		return $props?.disabled === true || context.getDisabled();
	}

	@render {
		<li {$props?.id} class={["torp-tag-input-tag", $props?.class]} {$props?.style}>
			<span class="torp-tag-input-tag-text">{getTag()}</span>
			<button
				type="button"
				class="torp-tag-input-remove"
				aria-label={`Remove ${getTag()}`}
				disabled={getDisabled()}
				onclick={() => context.removeTag(getIndex())}
			>
				<slot>×</slot>
			</button>
		</li>
	}
}
