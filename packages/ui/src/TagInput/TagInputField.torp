import type { ClassValue, StyleValue } from "@torpor/view";
import { type TagInputContext, TagInputContextName } from "./TagInputTypes";

interface TagInputFieldProps {
	/** An ID for the field element */
	id?: string;
	/** Classes for the field element */
	class?: ClassValue;
	/** Styles for the field element */
	style?: StyleValue;
	/** Placeholder text for the empty field; falls back to the TagInput's placeholder */
	placeholder?: string;
	/** An accessible name for the field; falls back to the TagInput's ariaLabel */
	ariaLabel?: string;
	/** If set to true, the user cannot interact with this field */
	disabled?: boolean;
}

/**
 * The text field of a TagInput, where the user types values (and searches
 * suggestions when a `load` function is set).
 */
export default function TagInputField($props: TagInputFieldProps | undefined) {
	// Get stuff out of the TagInput context
	const context = $context[TagInputContextName] as TagInputContext;
	if (!context) {
		throw new Error("TagInputField must be contained within a TagInput");
	}

	function getDisabled(): boolean {
		return $props?.disabled === true || context.getDisabled();
	}

	@render {
		<input
			{$props?.id}
			class={["torp-tag-input-field", $props?.class]}
			{$props?.style}
			type="text"
			value={context.getText()}
			placeholder={$props?.placeholder ?? context.getPlaceholder()}
			disabled={getDisabled()}
			aria-label={$props?.ariaLabel ?? context.getAriaLabel()}
			role={context.hasLoader() ? "combobox" : undefined}
			aria-expanded={context.hasLoader() ? (context.isSuggestionsOpen() ? "true" : "false") : undefined}
			aria-controls={context.isSuggestionsOpen() ? context.getListId() : undefined}
			aria-autocomplete="list"
			aria-activedescendant={context.getActiveSuggestionId()}
			oninput={context.handleFieldInput}
			onkeydown={context.handleFieldKey}
			onmount={(el) => {
				context.registerField(el);
				return () => {
					context.unregisterField(el);
				};
			}}
		/>
	}

	@style {
		/* Headless: layout only, so the field shares the row with the tags.
		   All appearance is up to the consuming theme */
		.torp-tag-input-field {
			flex: 1 1 auto;
			min-width: 4em;
		}
	}
}
