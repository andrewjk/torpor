import type { ClassValue, StyleValue } from "@torpor/view";
import { type TagInputContext, TagInputContextName } from "./TagInputTypes";

interface TagInputSuggestionsProps {
	/** An ID for the suggestion list element */
	id?: string;
	/** Classes for the suggestion list element */
	class?: ClassValue;
	/** Styles for the suggestion list element */
	style?: StyleValue;
}

/**
 * The suggestion list of a TagInput, shown while the user types when a
 * `load` function is set. Selecting a suggestion adds it as a tag.
 */
export default function TagInputSuggestions($props: TagInputSuggestionsProps | undefined) {
	// Get stuff out of the TagInput context
	const context = $context[TagInputContextName] as TagInputContext;
	if (!context) {
		throw new Error("TagInputSuggestions must be contained within a TagInput");
	}

	@render {
		@if (context.isSuggestionsOpen()) {
			@try {
				@await {
					<ul
						id={$props?.id ?? context.getListId()}
						class={["torp-tag-input-suggestions", $props?.class]}
						{$props?.style}
						role="listbox"
						aria-label={context.getAriaLabel()}
					>
						@for (let [index, item] of context.getSuggestions().entries()) {
							@key = context.getSuggestionLabel(item)
							<li
								class="torp-tag-input-suggestion"
								role="option"
								id={context.getSuggestionId(index)}
								aria-selected={context.isActiveSuggestion(index) ? "true" : "false"}
								data-active={context.isActiveSuggestion(index) ? "active" : undefined}
								onmouseenter={() => context.setActiveSuggestion(index)}
								onmousedown={(e: MouseEvent) => {
									// mousedown so the field doesn't blur first
									e.preventDefault();
									context.pickSuggestion(item);
								}}
							>
								{context.getSuggestionLabel(item)}
							</li>
						}
						@if (context.getSuggestions().length === 0) {
							<li class="torp-tag-input-empty" role="presentation">No matches.</li>
						}
					</ul>
				} with {
					<div class="torp-tag-input-loading" role="status">Loading…</div>
				}
			} catch (err) {
				<div class="torp-tag-input-error" role="alert">
					{err instanceof Error ? err.message : String(err)}
				</div>
			}
		}
	}

	@style {
		/* Headless: layout only, so the list overlays the page. All appearance
		   is up to the consuming theme */
		.torp-tag-input-suggestions {
			position: absolute;
			list-style: none;
			margin: 0;
			padding: 0;
			z-index: 10;
		}
	}
}
