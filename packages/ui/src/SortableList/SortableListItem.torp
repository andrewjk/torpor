import type { ClassValue, StyleValue } from "@torpor/view";
import draggable from "../mount/draggable";
import dropTarget from "../mount/dropTarget";
import {
	type SortableListContext,
	SortableListContextName,
} from "./SortableListTypes";

interface SortableListItemProps {
	/** The item this row represents */
	item: any;
	/** This item's position in the list */
	index: number;
	/** The number of items in the list */
	total?: number;
	/** An ID for the list item element */
	id?: string;
	/** Classes for the list item element */
	class?: ClassValue;
	/** Styles for the list item element */
	style?: StyleValue;
}

/**
 * One reorderable item in a SortableList. Dragging it moves it; with focus,
 * Alt+Up / Alt+Down move it one position, and Alt+Home / Alt+End move it to
 * an end of the list.
 */
export default function SortableListItem($props: SortableListItemProps | undefined) {
	// Get stuff out of the SortableListContext
	const context = $context[SortableListContextName] as SortableListContext;
	if (!context) {
		throw new Error("SortableListItem must be contained within a SortableList");
	}

	/** Moves this item so that it sits at `insertAt` in the original order */
	function moveTo(insertAt: number) {
		if (context.getDisabled()) return;
		context.move($props?.index ?? 0, insertAt);
	}

	function handleKey(e: KeyboardEvent) {
		if (!e.altKey || context.getDisabled()) return;
		const index = $props?.index ?? 0;
		const total = $props?.total ?? context.getItems().length;
		switch (e.key) {
			case "ArrowUp": {
				e.preventDefault();
				if (index > 0) moveTo(index - 1);
				break;
			}
			case "ArrowDown": {
				e.preventDefault();
				if (index < total - 1) moveTo(index + 2);
				break;
			}
			case "Home": {
				e.preventDefault();
				moveTo(0);
				break;
			}
			case "End": {
				e.preventDefault();
				moveTo(total);
				break;
			}
		}
	}

	function wireDrag(el: HTMLElement) {
		const stopDrag = draggable(el, {
			kind: context.kind,
			data: { index: $props?.index ?? 0, item: $props?.item },
			onstart: () => !context.getDisabled(),
		});
		const stopDrop = dropTarget(el, {
			accepts: (info) => info.kind === context.kind,
			dragClass: "torp-sortable-list-item-over",
			ondrop: (info, e) => {
				if (context.getDisabled()) return;
				const from = info.data?.index;
				if (typeof from !== "number") return;
				const rect = el.getBoundingClientRect();
				const after = e.clientY > rect.top + rect.height / 2;
				context.move(from, ($props?.index ?? 0) + (after ? 1 : 0));
			},
		});
		return () => {
			stopDrag();
			stopDrop();
		};
	}

	@render {
		<li
			{$props?.id}
			class={["torp-sortable-list-item", $props?.class]}
			{$props?.style}
			draggable={context.getDisabled() ? undefined : "true"}
			tabindex={context.getDisabled() ? -1 : 0}
			aria-roledescription="sortable item"
			aria-posinset={($props?.index ?? 0) + 1}
			aria-setsize={$props?.total}
			aria-disabled={context.getDisabled() ? "true" : undefined}
			onkeydown={handleKey}
			onmount={wireDrag}
		>
			<slot>{context.getItemLabel($props?.item)}</slot>
		</li>
	}

	@style {
		.torp-sortable-list-item-over {
			outline: 1px dashed currentcolor;
		}
	}
}
